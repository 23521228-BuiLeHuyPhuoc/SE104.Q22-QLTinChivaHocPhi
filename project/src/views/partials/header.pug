- const displayName = user ? (user.HoTen || user.username || user.TenDangNhap || user.Role || 'Người dùng') : ''
- const userAvatarUrl = user ? (user.AnhDaiDien || '') : ''

header.top-header
  .header-left
    button.sidebar-toggle(type="button" onclick="toggleSidebar()" aria-label="Mở menu")
      span#sidebar-toggle-icon.material-symbols-rounded menu_open
    div
      h1= headerTitle || pageTitle || 'Bảng điều khiển'
      if headerSubtitle
        p.header-subtitle= headerSubtitle

  .header-right
    button.theme-toggle(type="button" onclick="toggleTheme()" title="Đổi giao diện" aria-label="Đổi giao diện")
      span#theme-icon.material-symbols-rounded light_mode
    - const notifHref = user && user.Role === 'admin' ? '/admin/dashboard' : '/student/notifications'
    button.notification-bell(type="button" title="Thông báo" aria-label="Thông báo" onclick=`window.location.href='${notifHref}'`)
      span.material-symbols-rounded notifications
    if displayName
      .header-user
        if userAvatarUrl
          img.user-avatar.avatar-image(src=userAvatarUrl alt=displayName)
        else
          .user-avatar= displayName.charAt(0).toUpperCase()
        span= displayName
