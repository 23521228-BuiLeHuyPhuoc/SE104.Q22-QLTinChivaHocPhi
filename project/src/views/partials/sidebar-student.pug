- const active = activePage || currentPage || ''
- const studentName = user && user.studentInfo ? (user.studentInfo.HoTen || user.studentInfo.ho_ten || 'Sinh viên') : (user ? (user.HoTen || user.username || 'Sinh viên') : 'Sinh viên')
- const studentCode = user && user.studentInfo ? (user.studentInfo.MaSv || user.studentInfo.ma_sv || '') : (user ? (user.MaSv || '') : '')
- const studentAvatarUrl = user ? (user.AnhDaiDien || (user.studentInfo ? user.studentInfo.AnhDaiDien : '') || '') : ''
- const systemLogoUrl = typeof logoUrl !== 'undefined' ? logoUrl : '/uploads/logos/logo_tin_chi_hoc_phi_dark.svg?v=20260524201000'
- const canAccess = typeof canAccessPath === 'function' ? canAccessPath : function() { return true }
-
  const studentSections = [
    { title: 'Tổng quan', links: [
      { href: '/student/dashboard', active: 'dashboard', icon: 'dashboard', label: 'Bảng điều khiển', title: 'Bảng điều khiển' }
    ] },
    { title: 'Học tập', links: [
      { href: '/student/course-registration', active: 'course-registration', icon: 'add_task', label: 'Đăng ký học phần', title: 'Đăng ký học phần' },
      { href: '/student/my-courses', active: 'my-courses', icon: 'checklist', label: 'Phiếu đăng ký học phần', title: 'Phiếu đăng ký học phần' },
      { href: '/student/completed-courses', active: 'completed-courses', icon: 'history_edu', label: 'Môn đã học', title: 'Môn đã học' },
      { href: '/student/my-schedule', active: 'my-schedule', icon: 'calendar_month', label: 'Thời khóa biểu', title: 'Thời khóa biểu' },
      { href: '/student/curriculum', active: 'curriculum', icon: 'account_tree', label: 'Chương trình ĐT', title: 'Chương trình đào tạo' }
    ] },
    { title: 'Tài chính', links: [
      { href: '/student/my-tuition', active: 'my-tuition', icon: 'account_balance_wallet', label: 'Học phí', title: 'Học phí' },
      { href: '/student/my-payments', active: 'my-payments', icon: 'receipt_long', label: 'Lịch sử thanh toán', title: 'Lịch sử thanh toán' }
    ] },
    { title: 'Cá nhân', links: [
      { href: '/student/profile', active: 'profile', icon: 'person', label: 'Hồ sơ', title: 'Hồ sơ' },
      { href: '/student/notifications', active: 'notifications', icon: 'notifications', label: 'Thông báo', title: 'Thông báo' }
    ] }
  ];

nav.sidebar.sidebar-student(id="sidebar")
  .sidebar-brand
    .sidebar-logo-wrap
      img.sidebar-logo(src=systemLogoUrl alt="Logo hệ thống")

  .sidebar-nav
    each section in studentSections
      - const visibleLinks = section.links.filter(function(link) { return canAccess(link.href) })
      if visibleLinks.length
        .sidebar-section
          .sidebar-section-title= section.title
          each link in visibleLinks
            a.sidebar-link(href=link.href title=link.title class=(active === link.active ? 'active' : ''))
              span.sidebar-icon.material-symbols-rounded= link.icon
              span.link-label= link.label

  .sidebar-footer
    .sidebar-user
      if studentAvatarUrl
        img.avatar.avatar-image(src=studentAvatarUrl alt=studentName)
      else
        .avatar= studentName.charAt(0).toUpperCase()
      .sidebar-user-info
        div= studentName
        small= studentCode
    a.sidebar-logout(href="/logout" title="Đăng xuất")
      span.sidebar-icon.material-symbols-rounded logout
      span.link-label Đăng xuất
