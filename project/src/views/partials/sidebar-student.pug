- const active = activePage || currentPage || ''
- const studentName = user && user.studentInfo ? (user.studentInfo.HoTen || user.studentInfo.ho_ten || 'Sinh viên') : (user ? (user.HoTen || user.username || 'Sinh viên') : 'Sinh viên')
- const studentCode = user && user.studentInfo ? (user.studentInfo.MaSv || user.studentInfo.ma_sv || '') : (user ? (user.MaSv || '') : '')

nav.sidebar.sidebar-student(id="sidebar")
  .sidebar-brand
    .brand-mark TC
    div
      h2 Cổng Sinh Viên
      small Tín chỉ, lịch học và học phí

  .sidebar-nav
    .sidebar-section
      .sidebar-section-title Tổng quan
      a.sidebar-link(href="/student/dashboard" class=(active === 'dashboard' ? 'active' : ''))
        span Bảng điều khiển

    .sidebar-section
      .sidebar-section-title Học tập
      a.sidebar-link(href="/student/course-registration" class=(active === 'course-registration' ? 'active' : ''))
        span Đăng ký môn
      a.sidebar-link(href="/student/my-courses" class=(active === 'my-courses' ? 'active' : ''))
        span Môn đã đăng ký
      a.sidebar-link(href="/student/completed-courses" class=(active === 'completed-courses' ? 'active' : ''))
        span Môn đã học
      a.sidebar-link(href="/student/my-schedule" class=(active === 'my-schedule' ? 'active' : ''))
        span Thời khóa biểu
      a.sidebar-link(href="/student/curriculum" class=(active === 'curriculum' ? 'active' : ''))
        span Chương trình ĐT

    .sidebar-section
      .sidebar-section-title Tài chính
      a.sidebar-link(href="/student/my-tuition" class=(active === 'my-tuition' ? 'active' : ''))
        span Học phí
      a.sidebar-link(href="/student/my-payments" class=(active === 'my-payments' ? 'active' : ''))
        span Lịch sử thanh toán

    .sidebar-section
      .sidebar-section-title Cá nhân
      a.sidebar-link(href="/student/profile" class=(active === 'profile' ? 'active' : ''))
        span Hồ sơ
      a.sidebar-link(href="/student/notifications" class=(active === 'notifications' ? 'active' : ''))
        span Thông báo

  .sidebar-footer
    .sidebar-user
      .avatar= studentName.charAt(0).toUpperCase()
      div
        div= studentName
        small= studentCode
