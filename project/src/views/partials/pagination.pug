//- Expects: currentPage, totalPages, baseUrl, queryParams (object)

if totalPages && totalPages > 1
  - const pageNow = Number(currentPage || 1)
  - const maxVisible = 5
  - let startPage = Math.max(1, pageNow - Math.floor(maxVisible / 2))
  - let endPage = Math.min(totalPages, startPage + maxVisible - 1)
  - if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1)
  - const makeQuery = (params) => Object.entries(params || {}).filter(([k, v]) => v !== undefined && v !== null && v !== '').map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&')

  nav.pagination(aria-label="Phân trang")
    if pageNow > 1
      - const prevParams = Object.assign({}, queryParams || {}, { page: pageNow - 1 })
      a(href=baseUrl + '?' + makeQuery(prevParams)) Trước

    each i in Array.from({ length: endPage - startPage + 1 }, (_, index) => startPage + index)
      - const pageParams = Object.assign({}, queryParams || {}, { page: i })
      a(href=baseUrl + '?' + makeQuery(pageParams) class=(i === pageNow ? 'active' : ''))= i

    if pageNow < totalPages
      - const nextParams = Object.assign({}, queryParams || {}, { page: pageNow + 1 })
      a(href=baseUrl + '?' + makeQuery(nextParams)) Sau

  .pagination-info Trang #{pageNow} / #{totalPages}
