//- Pagination partial
//- Expects: currentPage, totalPages, baseUrl, queryParams (object)

if totalPages && totalPages > 1
  - var maxVisible = 5
  - var startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2))
  - var endPage = Math.min(totalPages, startPage + maxVisible - 1)
  - if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1)

  .pagination
    if currentPage > 1
      - var prevParams = Object.assign({}, queryParams || {}, { page: currentPage - 1 })
      a(href=baseUrl + '?' + Object.entries(prevParams).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&')) ← Trước

    - for (var i = startPage; i <= endPage; i++)
      - var pageParams = Object.assign({}, queryParams || {}, { page: i })
      a(href=baseUrl + '?' + Object.entries(pageParams).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&') class=(i === currentPage ? 'active' : ''))= i

    if currentPage < totalPages
      - var nextParams = Object.assign({}, queryParams || {}, { page: currentPage + 1 })
      a(href=baseUrl + '?' + Object.entries(nextParams).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&')) Sau →

  .pagination-info
    | Trang #{currentPage} / #{totalPages}
