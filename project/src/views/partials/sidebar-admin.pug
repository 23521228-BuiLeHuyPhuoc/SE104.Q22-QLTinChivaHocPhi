- const active = activePage || currentPage || ''
- const adminName = user ? (user.HoTen || user.username || user.TenDangNhap || 'Admin') : 'Admin'
- const rawChucVu = user ? (user.ChucVu || '') : ''
- const maNhomLower = user ? String(user.MaNhom || '').toLowerCase() : ''
- const chucVuLower = rawChucVu.toLowerCase()
- const isSystem = maNhomLower === 'admin' || maNhomLower === 'admin_he_thong' || maNhomLower === 'system_admin' || !rawChucVu || chucVuLower.includes('hệ thống') || chucVuLower.includes('he thong') || chucVuLower === 'admin hệ thống' || chucVuLower === 'admin' || chucVuLower.includes('system')
- const isTraining = chucVuLower.includes('đào tạo') || chucVuLower.includes('dao tao') || chucVuLower.includes('training')
- const isFinance = chucVuLower.includes('tài chính') || chucVuLower.includes('tai chinh') || chucVuLower.includes('finance')
- const chucVuDisplay = rawChucVu || 'Quản trị viên hệ thống'

nav.sidebar.sidebar-admin(id="sidebar")
  .sidebar-brand
    .brand-mark TC
    div
      h2 QL Tín Chỉ
      small Quản trị học phí và đăng ký

  .sidebar-nav
    .sidebar-section
      .sidebar-section-title Tổng quan
      a.sidebar-link(href="/admin/dashboard" class=(active === 'dashboard' ? 'active' : ''))
        span Bảng điều khiển

    if isSystem || isTraining
      .sidebar-section
        .sidebar-section-title Đào tạo
        a.sidebar-link(href="/admin/students" class=(active === 'students' ? 'active' : ''))
          span Sinh viên
        a.sidebar-link(href="/admin/courses" class=(active === 'courses' ? 'active' : ''))
          span Môn học
        a.sidebar-link(href="/admin/classes" class=(active === 'classes' ? 'active' : ''))
          span Lớp học
        a.sidebar-link(href="/admin/semesters" class=(active === 'semesters' ? 'active' : ''))
          span Học kỳ
        a.sidebar-link(href="/admin/faculties" class=(active === 'faculties' ? 'active' : ''))
          span Khoa
        a.sidebar-link(href="/admin/majors" class=(active === 'majors' ? 'active' : ''))
          span Ngành học
        a.sidebar-link(href="/admin/completed-courses" class=(active === 'completed-courses' ? 'active' : ''))
          span Môn đã học

    if isSystem || isTraining
      .sidebar-section
        .sidebar-section-title Đăng ký
        a.sidebar-link(href="/admin/registrations" class=(active === 'registrations' ? 'active' : ''))
          span Đăng ký tín chỉ

    if isSystem || isFinance
      .sidebar-section
        .sidebar-section-title Tài chính
        a.sidebar-link(href="/admin/tuition" class=(active === 'tuition' ? 'active' : ''))
          span Học phí
        a.sidebar-link(href="/admin/payments" class=(active === 'payments' ? 'active' : ''))
          span Phiếu thu
        a.sidebar-link(href="/admin/pricing" class=(active === 'pricing' ? 'active' : ''))
          span Đơn giá tín chỉ
        a.sidebar-link(href="/admin/beneficiaries" class=(active === 'beneficiaries' ? 'active' : ''))
          span Đối tượng ưu tiên

    if isSystem || isFinance
      .sidebar-section
        .sidebar-section-title Báo cáo
        a.sidebar-link(href="/admin/reports" class=(active === 'reports' ? 'active' : ''))
          span Thống kê

    if isSystem
      .sidebar-section
        .sidebar-section-title Hệ thống
        a.sidebar-link(href="/admin/users" class=(active === 'users' ? 'active' : ''))
          span Người dùng
        a.sidebar-link(href="/admin/permissions" class=(active === 'permissions' ? 'active' : ''))
          span Phân quyền
        a.sidebar-link(href="/admin/notifications" class=(active === 'notifications' ? 'active' : ''))
          span Thông báo
        a.sidebar-link(href="/admin/settings" class=(active === 'settings' ? 'active' : ''))
          span Tham số hệ thống

  .sidebar-footer
    .sidebar-user
      .avatar= adminName.charAt(0).toUpperCase()
      div
        div= adminName
        small= chucVuDisplay
