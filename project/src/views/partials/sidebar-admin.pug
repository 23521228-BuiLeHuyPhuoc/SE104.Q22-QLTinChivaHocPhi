- const active = activePage || currentPage || ''
- const adminName = user ? (user.HoTen || user.username || user.TenDangNhap || 'Admin') : 'Admin'
- const rawChucVu = user ? (user.ChucVu || '') : ''
- const chucVuDisplay = rawChucVu || 'Quản trị viên hệ thống'
- const adminAvatarUrl = user ? (user.AnhDaiDien || '') : ''
- const systemLogoUrl = typeof logoUrl !== 'undefined' ? logoUrl : '/uploads/logos/logo_tin_chi_hoc_phi_dark.svg?v=20260524201000'
- const canOpen = typeof canAccessPath === 'function' ? canAccessPath : function() { return true }
- const showLocations = canOpen('/admin/locations/provinces') || canOpen('/admin/locations/wards')
- const showTraining = canOpen('/admin/students') || canOpen('/admin/courses') || canOpen('/admin/open-courses') || canOpen('/admin/prerequisites') || canOpen('/admin/classes') || canOpen('/admin/rooms') || canOpen('/admin/lecturers') || canOpen('/admin/periods') || canOpen('/admin/semesters') || canOpen('/admin/academic-years') || canOpen('/admin/faculties') || canOpen('/admin/majors') || canOpen('/admin/curriculum-programs') || canOpen('/admin/completed-courses')
- const showRegistration = canOpen('/admin/registrations') || canOpen('/admin/appeals')
- const showFinance = canOpen('/admin/payments') || canOpen('/admin/tuition') || canOpen('/admin/pricing') || canOpen('/admin/beneficiaries')
- const showReports = canOpen('/admin/reports') || canOpen('/admin/reports/incomplete-tuition')
- const showSystem = canOpen('/admin/users') || canOpen('/admin/profile')
- const showAdmin = canOpen('/admin/permissions') || canOpen('/admin/notifications') || canOpen('/admin/settings')

mixin navItem(href, page, icon, label, title)
  if canOpen(href)
    a.sidebar-link(href=href title=(title || label) class=(active === page ? 'active' : ''))
      span.sidebar-icon.material-symbols-rounded= icon
      span.link-label= label

nav.sidebar.sidebar-admin(id="sidebar")
  .sidebar-brand
    .sidebar-logo-wrap
      img.sidebar-logo(src=systemLogoUrl alt="Logo hệ thống")

  .sidebar-nav
    if canOpen('/admin/dashboard')
      .sidebar-section
        .sidebar-section-title Tổng quan
        +navItem('/admin/dashboard', 'dashboard', 'dashboard', 'Bảng điều khiển')

    if showLocations
      .sidebar-section
        .sidebar-section-title Địa danh
        +navItem('/admin/locations/provinces', 'locations-provinces', 'location_city', 'Tỉnh/Thành phố')
        +navItem('/admin/locations/wards', 'locations-wards', 'home_pin', 'Phường/Xã')

    if showTraining
      .sidebar-section
        .sidebar-section-title Đào tạo
        +navItem('/admin/students', 'students', 'groups', 'Sinh viên')
        +navItem('/admin/courses', 'courses', 'menu_book', 'Môn học')
        +navItem('/admin/open-courses', 'open-courses', 'event_available', 'Môn học mở')
        +navItem('/admin/prerequisites', 'prerequisites', 'rule', 'Ràng buộc môn học')
        +navItem('/admin/classes', 'classes', 'meeting_room', 'Lớp học')
        +navItem('/admin/rooms', 'rooms', 'door_front', 'Phòng học')
        +navItem('/admin/lecturers', 'lecturers', 'co_present', 'Giảng viên')
        +navItem('/admin/periods', 'periods', 'schedule', 'Tiết học')
        +navItem('/admin/semesters', 'semesters', 'event', 'Học kỳ')
        +navItem('/admin/academic-years', 'academic-years', 'calendar_month', 'Năm học')
        +navItem('/admin/faculties', 'faculties', 'account_balance', 'Khoa')
        +navItem('/admin/majors', 'majors', 'hub', 'Ngành học')
        +navItem('/admin/curriculum-programs', 'curriculum-programs', 'account_tree', 'Chương trình học')
        +navItem('/admin/completed-courses', 'completed-courses', 'history_edu', 'Môn đã học')

    if showRegistration
      .sidebar-section
        .sidebar-section-title Đăng ký
        +navItem('/admin/registrations', 'registrations', 'app_registration', 'Đăng ký môn học')
        +navItem('/admin/appeals', 'appeals', 'fact_check', 'Đơn cứu xét')

    if showFinance
      .sidebar-section
        .sidebar-section-title Tài chính
        +navItem('/admin/payments', 'payments', 'receipt_long', 'Phiếu thu')
        +navItem('/admin/tuition', 'tuition', 'account_balance_wallet', 'Công nợ học phí')
        +navItem('/admin/pricing', 'pricing', 'price_change', 'Đơn giá tín chỉ')
        +navItem('/admin/beneficiaries', 'beneficiaries', 'volunteer_activism', 'Đối tượng ưu tiên')

    if showReports
      .sidebar-section
        .sidebar-section-title Báo cáo
        +navItem('/admin/reports', 'reports', 'analytics', 'Thống kê')
        +navItem('/admin/reports/incomplete-tuition', 'reports-incomplete-tuition', 'account_balance_wallet', 'Chưa hoàn thành học phí', 'Sinh viên chưa hoàn thành học phí')

    if showSystem
      .sidebar-section
        .sidebar-section-title Hệ thống
        +navItem('/admin/users', 'users', 'manage_accounts', 'Người dùng')
        +navItem('/admin/profile', 'profile', 'account_circle', 'Hồ sơ')

    if showAdmin
      .sidebar-section
        .sidebar-section-title Quản trị
        +navItem('/admin/permissions', 'permissions', 'admin_panel_settings', 'Phân quyền')
        +navItem('/admin/notifications', 'notifications', 'notifications', 'Thông báo')
        +navItem('/admin/settings', 'settings', 'tune', 'Tham số hệ thống')

  .sidebar-footer
    .sidebar-user
      if adminAvatarUrl
        img.avatar.avatar-image(src=adminAvatarUrl alt=adminName)
      else
        .avatar= adminName.charAt(0).toUpperCase()
      .sidebar-user-info
        div= adminName
        small= chucVuDisplay
    a.sidebar-logout(href="/logout" title="Đăng xuất")
      span.sidebar-icon.material-symbols-rounded logout
      span.link-label Đăng xuất

script.
  (function() {
    var storageKey = 'adminSidebarScrollState';

    function getSidebar() {
      return document.getElementById('sidebar');
    }

    function getSidebarNav() {
      var sidebar = getSidebar();
      return sidebar ? sidebar.querySelector('.sidebar-nav') : null;
    }

    function saveSidebarScroll() {
      var sidebar = getSidebar();
      var nav = getSidebarNav();
      if (!sidebar && !nav) return;
      localStorage.setItem(storageKey, JSON.stringify({
        sidebarTop: sidebar ? sidebar.scrollTop || 0 : 0,
        navTop: nav ? nav.scrollTop || 0 : 0
      }));
    }

    function restoreSidebarScroll() {
      var sidebar = getSidebar();
      var nav = getSidebarNav();
      var saved = null;
      try {
        saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
      } catch (e) {
        saved = { sidebarTop: parseInt(localStorage.getItem(storageKey) || '0', 10), navTop: 0 };
      }
      var sidebarTop = parseInt(saved.sidebarTop || 0, 10);
      var navTop = parseInt(saved.navTop || 0, 10);

      function applyScroll() {
        if (sidebar && Number.isFinite(sidebarTop)) sidebar.scrollTop = sidebarTop;
        if (nav && Number.isFinite(navTop)) nav.scrollTop = navTop;
      }

      applyScroll();
      requestAnimationFrame(applyScroll);
      setTimeout(applyScroll, 80);
      setTimeout(applyScroll, 250);
    }

    document.addEventListener('DOMContentLoaded', function() {
      var sidebar = getSidebar();
      var nav = getSidebarNav();
      if (!sidebar) return;

      restoreSidebarScroll();
      sidebar.addEventListener('scroll', saveSidebarScroll, { passive: true });
      if (nav) nav.addEventListener('scroll', saveSidebarScroll, { passive: true });
      sidebar.querySelectorAll('a.sidebar-link, a.sidebar-logout').forEach(function(link) {
        link.addEventListener('pointerdown', saveSidebarScroll);
        link.addEventListener('click', saveSidebarScroll);
      });
    });

    window.addEventListener('beforeunload', saveSidebarScroll);
  })();
