doctype html
html(lang="vi" data-theme="light")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="theme-color" content="#0ea5e9")
    title #{pageTitle || 'Quản lý tín chỉ và học phí'}
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Google+Sans+Text:wght@400;500;700&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0,0&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/theme.css")
    link(rel="stylesheet" href="/css/layout.css")
    block styles
  body
    .app-layout
      include ../partials/sidebar-admin

      .main-content
        include ../partials/header

        main.page-content
          block content

        include ../partials/footer

    #toast-container.toast-container

    block modals

    script(src="/js/main.js")
    block scripts
