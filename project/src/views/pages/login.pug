extends ../layouts/auth

block content
  - const role = loginRole || 'student'
  - const isAdminLogin = role === 'admin'
  - const actionPath = loginAction || (isAdminLogin ? '/admin/login' : '/login')
  - const apiPath = loginApiPath || (isAdminLogin ? '/api/auth/admin/login' : '/api/auth/login')
  - const systemLogoUrl = typeof authLogoUrl !== 'undefined' ? authLogoUrl : '/uploads/logos/logo_tin_chi_hoc_phi_light.svg?v=20260524200000'
  .login-page(class=isAdminLogin ? 'login-page-admin' : 'login-page-student')
    .login-card
      .login-brand
        .login-logo-wrap
          img.login-logo(src=systemLogoUrl alt="Logo hệ thống")
        div
          h1= loginTitle || (isAdminLogin ? 'Đăng nhập Admin' : 'Đăng nhập Sinh viên')
          .subtitle= loginSubtitle || 'Hệ thống quản lý tín chỉ và học phí'

      #login-error.login-error

      form#login-form(method="POST" action=actionPath data-api=apiPath data-role=role onsubmit="return handleLogin(event)")
        .form-group
          label(for="username") Tên đăng nhập
          input.form-control#username(type="text" name="username" placeholder="Nhập tên đăng nhập" required autofocus autocomplete="username")

        .form-group
          label(for="password") Mật khẩu
          .password-field
            input.form-control#password(type="password" name="password" placeholder="Nhập mật khẩu" required autocomplete="current-password")
            button.password-toggle(type="button" data-password-toggle="password" aria-label="Hiện mật khẩu" aria-pressed="false")
              span.material-symbols-rounded(aria-hidden="true") visibility

        button.btn.btn-login(type="submit" id="btn-login") Đăng nhập

      .login-switch
        if isAdminLogin
          a(href=forgotPasswordPath || "/admin/forgot-password") Quên mật khẩu
          |  · 
          a(href="/login") Đăng nhập sinh viên
        else
          a(href=forgotPasswordPath || "/forgot-password") Quên mật khẩu

block scripts
  script(src="/js/login.js")
