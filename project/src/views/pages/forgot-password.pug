extends ../layouts/auth

block content
  - const role = forgotRole || 'student'
  - const isAdminForgot = role === 'admin'
  - const systemLogoUrl = typeof authLogoUrl !== 'undefined' ? authLogoUrl : '/uploads/logos/logo_tin_chi_hoc_phi_light.svg?v=20260524200000'
  .login-page(class=isAdminForgot ? 'login-page-admin' : 'login-page-student')
    .login-card
      .login-brand
        .login-logo-wrap
          img.login-logo(src=systemLogoUrl alt="Logo hệ thống")
        div
          h1= forgotTitle || 'Quên mật khẩu'
          .subtitle= forgotSubtitle || 'Nhận mã OTP đặt lại mật khẩu qua email'

      #forgot-error.login-error

      form#forgot-form(method="POST" data-api=forgotApiPath data-role=role onsubmit="return handleForgotPassword(event)")
        .form-group
          label(for="identifier") Tên đăng nhập hoặc email
          input.form-control#identifier(type="text" name="identifier" required autofocus autocomplete="username")

        button.btn.btn-login(type="submit" id="btn-forgot") Gửi mã OTP

      .login-switch
        a(href=loginPath || "/login") Quay lại đăng nhập

block scripts
  script(src="/js/login.js")
