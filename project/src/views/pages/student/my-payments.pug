extends ../../layouts/student

block content
  .page-shell
    .page-heading.compact
      .page-kicker Tài chính
      h2 Lịch sử thanh toán

    .toolbar
      .filter-group
        select#payment-semester-filter(onchange="loadMyPayments(1)")
          option(value="") Tất cả học kỳ

    .card
      .card-header
        h3 Phiếu thu đã ghi nhận
      .card-body
        .loading-overlay#loading
          .spinner
        .table-container
          table.data-table#payments-table.hidden
            thead
              tr
                th Số phiếu
                th Học kỳ
                th Số tiền
                th Phương thức
                th Ngày thanh toán
                th Mã giao dịch
                th Xác nhận
                th Trạng thái
                th Ghi chú
                th Thao tác
            tbody#payment-list
        nav.pagination#payments-pagination(style="display:none")

block scripts
  script(src="/js/student/my-payments.js")
