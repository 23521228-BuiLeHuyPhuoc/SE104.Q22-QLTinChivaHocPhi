extends ../../layouts/student

block content
  .page-shell
    .welcome-banner
      h2 Xin chào, #{(user && user.HoTen) || (user && user.username) || 'Sinh viên'}! 👋
      p Chúc bạn có một ngày học tập hiệu quả

    .page-heading
      .page-kicker Cổng sinh viên
      h2 Tổng quan học tập và học phí
      p Theo dõi môn đã đăng ký, số tín chỉ, học phí phải đóng và thông báo mới.

    .stats-grid
      .stat-card
        .stat-icon.blue.material-symbols-rounded library_books
        .stat-info
          h3#stat-courses --
          p Môn đã đăng ký
      .stat-card
        .stat-icon.green.material-symbols-rounded format_list_numbered
        .stat-info
          h3#stat-credits --
          p Tổng tín chỉ
      .stat-card
        .stat-icon.orange.material-symbols-rounded payments
        .stat-info
          h3#stat-tuition --
          p Học phí
      .stat-card
        .stat-icon.red.material-symbols-rounded account_balance_wallet
        .stat-info
          h3#stat-debt --
          p Còn nợ

    .content-grid.two-columns
      .card
        .card-header
          h3 Thông báo mới
        .card-body#notifications-list
          .loading-overlay
            .spinner
      .card
        .card-header
          h3 Truy cập nhanh
        .card-body
          .action-grid
            a.action-tile(href="/student/course-registration")
              strong Đăng ký môn
              span Chọn lớp mở theo học kỳ
            a.action-tile(href="/student/my-tuition")
              strong Học phí
              span Kiểm tra số tiền đã đóng và còn nợ
            a.action-tile(href="/student/my-schedule")
              strong Thời khóa biểu
              span Xem lịch học theo ngày trong tuần
            a.action-tile(href="/student/curriculum")
              strong Chương trình ĐT
              span Xem tiến độ theo chương trình đào tạo

block scripts
  script(src="/js/student/dashboard.js")
