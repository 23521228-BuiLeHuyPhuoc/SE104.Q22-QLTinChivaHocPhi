extends ../../layouts/student

block styles
  script.
    (function() {
      var saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
block content
  .page-shell
    .page-heading.compact
    .page-kicker Học tập
      h2 Môn đã học

    .filter-group
      input#completed-search(type="text" placeholder="Tìm mã môn, tên môn, khoa, loại, lớp, giảng viên")
      select#completed-loai
        option(value="") Tất cả loại
        option(value="LT") Lý thuyết
        option(value="TH") Thực hành
      select#completed-khoa
        option(value="") Tất cả khoa
      select#completed-semester
        option(value="") Tất cả học kỳ
      select#completed-result
        option(value="") Tất cả kết quả
        option(value="qua_mon") Qua môn
        option(value="rot") Rớt

    .card
      .card-header
        h3 Lịch sử môn đã học
      .card-body
        .loading-overlay#completed-loading
          .spinner
        .table-container
          table.data-table#completed-table.hidden
            thead
              tr
                th Mã môn
                th Tên môn
                th Khoa
                th Loại
                th Tín chỉ
                th Học kỳ
                th Lớp
                th Lần học
                th Kết quả
                th Ghi chú
            tbody#completed-list
        nav.pagination#completed-pagination(style="display:none")

block scripts
  script(src="/js/student/completed-courses.js")
