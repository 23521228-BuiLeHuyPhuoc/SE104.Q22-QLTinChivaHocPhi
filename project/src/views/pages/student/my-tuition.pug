extends ../../layouts/student

block content
  .page-shell
    .page-heading.compact
      .page-kicker Tài chính
      h2 Học phí của tôi

    .stats-grid
      .stat-card
        .stat-icon.blue HP
        .stat-info
          h3#total-fee --
          p Tổng học phí
      .stat-card
        .stat-icon.green DT
        .stat-info
          h3#total-paid --
          p Đã đóng
      .stat-card
        .stat-icon.red NO
        .stat-info
          h3#total-remaining --
          p Còn nợ

    .card
      .card-header
        h3 Chi tiết học phí theo học kỳ
        button.btn.btn-primary#pay-tuition-now(type="button" onclick="openFirstPayableTuition()" disabled) Đóng học phí
      .card-body
        .loading-overlay#loading
          .spinner
        .table-container
          table.data-table#tuition-table.hidden
            thead
              tr
                th Học kỳ
                th Tổng học phí
                th Đã đóng
                th Còn lại
                th Hạn đóng
                th Trạng thái
                th Thao tác
            tbody#tuition-list
        nav.pagination#tuition-pagination(style="display:none")

block modals
  #payment-modal.modal-overlay(onclick="if(event.target===this)closePaymentModal()")
    .modal
      .modal-header
        h3 Đóng học phí
        button.modal-close(type="button" onclick="closePaymentModal()") ×
      .modal-body
        input#payment-so-phieu(type="hidden")
        .form-group
          label(for="payment-amount") Số tiền
          input.form-control#payment-amount(type="number" min="1")
        .form-group
          label(for="payment-method") Phương thức
          select.form-control#payment-method
            option(value="cash") Tiền mặt tại quầy
            option(value="qr") QR chuyển khoản
            option(value="vnpay") VNPAY sandbox
            option(value="zalopay") ZaloPay sandbox
        #payment-result.mt-3
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closePaymentModal()") Hủy
        button.btn.btn-primary(type="button" onclick="checkoutPayment()") Tạo thanh toán

block scripts
  script(src="/js/student/my-tuition.js")
