extends ../../layouts/student

block content
  .page-shell
    .page-heading.compact
      .page-kicker Tài chính
      h2 Học phí của tôi

    .stats-grid
      .stat-card
        .stat-icon.blue.material-symbols-rounded payments
        .stat-info
          h3#total-fee --
          p Tổng học phí
      .stat-card
        .stat-icon.green.material-symbols-rounded paid
        .stat-info
          h3#total-paid --
          p Đã đóng
      .stat-card
        .stat-icon.red.material-symbols-rounded account_balance_wallet
        .stat-info
          h3#total-remaining --
          p Còn nợ

    .card
      .card-header
        h3 Chi tiết học phí theo học kỳ
        button.btn.btn-primary#pay-tuition-now(type="button" onclick="openFirstPayableTuition()" disabled) Thanh toán phiếu thu
      .card-body
        .loading-overlay#loading
          .spinner
        .table-container
          table.data-table#tuition-table.hidden
            thead
              tr
                th Học kỳ
                th Tổng học phí
                th Đã đóng
                th Còn lại
                th Hạn đóng
                th Trạng thái
                th Thao tác
            tbody#tuition-list
        nav.pagination#tuition-pagination(style="display:none")

block modals
  #payment-modal.modal-overlay(onclick="if(event.target===this)closePaymentModal()")
    .modal
      .modal-header
        h3 Đóng học phí
        button.modal-close(type="button" onclick="closePaymentModal()") ×
      .modal-body
        input#payment-receipt-id(type="hidden")
        input#payment-receipt-amount(type="hidden")
        .form-group
          label Còn nợ phiếu thu
          .form-control-static#payment-amount-label --
        .form-group
          label(for="payment-amount") Số tiền muốn thanh toán
          input.form-control#payment-amount(type="number" min="1" step="1000" required)
          small.text-muted#payment-amount-hint Thanh toán toàn bộ sẽ khóa đúng số tiền còn nợ.
          small.text-muted Sinh viên chỉ thanh toán phiếu thu đã được admin tạo.
        .form-group
          label(for="payment-mode") Loại thanh toán
          select.form-control#payment-mode(onchange="updatePaymentModeHint()")
            option(value="full") Thanh toán toàn bộ phiếu thu
            option(value="partial") Thanh toán một phần
          small.text-muted#payment-mode-hint Mặc định thanh toán toàn bộ số tiền còn nợ của phiếu thu.
        .form-group
          label(for="payment-method") Phương thức
          select.form-control#payment-method(onchange='updatePaymentMethodHint()')
            option(value="cash") Tiền mặt tại quầy
            option(value="qr") QR chuyển khoản
            option(value="vnpay") VNPAY sandbox
            option(value="zalopay") ZaloPay sandbox
          small.text-muted#payment-method-hint Vui lòng đem tiền mặt tới phòng tài chính A.101 để thanh toán và được phòng tài chính xác nhận thanh toán.
        #payment-result.mt-3
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closePaymentModal()") Hủy
        button.btn.btn-primary(type="button" onclick="checkoutPayment()") Tạo thanh toán

  #tuition-detail-modal.modal-overlay(onclick="if(event.target===this)closeTuitionDetailModal()")
    .modal.modal-wide
      .modal-header
        h3#tuition-detail-title Chi tiết học phí
        button.modal-close(type="button" onclick="closeTuitionDetailModal()" aria-label="Đóng") ×
      .modal-body#tuition-detail-body
        .empty-state Đang tải dữ liệu...
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeTuitionDetailModal()") Đóng

  #receipt-detail-modal.modal-overlay(onclick="if(event.target===this)closeReceiptDetailModal()")
    .modal
      .modal-header
        h3#receipt-detail-title Phiếu thu học phí
        button.modal-close(type="button" onclick="closeReceiptDetailModal()" aria-label="Đóng") ×
      .modal-body#receipt-detail-body
        .empty-state Đang tải dữ liệu...
      .modal-footer#receipt-detail-footer
        button.btn.btn-outline(type="button" onclick="closeReceiptDetailModal()") Đóng

block scripts
  script(src="/js/student/my-tuition.js")
