extends ../../layouts/student

block content
  .page-shell
    .page-heading.compact
      .page-kicker Học tập
      h2 Môn học đã đăng ký

    .card
      .card-header
        h3 Danh sách lớp đã đăng ký
      .card-body
        .loading-overlay#loading
          .spinner
        .table-container
          table.data-table#courses-table.hidden
            thead
              tr
                th Mã lớp
                th Tên môn
                th Tín chỉ
                th Giảng viên
                th Lịch học
                th Phòng
                th Trạng thái
                th Thao tác
            tbody#my-courses

block scripts
  script(src="/js/student/my-courses.js")
