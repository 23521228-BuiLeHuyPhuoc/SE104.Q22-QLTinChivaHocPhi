extends ../../layouts/student

block styles
  link(rel="stylesheet" href="/css/student/my-courses.css")

block content
  .page-shell
    .page-heading.compact
      .page-kicker Học tập
      h2 Phiếu đăng ký học phần

    form.my-courses-filter-panel#my-courses-filter
      .my-courses-filter-grid
        .my-courses-filter-field
          label(for="filter-academic-year") Năm học
          select.form-control#filter-academic-year
            option(value="") Tất cả năm học
        .my-courses-filter-field
          label(for="filter-semester") Học kỳ
          select.form-control#filter-semester
            option(value="") Tất cả học kỳ
        .my-courses-filter-actions
          button.btn.btn-outline#reset-my-courses-filter(type="button")
            span.material-symbols-rounded restart_alt
            span Xóa lọc

    .card
      .card-header
        h3 Chi tiết phiếu đăng ký học phần
        span.card-count#my-courses-count
      .card-body
        .loading-overlay#loading
          .spinner
        .table-container
          table.data-table#courses-table.hidden
            thead
              tr
                th Phiếu ĐK
                th Mã lớp
                th Học phần
                th Tín chỉ
                th Loại đăng ký
                th Giảng viên
                th Lịch học
                th Phòng
                th Trạng thái
                th Thao tác
            tbody#my-courses
        .my-courses-summary#my-courses-summary.hidden
          .my-courses-summary-main
            span.material-symbols-rounded.my-courses-summary-icon fact_check
            div
              strong#my-courses-total-credits Tổng tín chỉ đã đăng ký: --
              small#my-courses-total-courses -- học phần đang đăng ký
          span.my-courses-summary-fee.text-muted#my-courses-total-fee Học phí trước miễn/giảm tạm tính: --
        nav.pagination#my-courses-pagination(style="display:none")

    .card
      .card-header
        h3 Đơn cứu xét của tôi
        span.card-count#my-appeals-count
      .card-body
        .table-container
          table.data-table
            thead
              tr
                th Mã đơn
                th Học kỳ
                th Loại đơn
                th Nội dung
                th Trạng thái
                th Lý do
                th Thao tác
            tbody#my-appeals
              tr
                td(colspan="7")
                  .empty-state Đang tải đơn cứu xét...
        nav.pagination#my-appeals-pagination(style="display:none")

block modals
  #my-course-appeal-modal.modal-overlay(onclick="if(event.target===this)closeMyCourseAppealModal()")
    .modal
      .modal-header
        h2#my-course-appeal-title Gửi đơn cứu xét
        button.modal-close(type="button" onclick="closeMyCourseAppealModal()" aria-label="Đóng") ×
      .modal-body
        form#my-course-appeal-form
          input#my-course-appeal-type(type="hidden")
          input#my-course-appeal-semester(type="hidden")
          input#my-course-appeal-current-class(type="hidden")
          input#my-course-appeal-course(type="hidden")
          .appeal-modal-summary#my-course-appeal-summary
          .form-group#my-course-change-class-group.hidden
            label(for="my-course-appeal-target-class") Lớp muốn đổi sang
            select.form-control#my-course-appeal-target-class
              option(value="") Đang tải danh sách lớp phù hợp
            small.text-muted Chỉ hiển thị các lớp khác của cùng học phần trong học kỳ này.
          .form-group
            label(for="my-course-appeal-reason") Lý do cứu xét
            textarea.form-control#my-course-appeal-reason(rows="4" required maxlength="500" placeholder="Nhập lý do gửi đơn cứu xét")
            small.text-muted Tối đa 500 ký tự.
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeMyCourseAppealModal()") Hủy
        button.btn.btn-primary(type="submit" form="my-course-appeal-form") Gửi đơn

  #my-course-confirm-modal.modal-overlay(onclick='if(event.target===this)closeMyCourseConfirmModal(false)')
    .modal.my-course-confirm-modal
      .modal-header
        h2#my-course-confirm-title Xác nhận thao tác
        button.modal-close(type='button' onclick='closeMyCourseConfirmModal(false)' aria-label='Đóng') ×
      .modal-body
        p.my-course-confirm-message#my-course-confirm-message Bạn có chắc muốn tiếp tục?
      .modal-footer
        button.btn.btn-outline(type='button' onclick='closeMyCourseConfirmModal(false)') Không
        button.btn.btn-danger#my-course-confirm-submit(type='button' onclick='closeMyCourseConfirmModal(true)') Xác nhận

block scripts
  script(src="/js/student/my-courses.js")
