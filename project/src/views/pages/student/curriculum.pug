extends ../../layouts/student

block content
  .page-shell
    .page-heading
    .page-kicker Học tập
      h2 Chương trình đào tạo
      p Theo dõi tiến độ học tập theo ngành

    .card.mb-3
      .card-body
        .progress-label
          span Tiến độ tích lũy
          strong
            span#credits-done 0
            |  / 
            span#credits-total 0
            |  tín chỉ (
            span#credits-percent 0%
            | )
        .progress.progress-lg
          .progress-bar#credits-bar(style="width: 0%")
        .detail-grid.mt-3
          div
            strong Tín chỉ con no
            span#debt-credits 0
          div
            strong Điều kiện khóa luận
            span#thesis-status -

    .filter-group.mb-3
      select#status-filter
        option(value="") Tất cả trạng thái
        option(value="passed") Đã qua
        option(value="registered") Đang học
        option(value="not_started") Chưa học
        option(value="failed") Rớt

    #curriculum-container.curriculum-grid
      .loading-overlay
        .spinner

block scripts
  script(src="/js/student/curriculum.js")
