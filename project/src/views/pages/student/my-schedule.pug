extends ../../layouts/student

block styles
  style.
    .schedule-grid {
      display: grid;
      grid-template-columns: 80px repeat(6, 1fr);
      gap: 2px;
      font-size: 0.8rem;
    }
    .schedule-header {
      background: var(--color-primary);
      color: white;
      padding: 10px;
      text-align: center;
      font-weight: 600;
      border-radius: var(--radius-sm);
    }
    .schedule-time {
      background: var(--bg-tertiary);
      padding: 8px;
      text-align: center;
      font-weight: 500;
      border-radius: var(--radius-sm);
    }
    .schedule-cell {
      background: var(--bg-secondary);
      padding: 6px;
      min-height: 60px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-light);
    }
    .schedule-item {
      background: var(--color-primary-light);
      color: var(--color-primary);
      padding: 4px 6px;
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      margin-bottom: 2px;
    }

block content
  h2.page-title Thời khóa biểu

  .card
    .card-body
      .loading-overlay#loading
        .spinner
      #schedule-container.hidden
        .schedule-grid
          .schedule-header Tiết
          .schedule-header Thứ 2
          .schedule-header Thứ 3
          .schedule-header Thứ 4
          .schedule-header Thứ 5
          .schedule-header Thứ 6
          .schedule-header Thứ 7

          //- Generated by JS below

      #schedule-message.hidden.text-center.text-muted
        p Chưa có thời khóa biểu

block scripts
  script(src="/js/student/my-schedule.js")
