extends ../../layouts/student

block content
  .page-shell
    .page-heading.compact
      .page-kicker Học tập
      h2 Thời khóa biểu

    .card
      .card-header
        h3 Lịch học trong tuần
      .card-body
        .loading-overlay#loading
          .spinner
        #schedule-container.hidden
          .schedule-grid
            .schedule-header Tiết
            .schedule-header Thứ 2
            .schedule-header Thứ 3
            .schedule-header Thứ 4
            .schedule-header Thứ 5
            .schedule-header Thứ 6
            .schedule-header Thứ 7

        #schedule-message.hidden.empty-state Chưa có thời khóa biểu

block scripts
  script(src="/js/student/my-schedule.js")
