extends ../../layouts/student

block content
  .toolbar
    .toolbar-title
      h2.page-title Đăng ký môn học
      p Chọn học kỳ rồi tải danh sách lớp đang mở đăng ký.
    .filter-group
      select.form-control#semester-input
        option(value="") Chọn học kỳ
      input.form-control#course-search(type="text" placeholder="Tìm môn học")
      button.btn.btn-primary(type="button" id="load-courses" onclick="loadAvailableCourses()") Tải lớp mở

  .card
    .card-header
      h3 Môn học có thể đăng ký
    .card-body
      .loading-overlay.hidden#loading
        .spinner
      .table-container
        table.data-table#courses-table.hidden
          thead
            tr
              th Mã lớp
              th Tên môn
              th Tín chỉ
              th Giảng viên
              th Lịch học
              th Phòng
              th Loại đăng ký
              th Học phí dự kiến
              th Còn trống
              th Thao tác
          tbody#available-courses
      #available-empty.empty-state Chọn học kỳ để xem danh sách lớp mở
      nav.pagination#available-pagination(style="display:none")

block scripts
  script(src="/js/student/course-registration.js")
