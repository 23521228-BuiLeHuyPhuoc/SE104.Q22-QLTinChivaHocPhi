extends ../layouts/auth

block content
  - const role = registerRole || 'student'
  - const isAdminRegister = role === 'admin'
  .login-page(class=isAdminRegister ? 'login-page-admin' : 'login-page-student')
    .login-card
      .login-brand
        .brand-mark= brandMark || (isAdminRegister ? 'AD' : 'SV')
        div
          h1= registerTitle || (isAdminRegister ? 'Đăng ký Admin' : 'Đăng ký Sinh viên')
          .subtitle= registerSubtitle || 'Tạo tài khoản hệ thống'

      #register-error.login-error

      form#register-form(method="POST" data-api=registerApiPath data-role=role onsubmit="return handleRegister(event)")
        if isAdminRegister
          .form-group
            label(for="username") Tên đăng nhập
            input.form-control#username(type="text" name="username" required autofocus autocomplete="username")
          .form-group
            label(for="full-name") Họ tên
            input.form-control#full-name(type="text" name="HoTen" required autocomplete="name")
          .form-group
            label(for="email") Email
            input.form-control#email(type="email" name="Email" required autocomplete="email")
          .form-group
            label(for="phone") Số điện thoại
            input.form-control#phone(type="text" name="Sdt" autocomplete="tel")
          .form-group
            label(for="position") Chức vụ
            input.form-control#position(type="text" name="ChucVu" value="Quản trị viên")
          .form-group
            label(for="department") Phòng ban
            input.form-control#department(type="text" name="PhongBan")
        else
          .form-group
            label(for="username") Tên đăng nhập
            input.form-control#username(type="text" name="username" required autofocus autocomplete="username")
          .form-group
            label(for="full-name") Họ tên
            input.form-control#full-name(type="text" name="HoTen" required autocomplete="name")
          .form-group
            label(for="email") Email
            input.form-control#email(type="email" name="Email" required autocomplete="email")
          .form-group
            label(for="phone") Số điện thoại
            input.form-control#phone(type="text" name="Sdt" autocomplete="tel")

        .form-group
          label(for="password") Mật khẩu
          input.form-control#password(type="password" name="password" required autocomplete="new-password")
        .form-group
          label(for="confirm-password") Nhập lại mật khẩu
          input.form-control#confirm-password(type="password" name="confirmPassword" required autocomplete="new-password")

        button.btn.btn-login(type="submit" id="btn-register") Đăng ký

      .login-switch
        if isAdminRegister
          a(href=loginPath || "/admin/login") Đã có tài khoản admin
          |  · 
          a(href="/login") Đăng nhập sinh viên
        else
          a(href=loginPath || "/login") Đã có tài khoản sinh viên

block scripts
  script(src="/js/login.js")
