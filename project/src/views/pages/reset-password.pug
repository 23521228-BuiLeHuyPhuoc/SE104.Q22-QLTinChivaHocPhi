extends ../layouts/auth

block content
  .login-page.login-page-student
    .login-card
      .login-brand
        .brand-mark= brandMark || 'TC'
        div
          h1 Đặt lại mật khẩu
          .subtitle Nhập mật khẩu mới cho tài khoản của bạn

      #reset-error.login-error

      form#reset-form(method="POST" data-api=resetApiPath onsubmit="return handleResetPassword(event)")
        input#reset-token(type="hidden" name="token" value=token)
        .form-group
          label(for="new-password") Mật khẩu mới
          input.form-control#new-password(type="password" name="newPassword" required autofocus autocomplete="new-password")
        .form-group
          label(for="confirm-password") Nhập lại mật khẩu mới
          input.form-control#confirm-password(type="password" name="confirmPassword" required autocomplete="new-password")

        button.btn.btn-login(type="submit" id="btn-reset") Đặt lại mật khẩu

      .login-switch
        a(href=loginPath || "/login") Quay lại đăng nhập

block scripts
  script(src="/js/login.js")
