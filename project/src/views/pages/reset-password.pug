extends ../layouts/auth

block content
  - const systemLogoUrl = typeof authLogoUrl !== 'undefined' ? authLogoUrl : '/uploads/logos/logo_tin_chi_hoc_phi_light.svg?v=20260524200000'
  .login-page.login-page-student
    .login-card
      .login-brand
        .login-logo-wrap
          img.login-logo(src=systemLogoUrl alt="Logo hệ thống")
        div
          h1 Đặt lại mật khẩu
          .subtitle Nhập mã OTP trong email và mật khẩu mới

      #reset-error.login-error

      form#reset-form(method="POST" data-api=resetApiPath onsubmit="return handleResetPassword(event)")
        input#reset-role(type="hidden" name="role" value=resetRole)
        .form-group
          label(for="reset-identifier") Tên đăng nhập hoặc email
          input.form-control#reset-identifier(type="text" name="identifier" value=identifier required autofocus autocomplete="username")
        .form-group
          label(for="reset-otp") Mã OTP
          input.form-control#reset-otp(type="text" name="otp" required inputmode="numeric" autocomplete="one-time-code" maxlength="8")
        .form-group
          label(for="new-password") Mật khẩu mới
          input.form-control#new-password(type="password" name="newPassword" required autocomplete="new-password")
        .form-group
          label(for="confirm-password") Nhập lại mật khẩu mới
          input.form-control#confirm-password(type="password" name="confirmPassword" required autocomplete="new-password")

        button.btn.btn-login(type="submit" id="btn-reset") Đặt lại mật khẩu

      .login-switch
        a(href=loginPath || "/login") Quay lại đăng nhập

block scripts
  script(src="/js/login.js")
