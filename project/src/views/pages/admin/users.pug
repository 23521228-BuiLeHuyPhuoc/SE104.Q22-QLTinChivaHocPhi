extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm tên đăng nhập, họ tên hoặc email..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-role(onchange="applyFilters()")
        option(value="" selected=(!filterRole)) Tất cả vai trò
        option(value="admin" selected=(filterRole === 'admin')) Quản trị viên
        option(value="student" selected=(filterRole === 'student')) Sinh viên

  .card
    .card-header
      h3 Người dùng hệ thống
      span.card-count= accounts ? `${accounts.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th ID
            th Tên đăng nhập
            th Họ tên
            th Mã SV
            th Email
            th Nhóm
            th Vai trò
            th Ngày tạo
            th Thao tác
        tbody#accounts-table
          if accounts && accounts.length > 0
            each acc in accounts
              tr
                td.mono= acc.MaTaiKhoan
                td
                  strong= acc.TenDangNhap
                td= acc.HoTen || '-'
                td= acc.MaSv || '-'
                td= acc.Email || '-'
                td
                  span.badge.badge-secondary= acc.MaNhom || '-'
                td
                  if acc.Role === 'admin'
                    span.badge.badge-info Quản trị viên
                  else
                    span.badge.badge-success Sinh viên
                td= acc.NgayTao ? new Date(acc.NgayTao).toLocaleDateString('vi-VN') : '-'
                td.table-actions
                  if currentUserId && parseInt(acc.MaTaiKhoan, 10) === parseInt(currentUserId, 10)
                    span.text-muted Tài khoản hiện tại
                  else
                    button.btn.btn-sm(
                      type="button"
                      class=(acc.Role === 'admin' ? 'btn-warning' : 'btn-primary')
                      data-id=acc.MaTaiKhoan
                      data-username=acc.TenDangNhap
                      data-role=acc.Role
                      onclick="handleRoleClick(this)"
                      id=`btn-role-${acc.MaTaiKhoan}`
                    )= acc.Role === 'admin' ? 'Chuyển thành sinh viên' : 'Chuyển thành admin'
          else
            tr
              td(colspan="9")
                .empty-state Không có tài khoản phù hợp

  include ../../partials/pagination

block scripts
  script(src="/js/admin/users.js")
