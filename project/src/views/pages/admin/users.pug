extends ../../layouts/admin

block content
  - const groups = groupOptions || []
  - const accountGroups = creatableGroups || groups.map(group => ({ ...group, Role: group.MaNhom === 'SINHVIEN' ? 'student' : 'admin' }))
  .toolbar.users-toolbar.admin-toolbar
    .search-box.search-box-with-criterion.admin-search-group
      label.admin-search-label(for="search-field") Tìm theo
      select#search-field.form-control.ui-search-criterion-select(onchange="applyFilters()" aria-label="Tiêu chí tìm kiếm")
        option(value="all" selected=(!searchField || searchField === 'all')) Tất cả
        option(value="TenDangNhap" selected=(searchField === 'TenDangNhap')) Tên đăng nhập
        option(value="HoTen" selected=(searchField === 'HoTen')) Họ tên
        option(value="Email" selected=(searchField === 'Email')) Email
        option(value="MaSv" selected=(searchField === 'MaSv')) Mã sinh viên
      input#search-input(type="text" placeholder="Tìm tên đăng nhập, họ tên hoặc email..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group.admin-filter-group
      select#filter-role(onchange="applyFilters()")
        option(value="" selected=(!filterRole)) Tất cả vai trò
        option(value="admin" selected=(filterRole === 'admin')) Quản trị viên
        option(value="student" selected=(filterRole === 'student')) Sinh viên
      select#filter-group(onchange="applyFilters()")
        option(value="" selected=(!filterGroup)) Tất cả nhóm
        each group in groups
          option(value=group.MaNhom selected=(filterGroup === group.MaNhom))= group.TenNhom || group.MaNhom
    .admin-action-group
      if canCreateAccounts
        button.btn.btn-primary(type="button" onclick="openAccountModal()") Tạo tài khoản
      if canManageAccounts
        button.btn.btn-outline(type="button" onclick="openCredentialListModal()")
          span.material-symbols-rounded(aria-hidden="true") visibility
          span Danh sách TK
        button.btn.btn-outline(type="button" onclick="openBatchStudentModal()")
          span.material-symbols-rounded(aria-hidden="true") group_add
          span Tạo TK cho SV

  .card
    .card-header
      h3 Người dùng hệ thống
      span.card-count= accounts ? `${accounts.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th ID
            th Tài khoản
            th Liên hệ
            th Nhóm / vai trò
            th Ngày tạo
            th Thao tác
        tbody#accounts-table
          if accounts && accounts.length > 0
            each acc in accounts
              - const group = groups.find(g => g.MaNhom === acc.MaNhom)
              - const groupName = group ? group.TenNhom : acc.MaNhom
              - const roleLabel = acc.Role === 'admin' ? (groupName || 'Quản trị viên') : 'Sinh viên'
              tr(data-record=JSON.stringify(acc))
                td.mono= acc.MaTaiKhoan
                td.stacked-cell.account-summary
                  strong= acc.TenDangNhap
                  if acc.MaSv
                    small= `MSSV: ${acc.MaSv}`
                  if acc.QUANTRIVIEN && acc.QUANTRIVIEN.ChucVu
                    small= acc.QUANTRIVIEN.ChucVu
                td.stacked-cell.user-contact
                  strong= acc.HoTen || '-'
                  small= acc.Email || '-'
                  if acc.Sdt
                    small= acc.Sdt
                td.stacked-cell
                  span.badge.badge-secondary= groupName || '-'
                  if acc.Role === 'admin'
                    span.badge.badge-info= roleLabel
                  else
                    span.badge.badge-success= roleLabel
                td= acc.NgayTao ? new Date(acc.NgayTao).toLocaleDateString('vi-VN') : '-'
                td.table-actions.user-action-cell(data-no-row-detail="true")
                  .table-action-list
                    if currentUserId && parseInt(acc.MaTaiKhoan, 10) === parseInt(currentUserId, 10)
                      span.text-muted.current-account-note Tài khoản hiện tại
                    else if canManageAccounts
                      .account-actions
                        .account-group-control
                          span.material-symbols-rounded.account-group-icon(aria-hidden="true") groups
                          select.account-group-select(id=`group-${acc.MaTaiKhoan}` aria-label=`Chọn nhóm cho ${acc.TenDangNhap}` data-id=acc.MaTaiKhoan data-username=acc.TenDangNhap data-current-group=acc.MaNhom)
                            each optionGroup in groups
                              option(value=optionGroup.MaNhom selected=(acc.MaNhom === optionGroup.MaNhom))= optionGroup.TenNhom || optionGroup.MaNhom
                        button.btn.btn-sm.btn-secondary.account-action-button(type="button" title="Đổi nhóm" data-id=acc.MaTaiKhoan onclick="handleGroupChange(this)")
                          span.material-symbols-rounded(aria-hidden="true") sync_alt
                          span Đổi
                        button.btn.btn-sm.btn-danger.account-action-button(type="button" title="Xóa tài khoản" data-id=acc.MaTaiKhoan data-username=acc.TenDangNhap onclick="deleteAccount(this)")
                          span.material-symbols-rounded(aria-hidden="true") delete
                          span Xóa
                    else
                      span.text-muted Chỉ admin hệ thống
          else
            tr
              td(colspan="6")
                .empty-state Không có tài khoản phù hợp

  include ../../partials/pagination

block modals
  #account-modal.modal-overlay(onclick="if(event.target===this)closeAccountModal()")
    .modal
      .modal-header
        h2 Tạo tài khoản
        button.modal-close(type="button" onclick="closeAccountModal()" aria-label="Đóng") ×
      .modal-body
        form#account-form
          .form-row
            .form-group
              label(for="acc-group") Nhóm người dùng
              select.form-control#acc-group(required onchange="syncAccountFormMode()")
                each group in accountGroups
                  option(value=group.MaNhom data-role=group.Role)= group.TenNhom || group.MaNhom
            .form-group#acc-masv-group
              label(for="acc-masv") MSSV
              input.form-control#acc-masv(type="text" placeholder="Nhập MSSV đã có")
          .form-row
            .form-group
              label(for="acc-username") Tên đăng nhập
              input.form-control#acc-username(type="text" placeholder="Mặc định dùng MSSV cho sinh viên")
            .form-group
              label(for="acc-password") Mật khẩu
              input.form-control#acc-password(type="password" required autocomplete="new-password")
            .form-group
              label(for="acc-password-confirm") Xác nhận mật khẩu
              input.form-control#acc-password-confirm(type="password" required autocomplete="new-password")
          .form-row
            .form-group
              label(for="acc-hoten") Họ tên
              input.form-control#acc-hoten(type="text")
            .form-group
              label(for="acc-email") Email
              input.form-control#acc-email(type="email")
          .form-row
            .form-group
              label(for="acc-sdt") Số điện thoại
              input.form-control#acc-sdt(type="text")
            .form-group#acc-chucvu-group
              label(for="acc-chucvu") Chức vụ
              input.form-control#acc-chucvu(type="text")
          .form-group#acc-phongban-group
            label(for="acc-phongban") Phòng ban
            input.form-control#acc-phongban(type="text")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeAccountModal()") Hủy
        button.btn.btn-primary#btn-save-account(type="button" onclick="saveAccount()") Tạo

  #batch-student-modal.modal-overlay(onclick="if(event.target===this)closeBatchStudentModal()")
    .modal.modal-wide
      .modal-header
        h2 Tạo tài khoản hàng loạt cho sinh viên
        button.modal-close(type="button" onclick="closeBatchStudentModal()" aria-label="Đóng") ×
      .modal-body
        form#batch-student-form
          .form-row
            .form-group
              label(for="batch-faculty") Khoa
              select.form-control#batch-faculty(onchange="filterBatchMajors()")
                option(value="") Không lọc theo khoa
                if faculties && faculties.length
                  each faculty in faculties
                    option(value=faculty.MaKhoa)= faculty.TenKhoa || faculty.MaKhoa
            .form-group
              label(for="batch-major") Ngành
              select.form-control#batch-major
                option(value="") Không lọc theo ngành
                if majors && majors.length
                  each major in majors
                    option(value=major.MaNganh data-faculty=major.MaKhoa)= `${major.TenNganh || major.MaNganh}${major.KHOA ? ' - ' + major.KHOA.TenKhoa : ''}`
          #batch-result.empty-state.hidden
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeBatchStudentModal()") Đóng
        button.btn.btn-primary#btn-batch-create(type="button" onclick="batchCreateStudentAccounts()") Tạo tài khoản

  #credential-list-modal.modal-overlay(onclick="if(event.target===this)closeCredentialListModal()")
    .modal.modal-wide
      .modal-header
        h2 Danh sách tài khoản đã tạo
        button.modal-close(type="button" onclick="closeCredentialListModal()" aria-label="Đóng") ×
      .modal-body
        #credential-list-content.empty-state Đang tải danh sách...
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeCredentialListModal()") Đóng

block scripts
  script(src="/js/admin/users.js")
