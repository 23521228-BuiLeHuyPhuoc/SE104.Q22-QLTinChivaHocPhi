extends ../../layouts/admin

block styles
  link(rel="stylesheet" href="/css/admin/registrations.css")

block content
  .page-shell
    .toolbar.admin-toolbar
      .toolbar-title
        h2.page-title Báo cáo thống kê
        p Theo dõi doanh thu, công nợ và sinh viên chưa hoàn thành học phí.
      .filter-group.admin-filter-group
        select#report-semester(onchange="loadReports()")
          option(value="") Tất cả học kỳ
          if semesters && semesters.length
            each semester in semesters
              option(value=semester.MaHocKy)= `${semester.TenHocKy}${semester.NAMHOC ? ' - ' + semester.NAMHOC.TenNamHoc : ''}`
      .admin-action-group
        a.btn.btn-outline(href="/admin/reports/incomplete-tuition")
          span.material-symbols-rounded(aria-hidden="true") account_balance_wallet
          span Nợ học phí

    .stats-grid
      .stat-card
        .stat-icon.blue.material-symbols-rounded groups
        .stat-info
          h3#stat-students --
          p Tổng sinh viên
      .stat-card
        .stat-icon.green.material-symbols-rounded menu_book
        .stat-info
          h3#stat-courses --
          p Tổng môn học
      .stat-card
        .stat-icon.orange.material-symbols-rounded app_registration
        .stat-info
          h3#stat-registrations --
          p Lượt đăng ký
      .stat-card
        .stat-icon.purple.material-symbols-rounded payments
        .stat-info
          h3#stat-paid --
          p Đã thu
      .stat-card
        .stat-icon.red.material-symbols-rounded account_balance_wallet
        .stat-info
          h3#stat-remaining --
          p Còn nợ

    .toolbar.admin-toolbar#registration-statistics
      .toolbar-title
        h3 Thống kê đăng ký môn học
        p Tổng hợp sinh viên đăng ký theo khoa và ngành.
      .admin-action-group
        button.btn.btn-outline(type="button" onclick="exportRegistrationStats()")
          span.material-symbols-rounded(aria-hidden="true") download
          span Excel đăng ký
    .stats-grid
      .stat-card
        .stat-icon.orange.material-symbols-rounded app_registration
        .stat-info
          h3#registration-total-receipts --
          p Phiếu đăng ký
      .stat-card
        .stat-icon.green.material-symbols-rounded groups
        .stat-info
          h3#registration-total-students --
          p Sinh viên đăng ký
      .stat-card
        .stat-icon.blue.material-symbols-rounded menu_book
        .stat-info
          h3#registration-total-courses --
          p Môn đã đăng ký
    .registration-stat-grid
      .registration-stat-card
        .registration-stat-header
          div
            h3 Theo khoa
            p Sinh viên đăng ký được nhóm theo khoa quản lý ngành học.
          span.registration-stat-total#registration-faculty-count 0 khoa
        .registration-stat-list#registration-by-faculty
          .empty-state Đang tải dữ liệu thống kê theo khoa...
      .registration-stat-card
        .registration-stat-header
          div
            h3 Theo ngành
            p Sinh viên đăng ký được nhóm theo ngành học hiện tại.
          span.registration-stat-total#registration-major-count 0 ngành
        .registration-stat-list#registration-by-major
          .empty-state Đang tải dữ liệu thống kê theo ngành...

    .content-grid.two-columns
      .card
        .card-header
          h3 Doanh thu theo tháng
        .card-body
          canvas#revenue-chart(height="180")
      .card
        .card-header
          h3 Thanh toán theo phương thức
        .card-body
          canvas#method-chart(height="180")

    .content-grid.two-columns
      .card
        .card-header
          h3 Sinh viên theo trạng thái
        .table-container
          table.data-table
            thead
              tr
                th Trạng thái
                th Số lượng
            tbody#student-stats-table
              tr
                td(colspan="2")
                  .empty-state Đang tải dữ liệu...
      .card
        .card-header
          h3 Thanh toán theo phương thức
        .table-container
          table.data-table
            thead
              tr
                th Phương thức
                th Số giao dịch
                th Tổng tiền
            tbody#payment-stats-table
              tr
                td(colspan="3")
                  .empty-state Đang tải dữ liệu...

block scripts
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script(src="/js/admin/reports.js")
