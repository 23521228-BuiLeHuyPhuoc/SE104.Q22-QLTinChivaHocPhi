extends ../../layouts/admin

block content
  .page-shell
    .toolbar
      .toolbar-title
        h2.page-title Báo cáo thống kê
        p Theo dõi doanh thu, công nợ và sinh viên chưa hoàn thành học phí.
      .filter-group
        select#report-semester(onchange="loadReports()")
          option(value="") Tất cả học kỳ
          if semesters && semesters.length
            each semester in semesters
              option(value=semester.MaHocKy)= `${semester.TenHocKy}${semester.NAMHOC ? ' - ' + semester.NAMHOC.TenNamHoc : ''}`
        button.btn.btn-outline(type="button" onclick="exportIncompleteCsv()")
          span.material-symbols-rounded(aria-hidden="true") download
          span Excel nợ HP
        button.btn.btn-outline(type="button" onclick="printIncompleteReport()")
          span.material-symbols-rounded(aria-hidden="true") picture_as_pdf
          span PDF nợ HP

    .stats-grid
      .stat-card
        .stat-icon.blue.material-symbols-rounded groups
        .stat-info
          h3#stat-students --
          p Tổng sinh viên
      .stat-card
        .stat-icon.green.material-symbols-rounded menu_book
        .stat-info
          h3#stat-courses --
          p Tổng môn học
      .stat-card
        .stat-icon.orange.material-symbols-rounded app_registration
        .stat-info
          h3#stat-registrations --
          p Lượt đăng ký
      .stat-card
        .stat-icon.purple.material-symbols-rounded payments
        .stat-info
          h3#stat-paid --
          p Đã thu
      .stat-card
        .stat-icon.red.material-symbols-rounded account_balance_wallet
        .stat-info
          h3#stat-remaining --
          p Còn nợ

    .content-grid.two-columns
      .card
        .card-header
          h3 Doanh thu theo tháng
        .card-body
          canvas#revenue-chart(height="180")
      .card
        .card-header
          h3 Thanh toán theo phương thức
        .card-body
          canvas#method-chart(height="180")

    .content-grid.two-columns
      .card
        .card-header
          h3 Sinh viên theo trạng thái
        .table-container
          table.data-table
            thead
              tr
                th Trạng thái
                th Số lượng
            tbody#student-stats-table
              tr
                td(colspan="2")
                  .empty-state Đang tải dữ liệu...
      .card
        .card-header
          h3 Thanh toán theo phương thức
        .table-container
          table.data-table
            thead
              tr
                th Phương thức
                th Số giao dịch
                th Tổng tiền
            tbody#payment-stats-table
              tr
                td(colspan="3")
                  .empty-state Đang tải dữ liệu...

    .card
      .card-header
        h3 Sinh viên chưa hoàn thành học phí
      .card-body
        .toolbar
          .search-box
            input#debt-search(type="text" placeholder="Tìm MSSV hoặc họ tên..." onkeyup="debounceDebtSearch()")
          .filter-group
            select#debt-faculty(onchange="filterDebtMajors(); loadIncompleteTuition()")
              option(value="") Tất cả khoa
              if faculties && faculties.length
                each faculty in faculties
                  option(value=faculty.MaKhoa)= faculty.TenKhoa || faculty.MaKhoa
            select#debt-major(onchange="loadIncompleteTuition()")
              option(value="") Tất cả ngành
              if majors && majors.length
                each major in majors
                  option(value=major.MaNganh data-faculty=major.MaKhoa)= `${major.TenNganh || major.MaNganh}${major.KHOA ? ' - ' + major.KHOA.TenKhoa : ''}`
            select#debt-status(onchange="loadIncompleteTuition()")
              option(value="") Tất cả trạng thái nợ
              option(value="Chưa đóng") Chưa đóng
              option(value="Đóng một phần") Đóng một phần
              option(value="Quá hạn") Quá hạn
            select#debt-overdue(onchange="loadIncompleteTuition()")
              option(value="") Quá hạn và chưa quá hạn
              option(value="true") Chỉ quá hạn
              option(value="false") Chưa quá hạn
        .stats-grid
          .stat-card
            .stat-info
              h3#debt-total-students --
              p SV chưa hoàn thành
          .stat-card
            .stat-info
              h3#debt-total-amount --
              p Tổng còn nợ
          .stat-card
            .stat-info
              h3#debt-overdue-students --
              p SV quá hạn
          .stat-card
            .stat-info
              h3#debt-partial-students --
              p SV đóng một phần
        .table-container
          table.data-table
            thead
              tr
                th MSSV
                th Họ tên
                th Ngành/Khoa
                th Học kỳ
                th Phải đóng
                th Đã đóng
                th Còn nợ
                th Hạn đóng
                th Ngày quá hạn
                th Trạng thái
            tbody#incomplete-tuition-table
              tr
                td(colspan="10")
                  .empty-state Đang tải dữ liệu...

block scripts
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script(src="/js/admin/reports.js")
