extends ../../layouts/admin

block content
  form.toolbar(method="get" action="/admin/opened-courses")
    .search-box
      input(type="text" name="search" placeholder="Tìm lớp, môn học hoặc học kỳ..." value=(search || ''))
    .filter-group
      select.form-control(name="semester")
        option(value="") Tất cả học kỳ
        each item in semesters || []
          option(value=item.MaHocKy selected=(semester === item.MaHocKy)) #{item.TenHocKy}#{item.TenNamHoc ? ' - ' + item.TenNamHoc : ''}
      select.form-control(name="status")
        option(value="") Tất cả trạng thái
        option(value="active" selected=(status === 'active')) Đang mở
        option(value="inactive" selected=(status === 'inactive')) Đã đóng
      button.btn.btn-primary(type="submit") Lọc
      a.btn.btn-outline(href="/admin/opened-courses") Xóa lọc

  .card
    .card-header
      h3 Danh sách môn học mở
      span.card-count= typeof totalRecords !== 'undefined' ? `${totalRecords} bản ghi` : `${openedCourses ? openedCourses.length : 0} bản ghi`
    .table-container
      table.data-table
        thead
          tr
            th Học kỳ
            th Môn học
            th Lớp mở
            th Giảng viên
            th Lịch học
            th Đăng ký
            th Khoa
            th Trạng thái
            th Ghi chú
        tbody
          if openedCourses && openedCourses.length > 0
            each row in openedCourses
              tr
                td
                  strong= row.TenHocKy
                  if row.TenNamHoc
                    small= row.TenNamHoc
                td
                  strong= row.TenMonHoc
                  small #{row.MaMonHoc} · #{row.SoTinChi} TC
                td
                  strong= row.TenLop
                  small= row.MaLop
                td= row.GiangVien
                td= row.LichHocText
                td #{row.SoLuongDaDangKy} / #{row.SoLuongToiDa}
                td= row.TenKhoa
                td
                  span.badge(class=row.TrangThaiClass)= row.TrangThaiLabel
                td= row.GhiChu || '-'
          else
            tr
              td(colspan="9")
                .empty-state Không có môn học mở phù hợp

  include ../../partials/pagination
