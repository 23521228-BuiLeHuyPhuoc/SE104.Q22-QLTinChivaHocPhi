extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm MSSV hoặc họ tên sinh viên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(!status)) Tất cả trạng thái
        option(value="Đã đăng ký" selected=(status === 'Đã đăng ký')) Đã đăng ký
        option(value="Đã hủy" selected=(status === 'Đã hủy')) Đã hủy

  .card
    .card-header
      h3 Danh sách đăng ký tín chỉ
      span.card-count= registrations ? `${registrations.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Họ tên
            th Học kỳ
            th Môn học
            th Lớp
            th Tín chỉ
            th Loại đăng ký
            th Ngày đăng ký
            th Trạng thái
        tbody
          if registrations && registrations.length > 0
            each r in registrations
              - const student = r.PHIEUDANGKY ? r.PHIEUDANGKY.SINHVIEN : null
              - const semester = r.PHIEUDANGKY ? r.PHIEUDANGKY.HOCKY : null
              - const course = r.LOP ? r.LOP.MONHOC : null
              - const isCancelled = (r.TrangThai || '').toLowerCase().includes('hủy')
              tr
                td.mono= student ? student.MaSv : '-'
                td= student ? student.HoTen : '-'
                td= semester ? semester.TenHocKy : (r.PHIEUDANGKY ? r.PHIEUDANGKY.MaHocKy : '-')
                td
                  strong= course ? course.TenMonHoc : '-'
                  small= course ? course.MaMonHoc : ''
                td.mono= r.MaLop || '-'
                td= r.SoTinChi || '-'
                td
                  if r.LoaiDangKy === 'hoc_lai'
                    span.badge.badge-warning Học lại
                  else if r.LoaiDangKy === 'hoc_cai_thien'
                    span.badge.badge-info Cải thiện
                  else
                    span.badge.badge-success Học mới
                td= r.NgayDangKy ? new Date(r.NgayDangKy).toLocaleDateString('vi-VN') : '-'
                td
                  span.badge(class=isCancelled ? 'badge-error' : 'badge-success')= r.TrangThai || 'Đã đăng ký'
          else
            tr
              td(colspan="9")
                .empty-state Không có dữ liệu đăng ký

  include ../../partials/pagination

block scripts
  script(src="/js/admin/registrations.js")
