extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm MSSV hoặc họ tên sinh viên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(!status)) Tất cả trạng thái
        option(value="Đã đăng ký" selected=(status === 'Đã đăng ký')) Đã đăng ký
        option(value="Đã hủy" selected=(status === 'Đã hủy')) Đã hủy

  .card
    .card-header
      h3 Sinh viên đã đăng ký tín chỉ
      span.card-count= registrations ? `${registrations.length} sinh viên` : '0 sinh viên'
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Họ tên
            th Số phiếu
            th Học kỳ gần nhất
            th Môn đã đăng ký
            th Tín chỉ
            th Học phí
            th Đã thu
            th Trạng thái
            th Thao tác
        tbody
          if registrations && registrations.length > 0
            each r in registrations
              - const totalFee = Number(r.TongTienPhaiDong || 0)
              - const paid = Number(r.DaThu || 0)
              tr
                td.mono= r.MaSv
                td= r.SINHVIEN ? r.SINHVIEN.HoTen : '-'
                td= r.soPhieu || 0
                td
                  div= r.HocKyGanNhat || '-'
                  small= r.DanhSachHocKy || ''
                td= r.soMon || 0
                td= r.TongTinChi || 0
                td= totalFee.toLocaleString('vi-VN') + ' đ'
                td= paid.toLocaleString('vi-VN') + ' đ'
                td
                  span.badge(class=((r.TrangThaiTongHop || '').includes('hủy')) ? 'badge-error' : 'badge-success')= r.TrangThaiTongHop || 'Đã đăng ký'
                td.table-actions
                  button.btn.btn-sm.btn-outline.btn-icon(type="button" title="Xem chi tiết" aria-label="Xem chi tiết" data-ma-sv=r.MaSv onclick="openStudentRegistrationDetail(this.dataset.maSv)")
                    span.icon-eye(aria-hidden="true")
          else
            tr
              td(colspan="10")
                .empty-state Không có dữ liệu đăng ký

  include ../../partials/pagination

block modals
  #registration-detail-modal.modal-overlay(onclick="if(event.target===this)closeRegistrationDetail()")
    .modal
      .modal-header
        h3 Chi tiết đăng ký tín chỉ
        button.modal-close(type="button" onclick="closeRegistrationDetail()") ×
      .modal-body
        #registration-detail-content Đang tải...

block scripts
  script(src="/js/admin/registrations.js")
