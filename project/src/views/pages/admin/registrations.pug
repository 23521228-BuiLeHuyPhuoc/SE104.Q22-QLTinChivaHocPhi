extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm MSSV hoặc họ tên sinh viên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(!status)) Tất cả trạng thái
        option(value="Đã đăng ký" selected=(status === 'Đã đăng ký')) Đã đăng ký
        option(value="Đã hủy" selected=(status === 'Đã hủy')) Đã hủy

  .card
    .card-header
      h3 Danh sách phiếu đăng ký tín chỉ
      span.card-count= registrations ? `${registrations.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Số phiếu
            th MSSV
            th Họ tên
            th Học kỳ
            th Môn đã đăng ký
            th Tín chỉ
            th Học phí
            th Đã thu
            th Trạng thái
            th Thao tác
        tbody
          if registrations && registrations.length > 0
            each r in registrations
              - const paid = (r.PHIEUTHUHOCPHI || []).reduce((sum, item) => sum + Number(item.SoTienThu || 0), 0)
              - const totalFee = Number(r.TongTienPhaiDong || r.TongTienDangKy || 0)
              - const semesterName = r.HOCKY ? `${r.HOCKY.TenHocKy}${r.HOCKY.NAMHOC ? ' - ' + r.HOCKY.NAMHOC.TenNamHoc : ''}` : r.MaHocKy
              tr
                td.mono= r.SoPhieu
                td.mono= r.MaSv
                td= r.SINHVIEN ? r.SINHVIEN.HoTen : '-'
                td= semesterName
                td= r.CHITIETDANGKY ? r.CHITIETDANGKY.length : 0
                td= r.TongTinChi || 0
                td= totalFee.toLocaleString('vi-VN') + ' đ'
                td= paid.toLocaleString('vi-VN') + ' đ'
                td
                  span.badge(class=((r.TrangThai || '').includes('hủy') || (r.TrangThai || '').includes('hủy')) ? 'badge-error' : 'badge-success')= r.TrangThai || 'Đã đăng ký'
                td.actions
                  button.btn-icon(type="button" title="Xem chi tiết" data-so-phieu=r.SoPhieu onclick="openRegistrationDetail(this.dataset.soPhieu)") 👁
          else
            tr
              td(colspan="10")
                .empty-state Không có dữ liệu đăng ký

  include ../../partials/pagination

block modals
  #registration-detail-modal.modal-overlay(onclick="if(event.target===this)closeRegistrationDetail()")
    .modal
      .modal-header
        h3 Chi tiết đăng ký tín chỉ
        button.modal-close(type="button" onclick="closeRegistrationDetail()") ×
      .modal-body
        #registration-detail-content Đang tải...

block scripts
  script(src="/js/admin/registrations.js")
