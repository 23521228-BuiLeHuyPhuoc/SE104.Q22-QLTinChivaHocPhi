extends ../../layouts/admin

block styles
  link(rel="stylesheet" href="/css/admin/registrations.css")

block content
  - const registrationScope = registrationSearchScope || 'studentId'
  - const registrationSearchPlaceholders = { studentId: 'Nhập MSSV', studentName: 'Nhập họ tên sinh viên', major: 'Nhập mã ngành hoặc tên ngành', faculty: 'Nhập mã khoa hoặc tên khoa', semester: 'Nhập mã học kỳ, tên học kỳ hoặc năm học' }
  - const registrationSearchPlaceholder = registrationSearchPlaceholders[registrationScope] || 'Nhập từ khóa tìm kiếm'
  form.registration-filter-panel(method="get" action="/admin/registrations")
    .registration-search-row
      .registration-filter-field.registration-search-scope
        label(for="registration-search-scope") Tìm theo
        select.form-control#registration-search-scope(name="searchScope" onchange="updateRegistrationSearchPlaceholder(); applyFilters()")
          option(value="studentId" selected=(registrationScope === 'studentId') data-placeholder=registrationSearchPlaceholders.studentId) MSSV
          option(value="studentName" selected=(registrationScope === 'studentName') data-placeholder=registrationSearchPlaceholders.studentName) Họ tên
          option(value="major" selected=(registrationScope === 'major') data-placeholder=registrationSearchPlaceholders.major) Ngành
          option(value="faculty" selected=(registrationScope === 'faculty') data-placeholder=registrationSearchPlaceholders.faculty) Khoa
          option(value="semester" selected=(registrationScope === 'semester') data-placeholder=registrationSearchPlaceholders.semester) Học kỳ
      .registration-filter-field.registration-search-keyword
        label(for="search-input") Từ khóa tìm kiếm
        .search-box.registration-search-box
          input#search-input(type="text" name="search" placeholder=registrationSearchPlaceholder value=(search || '') autocomplete="off" onkeydown="runSearchOnEnter(event, debounceSearch)")
    .registration-filter-row
      .registration-filter-field
        label(for="registration-semester") Học kỳ thao tác
        select.form-control#registration-semester(name="MaHocKy" onchange="applyFilters()")
          option(value="" selected=(!selectedSemester)) Tất cả học kỳ
          if semesterActivityOptions && semesterActivityOptions.length
            each semester in semesterActivityOptions
              option(value=semester.MaHocKy selected=(selectedSemester === semester.MaHocKy) data-activity=JSON.stringify(semester))= semester.label
      .registration-filter-field
        label(for="filter-status") Lọc theo trạng thái
        select.form-control#filter-status(name="status" onchange="applyFilters()")
          option(value="" selected=(!status)) Tất cả trạng thái
          option(value="Đã đăng ký" selected=(status === 'Đã đăng ký')) Đã đăng ký
          option(value="Đã hủy" selected=(status === 'Đã hủy')) Đã hủy
      .registration-filter-actions
        a.btn.btn-outline(href="/admin/registrations") Xóa lọc

  .activity-window-panel#registration-activity-panel
    .activity-window-main
      .activity-window-title
        span.material-symbols-rounded(aria-hidden="true") event_available
        div
          h3 Thời gian đăng ký môn học
          p#registration-activity-semester Chọn học kỳ để xem thời hạn đăng ký
      span.badge.badge-secondary#registration-window-badge Chưa chọn
    .activity-window-grid
      .activity-window-item
        span Bắt đầu
        strong#registration-window-start -
      .activity-window-item
        span Kết thúc
        strong#registration-window-end -
      .activity-window-item
        span Thu học phí
        strong#registration-tuition-status -
    .activity-window-actions
      button.btn.btn-primary#finalize-registration-btn(type="button" onclick="finalizeSelectedRegistration()" disabled)
        span.material-symbols-rounded(aria-hidden="true") task_alt
        span Chốt đăng ký

  .card
    .card-header
      h3 Phiếu đăng ký môn học
      span.card-count= typeof totalRegistrationStudents !== 'undefined' ? `${totalRegistrationStudents} phiếu đăng ký` : (registrations ? `${registrations.length} phiếu đăng ký` : '0 phiếu đăng ký')
    .table-container
      table.data-table
        thead
          tr
            th.registration-student-id-col MSSV
            th Họ tên
            th Ngành/Khoa
            th Số phiếu
            th Học kỳ
            th Môn đã đăng ký
            th Tín chỉ
            th Trạng thái
            th Thao tác
        tbody
          if registrations && registrations.length > 0
            each r in registrations
              tr
                td.mono.registration-student-id-col= r.MaSv
                td= r.SINHVIEN ? r.SINHVIEN.HoTen : '-'
                td.registration-student-academic
                  - const major = r.SINHVIEN && r.SINHVIEN.NGANHHOC ? r.SINHVIEN.NGANHHOC : null
                  - const faculty = major && major.KHOA ? major.KHOA : null
                  div= major ? major.TenNganh : '-'
                  small= faculty ? faculty.TenKhoa : ''
                td= r.soPhieu || 0
                td
                  div= r.HocKyHienThi || r.DanhSachHocKy || '-'
                td= r.soMon || 0
                td= r.TongTinChi || 0
                td
                  span.badge(class=((r.TrangThaiTongHop || '').includes('hủy')) ? 'badge-error' : 'badge-success')= r.TrangThaiTongHop || 'Đã đăng ký'
                td.table-actions
                  .table-action-list
                    button.btn.btn-sm.btn-outline.btn-icon(type="button" title="Xem chi tiết" aria-label="Xem chi tiết" data-so-phieu=r.SoPhieu data-ma-sv=r.MaSv data-ma-hoc-ky=r.MaHocKy onclick="openRegistrationDetail(this.dataset.soPhieu)")
                      span.material-symbols-rounded(aria-hidden="true") visibility
          else
            tr
              td(colspan="9")
                .empty-state Không có dữ liệu đăng ký

  include ../../partials/pagination

block modals
  #registration-detail-modal.modal-overlay(onclick="if(event.target===this)closeRegistrationDetail()")
    .modal.modal-wide
      .modal-header
        h3 Chi tiết đăng ký môn học
        button.modal-close(type="button" onclick="closeRegistrationDetail()") ×
      .modal-body
        #registration-detail-content Đang tải...

block scripts
  script(src="/js/admin/registrations.js")
