extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tim ma hoac ten mon hoc..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select.form-control#faculty-filter(onchange="applyCourseFilters()")
        option(value="" selected=!filterKhoa) Tat ca khoa
        if faculties && faculties.length > 0
          each k in faculties
            option(value=k.MaKhoa selected=(filterKhoa === k.MaKhoa))= k.TenKhoa
      select.form-control#type-filter(onchange="applyCourseFilters()")
        option(value="" selected=!filterLoaiMon) Tat ca loai
        option(value="LT" selected=(filterLoaiMon === 'LT')) Ly thuyet
        option(value="TH" selected=(filterLoaiMon === 'TH')) Thuc hanh
      button.btn.btn-outline(type="button" onclick="exportCourses()") Xuat Excel
      button.btn.btn-primary(type="button" onclick="openModal('add')") Them mon hoc
      a.btn.btn-outline(href="/admin/trash?entity=courses") Thung rac

  .card
    .card-header
      h3 Danh muc mon hoc
      span.card-count= courses ? `${courses.length} ban ghi` : '0 ban ghi'
    .table-container
      table.data-table
        thead
          tr
            th Ma mon
            th Ten mon hoc
            th Tin chi
            th Loai
            th So tiet
            th Khoa
            th Sua boi
            th Sua luc
            th Thao tac
        tbody#courses-table
          if courses && courses.length > 0
            each c in courses
              tr.course-row(data-id=c.MaMonHoc onclick=`openCourseDetail('${c.MaMonHoc}')`)
                td.mono= c.MaMonHoc
                td
                  strong= c.TenMonHoc
                  if c.MoTa
                    small= c.MoTa
                td= c.SoTinChi || '-'
                td
                  span.badge(class=c.LoaiMon === 'TH' ? 'badge-success' : 'badge-primary')= c.LoaiMon || '-'
                td= c.SoTiet
                td= c.KHOA ? c.KHOA.TenKhoa : c.MaKhoa
                td= c.NguoiCapNhatTen || c.NguoiCapNhat || '-'
                td= c.NgayCapNhat ? new Date(c.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.table-actions(onclick="event.stopPropagation()")
                  button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(c) onclick="openModal('edit', JSON.parse(this.dataset.record))") Sua
                  button.btn.btn-sm.btn-danger(type="button" onclick=`deleteCourse('${c.MaMonHoc}')`) Xoa
          else
            tr
              td(colspan="9")
                .empty-state Khong co mon hoc phu hop

  include ../../partials/pagination

block modals
  #course-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Them mon hoc
        button.modal-close(type="button" onclick="closeModal()" aria-label="Dong") x
      .modal-body
        form#course-form
          .form-row
            .form-group
              label(for="mh-ma") Ma mon hoc
              input.form-control#mh-ma(type="text" required)
            .form-group
              label(for="mh-ten") Ten mon hoc
              input.form-control#mh-ten(type="text" required)
          .form-row
            .form-group
              label(for="mh-makhoa") Khoa
              select.form-control#mh-makhoa(required)
                option(value="") Chon khoa
                if faculties && faculties.length > 0
                  each k in faculties
                    option(value=k.MaKhoa)= k.TenKhoa
            .form-group
              label(for="mh-loai") Loai mon
              select.form-control#mh-loai(required)
                option(value="LT") Ly thuyet
                option(value="TH") Thuc hanh
          .form-row
            .form-group
              label(for="mh-sotiet") So tiet
              input.form-control#mh-sotiet(type="number" min="1" value="45" required)
            .form-group
              label(for="mh-tc") So tin chi
              input.form-control#mh-tc(type="number" min="1" max="10" value="3" readonly)
          .form-group
            label(for="mh-mota") Mo ta
            textarea.form-control#mh-mota(rows="3")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Huy
        button.btn.btn-primary(type="button" onclick="saveCourse()") Luu

  #course-detail-modal.modal-overlay(onclick="if(event.target===this)closeCourseDetail()")
    .modal.modal-wide
      .modal-header
        h2 Chi tiet mon hoc
        button.modal-close(type="button" onclick="closeCourseDetail()" aria-label="Dong") x
      .modal-body#course-detail-content Dang tai...

block scripts
  script(src="/js/admin/courses.js")
