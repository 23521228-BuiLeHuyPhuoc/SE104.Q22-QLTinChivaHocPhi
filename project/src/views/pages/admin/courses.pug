extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm mã hoặc tên môn học..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm môn học

  .card
    .card-header
      h3 Danh mục môn học
      span.card-count= courses ? `${courses.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Mã môn
            th Tên môn học
            th Tín chỉ
            th Loại
            th Số tiết
            th Khoa
            th Thao tác
        tbody#courses-table
          if courses && courses.length > 0
            each c in courses
              tr
                td.mono= c.MaMonHoc
                td
                  strong= c.TenMonHoc
                  if c.MoTa
                    small= c.MoTa
                td= c.SoTinChi || '-'
                td
                  span.badge.badge-info= c.LoaiMon || '-'
                td= c.SoTiet
                td= c.KHOA ? c.KHOA.TenKhoa : c.MaKhoa
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(c) onclick="openModal('edit', JSON.parse(this.dataset.record))") Sửa
                  button.btn.btn-sm.btn-danger(type="button" onclick=`deleteCourse('${c.MaMonHoc}')`) Xóa
          else
            tr
              td(colspan="7")
                .empty-state Không có môn học phù hợp

  include ../../partials/pagination

block modals
  #course-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm môn học
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#course-form
          .form-row
            .form-group
              label(for="mh-ma") Mã môn học
              input.form-control#mh-ma(type="text" required)
            .form-group
              label(for="mh-ten") Tên môn học
              input.form-control#mh-ten(type="text" required)
          .form-row
            .form-group
              label(for="mh-makhoa") Mã khoa
              input.form-control#mh-makhoa(type="text" required)
            .form-group
              label(for="mh-loai") Loại môn
              select.form-control#mh-loai(required)
                option(value="LT") Lý thuyết
                option(value="TH") Thực hành
          .form-row
            .form-group
              label(for="mh-sotiet") Số tiết
              input.form-control#mh-sotiet(type="number" min="1" value="45" required)
            .form-group
              label(for="mh-tc") Số tín chỉ
              input.form-control#mh-tc(type="number" min="1" max="10" value="3" readonly)
          .form-group
            label(for="mh-mota") Mô tả
            textarea.form-control#mh-mota(rows="3")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveCourse()") Lưu

block scripts
  script(src="/js/admin/courses.js")
