extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm kiếm môn học..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      button.btn.btn-primary(onclick="openModal('add')") + Thêm môn học

  .card
    .table-container
      table.data-table
        thead
          tr
            th Mã MH
            th Tên môn học
            th Số tín chỉ
            th Loại
            th Khoa
            th Thao tác
        tbody#courses-table
          if courses && courses.length > 0
            each c in courses
              tr
                td= c.ma_mon_hoc
                td= c.ten_mon_hoc
                td= c.so_tin_chi
                td= c.loai_mon_hoc || '-'
                td= c.ten_khoa || '-'
                td
                  button.btn.btn-sm.btn-outline(onclick=`openModal('edit', ${JSON.stringify(c)})`) ✏️
                  |  
                  button.btn.btn-sm.btn-danger(onclick=`deleteCourse('${c.ma_mon_hoc}')`) 🗑️
          else
            tr
              td(colspan="6").text-center Không có dữ liệu

  include ../../partials/pagination

block modals
  #course-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm môn học
        button.modal-close(onclick="closeModal()") ×
      .modal-body
        form#course-form
          .form-row
            .form-group
              label Mã môn học
              input.form-control#mh-ma(type="text" required)
            .form-group
              label Tên môn học
              input.form-control#mh-ten(type="text" required)
          .form-row
            .form-group
              label Số tín chỉ
              input.form-control#mh-tc(type="number" min="1" max="10" value="3" required)
            .form-group
              label Loại môn học
              select.form-control#mh-loai
                option(value="Bắt buộc") Bắt buộc
                option(value="Tự chọn") Tự chọn
          .form-group
            label Mô tả
            textarea.form-control#mh-mota(rows="3")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveCourse()") Lưu

block scripts
  script(src="/js/admin/courses.js")
