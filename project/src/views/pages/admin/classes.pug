extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm mã lớp, tên lớp hoặc giảng viên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm lớp
      a.btn.btn-outline(href="/admin/trash?entity=classes") Thùng rác

  .card
    .card-header
      h3 Danh sách lớp học
      span.card-count= classes ? `${classes.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Mã lớp
            th Tên lớp
            th Môn học
            th Giảng viên
            th Lịch học
            th Phòng
            th Đã đăng ký
            th Sĩ số tối đa
            th Sửa bởi
            th Sửa lúc
            th Thao tác
        tbody
          if classes && classes.length > 0
            each cl in classes
              tr
                td.mono= cl.MaLop
                td= cl.TenLop
                td
                  strong= cl.MONHOC ? cl.MONHOC.TenMonHoc : cl.MaMonHoc
                  small= cl.MaMonHoc
                td= cl.GiangVien || '-'
                td= cl.LichHoc || '-'
                td= cl.PhongHoc || '-'
                td= cl.CHITIETDANGKY ? cl.CHITIETDANGKY.length : 0
                td= cl.SoLuongToiDa || '-'
                td= cl.NguoiCapNhatTen || cl.NguoiCapNhat || '-'
                td= cl.NgayCapNhat ? new Date(cl.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(cl) onclick="openModal('edit', JSON.parse(this.dataset.record))") Sửa
                  button.btn.btn-sm.btn-danger(type="button" onclick=`deleteClass('${cl.MaLop}')`) Xóa
          else
            tr
              td(colspan="11")
                .empty-state Không có lớp học phù hợp

  include ../../partials/pagination

block modals
  #class-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm lớp học
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#class-form
          .form-row
            .form-group
              label(for="cl-malop") Mã lớp
              input.form-control#cl-malop(type="text" required)
            .form-group
              label(for="cl-tenlop") Tên lớp
              input.form-control#cl-tenlop(type="text" required)
          .form-row
            .form-group
              label(for="cl-mamonhoc") Mã môn học
              input.form-control#cl-mamonhoc(type="text" required)
            .form-group
              label(for="cl-giangvien") Giảng viên
              input.form-control#cl-giangvien(type="text")
          .form-row
            .form-group
              label(for="cl-lichhoc") Lịch học
              input.form-control#cl-lichhoc(type="text" placeholder="VD: Thứ 2 (7:30-9:30)")
            .form-group
              label(for="cl-phonghoc") Phòng học
              input.form-control#cl-phonghoc(type="text")
          .form-row
            .form-group
              label(for="cl-soluong") Số lượng tối đa
              input.form-control#cl-soluong(type="number" min="1" value="50")
            .form-group
              label(for="cl-mota") Mô tả
              input.form-control#cl-mota(type="text")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveClass()") Lưu

block scripts
  script(src="/js/admin/classes.js")
