extends ../../layouts/admin

block styles
  link(rel="stylesheet" href="/css/admin/course-tools.css")
  link(rel="stylesheet" href="/css/admin/classes.css")

block content
  .toolbar
    .toolbar-title
      h2.page-title Quản lý lớp học
      p Quản lý lớp, lịch học mặc định và trạng thái mở lớp theo học kỳ.
    .toolbar-actions
      button.btn.btn-primary(type="button" onclick="openModal('add')")
        span.material-symbols-rounded add
        span Thêm lớp
      a.btn.btn-outline(href="/admin/trash?entity=classes")
        span.material-symbols-rounded delete
        span Thùng rác

  - const classSearchScope = searchScope || 'classCode'
  - const classSearchPlaceholder = classSearchScope === 'className' ? 'Nhập tên lớp' : classSearchScope === 'course' ? 'Nhập mã môn hoặc tên môn học' : classSearchScope === 'lecturer' ? 'Nhập mã hoặc tên giảng viên' : 'Nhập mã lớp'
  form.class-filter-panel(method="get" action="/admin/classes")
    .class-filter-grid
      .class-filter-field.class-filter-scope
        label(for="filter-search-scope") Tìm theo
        select.form-control#filter-search-scope(name="searchScope" onchange="applyFilters()")
          option(value="classCode" selected=(classSearchScope === 'classCode')) Mã lớp
          option(value="className" selected=(classSearchScope === 'className')) Tên lớp
          option(value="course" selected=(classSearchScope === 'course')) Môn học
          option(value="lecturer" selected=(classSearchScope === 'lecturer')) Giảng viên
      .class-filter-field.class-filter-search
        label(for="search-input") Từ khóa tìm kiếm
        .search-box.class-search-box
          input#search-input(type="text" name="search" placeholder=classSearchPlaceholder value=(search || '') autocomplete="off" onkeyup="debounceSearch()")
      .class-filter-field.class-filter-semester
        label(for="filter-semester") Học kỳ
        select.form-control#filter-semester(name="MaHocKy" onchange="applyFilters()")
          option(value="") Tất cả học kỳ
          each semester in semesterOptions || []
            option(value=semester.MaHocKy selected=(selectedSemester === semester.MaHocKy)) #{semester.TenHocKy}#{semester.TenNamHoc ? ' - ' + semester.TenNamHoc : ''}
      .class-filter-field.class-filter-capacity
        label(for="filter-capacity-sort") SÄ© sá»‘
        select.form-control#filter-capacity-sort(name="capacitySort" onchange="applyFilters()")
          option(value="" selected=(!capacitySort)) Máº·c Ä‘á»‹nh
          option(value="capacity_asc" selected=(capacitySort === 'capacity_asc')) TÄƒng dáº§n
          option(value="capacity_desc" selected=(capacitySort === 'capacity_desc')) Giáº£m dáº§n
      .class-filter-field.class-filter-status
        span.class-filter-label Trạng thái mở lớp
        input#filter-open-status(type="hidden" name="openStatus" value=(openStatus || ''))
        .segmented-control#class-open-status-filter(role="group" aria-label="Lọc theo trạng thái mở lớp")
          button.segmented-option(type="button" class=(!openStatus ? 'active' : '') data-value="" onclick="setOpenStatusFilter(this.dataset.value)") Tất cả
          button.segmented-option(type="button" class=(openStatus === 'open' ? 'active' : '') data-value="open" onclick="setOpenStatusFilter(this.dataset.value)") Đang mở
          button.segmented-option(type="button" class=(openStatus === 'closed' ? 'active' : '') data-value="closed" onclick="setOpenStatusFilter(this.dataset.value)") Đã đóng
          button.segmented-option(type="button" class=(openStatus === 'not_open' ? 'active' : '') data-value="not_open" onclick="setOpenStatusFilter(this.dataset.value)") Chưa mở
      .class-filter-actions
        a.btn.btn-outline(href="/admin/classes")
          span.material-symbols-rounded restart_alt
          span Xóa lọc

  .card
    .card-header
      h3 Danh sách lớp học
      span.card-count= classes ? `${classes.length} bản ghi` : '0 bản ghi'
    .table-container.classes-table-container
      table.data-table.classes-table
        thead
          tr
            th Lớp
            th Môn học
            th Phụ trách / lịch
            th Sĩ số
            th Trạng thái mở
            th Cập nhật
            th Thao tác
        tbody
          if classes && classes.length > 0
            each cl in classes
              tr.clickable-row(data-id=cl.MaLop onclick="openClassDetail(this.dataset.id)")
                td.class-identity-cell
                  span.class-code.mono= cl.MaLop
                  span.class-name= cl.TenLop
                td.class-course-cell
                  span.class-course= cl.MONHOC ? cl.MONHOC.TenMonHoc : cl.MaMonHoc
                  small.mono= cl.MaMonHoc
                td.class-schedule-cell
                  .class-field
                    span.class-field-label Giảng viên
                    span.class-field-value= cl.GiangVienDisplay || '-'
                  .class-field
                    span.class-field-label Lịch / phòng
                    span.class-field-value= (cl.LichHocDisplay && cl.LichHocDisplay !== '-') ? cl.LichHocDisplay : (cl.PhongHocDisplay || '-')
                td.class-capacity-cell
                  span.class-capacity #{cl.SoLuongDaDangKy || 0} / #{cl.SoLuongToiDa || '-'}
                td.class-state-cell
                  span.badge(class=cl.TrangThaiMoClass)= cl.TrangThaiMoLabel
                  if cl.TenHocKyDangMo
                    small= cl.TenHocKyDangMo
                td.class-update-cell
                  span= cl.NguoiCapNhatTen || cl.NguoiCapNhat || '-'
                  small= cl.NgayCapNhat ? new Date(cl.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.class-actions-cell
                  .class-actions
                    if cl.LopMoHienTaiId
                      button.btn.btn-sm.btn-close-class(type="button" data-lopmoid=cl.LopMoHienTaiId onclick="event.stopPropagation(); closeOpenedClass(this.dataset.lopmoid)")
                        span.material-symbols-rounded block
                        span Đóng
                    else if selectedSemester && !cl.MonHocDaMoTrongHocKy
                      a.btn.btn-sm.btn-outline(href="/admin/open-courses?MaHocKy=" + selectedSemester + "&search=" + cl.MaMonHoc title="Mở môn học trước")
                        span.material-symbols-rounded event_available
                        span Môn chưa mở
                    else
                      button.btn.btn-sm.btn-open-class(type="button" data-record=JSON.stringify(cl) onclick="event.stopPropagation(); openClass(JSON.parse(this.dataset.record))")
                        span.material-symbols-rounded add_circle
                        span Mở
                    button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(cl) onclick="openModal('edit', JSON.parse(this.dataset.record))" title="Sửa lớp")
                      span.material-symbols-rounded edit
                      span Sửa
                    button.btn.btn-sm.btn-outline(type="button" data-malop=cl.MaLop data-tenlop=cl.TenLop onclick="openStudentsModal(this.dataset.malop, this.dataset.tenlop)" title="Danh sách sinh viên")
                      span.material-symbols-rounded groups
                      span DS SV
                    button.btn.btn-sm.btn-danger(type="button" data-malop=cl.MaLop onclick="deleteClass(this.dataset.malop)" title="Xóa lớp")
                      span.material-symbols-rounded delete
                      span Xóa
          else
            tr
              td(colspan="7")
                .empty-state Không có lớp học phù hợp

  include ../../partials/pagination

block modals
  #class-detail-modal.modal-overlay(onclick="if(event.target===this)closeClassDetail()")
    .modal.modal-wide
      .modal-header
        h2 Chi tiáº¿t lá»›p há»c
        button.modal-close(type="button" onclick="closeClassDetail()" aria-label="ÄÃ³ng") Ã—
      .modal-body
        #class-detail-content
          .empty-state Äang táº£i thÃ´ng tin lá»›p há»c...

  #class-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal.class-form-modal
      .modal-header
        h2#modal-title Thêm lớp học
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#class-form
          .form-row
            .form-group
              label(for="cl-malop") Mã lớp
              input.form-control#cl-malop(type="text" required)
            .form-group
              label(for="cl-tenlop") Tên lớp
              input.form-control#cl-tenlop(type="text" required)
          .form-row
            .form-group
              label(for="cl-mamonhoc") Môn học
              select.form-control.class-picker-native#cl-mamonhoc(required)
                option(value="") Chọn môn học
                each course in courseOptions || []
                  option(value=course.MaMonHoc) #{course.MaMonHoc} - #{course.TenMonHoc}
              button.class-picker-trigger#cl-course-picker(type="button" onclick="openEntityPicker('course')")
                span.class-picker-main#cl-course-picker-text Chọn môn học
                span.material-symbols-rounded search
            .form-group
              label(for="cl-magiangvien") Giảng viên
              select.form-control.class-picker-native#cl-magiangvien
                option(value="") Chọn giảng viên
                each lecturer in lecturerOptions || []
                  option(value=lecturer.MaGiangVien) #{lecturer.MaGiangVien} - #{lecturer.HocHamHocVi ? lecturer.HocHamHocVi + ' ' : ''}#{lecturer.HoTen}
              button.class-picker-trigger#cl-lecturer-picker(type="button" onclick="openEntityPicker('lecturer')")
                span.class-picker-main#cl-lecturer-picker-text Chọn giảng viên
                span.material-symbols-rounded person_search
          .form-row
            .form-group
              label(for="cl-thu") Thứ
              select.form-control#cl-thu
                option(value="2") Thứ 2
                option(value="3") Thứ 3
                option(value="4") Thứ 4
                option(value="5") Thứ 5
                option(value="6") Thứ 6
                option(value="7") Thứ 7
                option(value="1") Chủ nhật
            .form-group
              label(for="cl-tietbd") Tiết bắt đầu
              select.form-control#cl-tietbd
                option(value="") Chọn tiết
                each period in periodOptions || []
                  option(value=period.MaTiet data-order=period.ThuTu) #{period.TenTiet}#{period.GioBatDauText ? ' (' + period.GioBatDauText + ')' : ''}
          .form-row
            .form-group
              label(for="cl-tietkt") Tiết kết thúc
              select.form-control#cl-tietkt
                option(value="") Chọn tiết
                each period in periodOptions || []
                  option(value=period.MaTiet data-order=period.ThuTu) #{period.TenTiet}#{period.GioKetThucText ? ' (' + period.GioKetThucText + ')' : ''}
            .form-group
              label(for="cl-maphong") Phòng
              select.form-control.class-picker-native#cl-maphong
                option(value="") Chọn phòng
                each room in roomOptions || []
                  option(value=room.MaPhong) #{room.MaPhong} - #{room.TenPhong}#{room.SucChua ? ' (' + room.SucChua + ')' : ''}
              button.class-picker-trigger#cl-room-picker(type="button" onclick="openEntityPicker('room')")
                span.class-picker-main#cl-room-picker-text Chọn phòng
                span.material-symbols-rounded meeting_room
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveClass()") Lưu

  #entity-picker-modal.modal-overlay.entity-picker-overlay(onclick="if(event.target===this)closeEntityPicker()")
    .modal.entity-picker-modal
      .modal-header
        div
          h2#entity-picker-title Chọn dữ liệu
          p#entity-picker-subtitle.entity-picker-subtitle Tìm theo mã hoặc tên
        button.modal-close(type="button" onclick="closeEntityPicker()" aria-label="Đóng") ×
      .modal-body.entity-picker-body
        .entity-picker-search
          span.material-symbols-rounded search
          input.form-control#entity-picker-search(type="text" autocomplete="off" placeholder="Nhập mã hoặc tên")
        .entity-picker-meta#entity-picker-meta
        .entity-picker-results#entity-picker-results
          .empty-state Chưa có dữ liệu

  #class-students-modal.modal-overlay(onclick="if(event.target===this)closeStudentsModal()")
    .modal.modal-wide
      .modal-header
        h2#students-modal-title Danh sách sinh viên
        button.modal-close(type="button" onclick="closeStudentsModal()" aria-label="Đóng") ×
      .modal-body
        .form-group
          label(for="students-mahocky") Học kỳ
          select.form-control#students-mahocky(onchange="loadClassStudents()")
            option(value="") Tất cả học kỳ
            each semester in semesterOptions || []
              option(value=semester.MaHocKy) #{semester.TenHocKy}#{semester.TenNamHoc ? ' - ' + semester.TenNamHoc : ''}
        input#students-malop(type="hidden")
        .table-container
          table.data-table
            thead
              tr
                th MSSV
                th Họ tên
                th Học kỳ
                th Ngày ĐK
                th Trạng thái
            tbody#students-table-body
              tr
                td(colspan="5")
                  .empty-state Chưa tải danh sách sinh viên

block scripts
  script(src="/js/admin/classes.js")
