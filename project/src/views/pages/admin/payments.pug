extends ../../layouts/admin

block content
  - const money = (value) => Number(value || 0).toLocaleString('vi-VN') + ' đ'
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm phiếu thu, MSSV hoặc họ tên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-semester(onchange="applyFilters()")
        option(value="" selected=(!MaHocKy)) Tất cả học kỳ
        if semesterActivityOptions && semesterActivityOptions.length
          each semester in semesterActivityOptions
            option(value=semester.MaHocKy selected=(MaHocKy === semester.MaHocKy) data-activity=JSON.stringify(semester))= semester.label
      select#filter-method(onchange="applyFilters()")
        option(value="" selected=(!HinhThucThu)) Tất cả phương thức
        option(value="Tiền mặt" selected=(HinhThucThu === 'Tiền mặt')) Tiền mặt
        option(value="Chuyển khoản" selected=(HinhThucThu === 'Chuyển khoản')) Chuyển khoản
        option(value="Thẻ" selected=(HinhThucThu === 'Thẻ')) Thẻ
        option(value="Ví điện tử" selected=(HinhThucThu === 'Ví điện tử')) Ví điện tử
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(!TrangThai)) Tất cả trạng thái
        option(value="Chưa thanh toán" selected=(TrangThai === 'Chưa thanh toán')) Chưa thanh toán
        option(value="Thành công" selected=(TrangThai === 'Thành công')) Thành công
        option(value="Chờ xác nhận" selected=(TrangThai === 'Chờ xác nhận')) Chờ xác nhận
        option(value="Thất bại" selected=(TrangThai === 'Thất bại')) Thất bại
        option(value="Đã hủy" selected=(TrangThai === 'Đã hủy')) Đã hủy
      button.btn.btn-primary(type="button" onclick="openModal()")
        span.material-symbols-rounded(aria-hidden="true") receipt_long
        span Lập phiếu thu
      button.btn.btn-outline(type="button" onclick="openBulkModal()")
        span.material-symbols-rounded(aria-hidden="true") playlist_add
        span Tạo hàng loạt
      button.btn.btn-outline(type="button" onclick="exportPayments()")
        span.material-symbols-rounded(aria-hidden="true") download
        span Xuất Excel

  .activity-window-panel#payment-activity-panel
    .activity-window-main
      .activity-window-title
        span.material-symbols-rounded(aria-hidden="true") payments
        div
          h3 Thời gian thu học phí
          p#payment-activity-semester Chọn học kỳ để xem thời hạn thu
      span.badge.badge-secondary#payment-window-badge Chưa chọn
    .activity-window-grid
      .activity-window-item
        span Bắt đầu
        strong#payment-window-start -
      .activity-window-item
        span Kết thúc
        strong#payment-window-end -
      .activity-window-item
        span Chốt đăng ký
        strong#payment-finalized-state -
    .activity-window-actions
      button.btn.btn-primary#open-tuition-btn(type="button" onclick="openSelectedTuitionPayment()" disabled)
        span.material-symbols-rounded(aria-hidden="true") lock_open
        span Mở thu
      button.btn.btn-outline#close-tuition-btn(type="button" onclick="closeSelectedTuitionPayment()" disabled)
        span.material-symbols-rounded(aria-hidden="true") lock
        span Khóa thu

  .card
    .card-header
      h3 Phiếu thu học phí
      span.card-count= payments ? `${payments.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Số phiếu
            th MSSV
            th Họ tên
            th Học kỳ
            th Số tiền
            th Phương thức
            th Ngày thu
            th Người thu
            th Trạng thái
            th Thao tác
        tbody
          if payments && payments.length > 0
            each p in payments
              - const paymentStatus = p.TrangThai || 'Thành công'
              - const paymentBadge = paymentStatus === 'Thành công' ? 'badge-success' : (paymentStatus === 'Chờ xác nhận' || paymentStatus === 'Chưa thanh toán') ? 'badge-warning' : 'badge-error'
              tr
                td.mono= p.SoPhieuThu
                td.mono= p.MaSv || '-'
                td= p.SINHVIEN ? p.SINHVIEN.HoTen : '-'
                td
                  strong= p.HocKyDisplay || '-'
                td.currency= money(p.SoTienThu)
                td= p.HinhThucThu || '-'
                td= p.NgayLap ? new Date(p.NgayLap).toLocaleDateString('vi-VN') : '-'
                td= p.NguoiThu || '-'
                td
                  span.badge(class=paymentBadge)= paymentStatus
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" onclick=`viewPaymentDetail(${p.SoPhieuThu})`)
                    span.material-symbols-rounded(aria-hidden="true") visibility
                    span Xem
                  button.btn.btn-sm.btn-secondary(type="button" onclick=`printPayment(${p.SoPhieuThu})`)
                    span.material-symbols-rounded(aria-hidden="true") print
                    span In
                  if paymentStatus === 'Chờ xác nhận'
                    button.btn.btn-sm.btn-success(type="button" onclick=`confirmPayment(${p.SoPhieuThu})`) Xác nhận
                  if paymentStatus === 'Chờ xác nhận'
                    button.btn.btn-sm.btn-danger(type="button" onclick=`failPayment(${p.SoPhieuThu})`) Thất bại
                  if paymentStatus === 'Chờ xác nhận' || paymentStatus === 'Chưa thanh toán'
                    button.btn.btn-sm.btn-outline(type="button" onclick=`cancelPayment(${p.SoPhieuThu})`) Hủy
          else
            tr
              td(colspan="10")
                .empty-state Chưa có phiếu thu

  include ../../partials/pagination

block modals
  #payment-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2 Lập phiếu thu học phí
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#payment-form
          .form-row
            .form-group
              label(for="pt-mssv") MSSV
              input.form-control#pt-mssv(type="text" required)
            .form-group
              label(for="pt-hocky") Học kỳ
              select.form-control#pt-hocky(required)
                option(value="") Chọn học kỳ
          #student-debt-info.empty-state.hidden
          .form-row
            .form-group
              label(for="pt-sotien") Số tiền
              input.form-control#pt-sotien(type="number" min="1" required readonly)
            .form-group
              label(for="pt-phuongthuc") Phương thức thanh toán
              select.form-control#pt-phuongthuc
                option(value="Tiền mặt") Tiền mặt
                option(value="Chuyển khoản") Chuyển khoản
                option(value="Thẻ") Thẻ
          .form-group
            label(for="pt-ghichu") Ghi chú
            textarea.form-control#pt-ghichu(rows="2")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="savePayment()") Lưu phiếu thu

  #payment-bulk-modal.modal-overlay(onclick="if(event.target===this)closeBulkModal()")
    .modal
      .modal-header
        h2 Tạo phiếu thu hàng loạt
        button.modal-close(type="button" onclick="closeBulkModal()" aria-label="Đóng") ×
      .modal-body
        .form-group
          label(for="bulk-hocky") Học kỳ
          select.form-control#bulk-hocky(required)
            option(value="") Chọn học kỳ
            if semesterActivityOptions && semesterActivityOptions.length
              each semester in semesterActivityOptions
                option(value=semester.MaHocKy)= semester.label
        p.text-muted Hệ thống sẽ tạo phiếu cho các phiếu đăng ký còn nợ và chưa có phiếu thu đang hiệu lực.
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeBulkModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveBulkPayments()") Tạo phiếu

  #payment-detail-modal.modal-overlay(onclick="if(event.target===this)closePaymentDetail()")
    .modal.modal-wide
      .modal-header
        h2#payment-detail-title Chi tiết phiếu thu
        button.modal-close(type="button" onclick="closePaymentDetail()" aria-label="Đóng") ×
      .modal-body#payment-detail-body
        .empty-state Đang tải dữ liệu...
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closePaymentDetail()") Đóng
        button.btn.btn-primary(type="button" onclick="printLoadedPayment()") In phiếu

block scripts
  script(src="/js/admin/payments.js")
