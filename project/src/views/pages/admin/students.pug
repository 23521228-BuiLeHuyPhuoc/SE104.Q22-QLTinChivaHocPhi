extends ../../layouts/admin

block content
  - const total = students ? students.length : 0
  - const studying = students ? students.filter(s => s.TrangThai === 'Đang học').length : 0
  - const graduated = students ? students.filter(s => s.TrangThai === 'Đã tốt nghiệp').length : 0
  - const suspended = students ? students.filter(s => s.TrangThai === 'Bảo lưu').length : 0

  .stats-grid.mb-4
    .stat-card
      .stat-icon.blue.material-symbols-rounded groups
      .stat-info
        h3= total
        p Tổng sinh viên
    .stat-card
      .stat-icon.green.material-symbols-rounded check_circle
      .stat-info
        h3= studying
        p Đang học
    .stat-card
      .stat-icon.purple.material-symbols-rounded school
      .stat-info
        h3= graduated
        p Đã tốt nghiệp
    .stat-card
      .stat-icon.orange.material-symbols-rounded pause_circle
      .stat-info
        h3= suspended
        p Bảo lưu

  .toolbar.admin-toolbar
    .search-box.search-box-with-criterion.admin-search-group.students-search-group
      label.admin-search-label(for="student-search-field") Tìm theo
      select.form-control.ui-search-criterion-select#student-search-field(onchange="applyFilters()" aria-label="Tiêu chí tìm kiếm")
        option(value="all" selected=((searchField || 'all') === 'all')) Tất cả
        option(value="MaSv" selected=(searchField === 'MaSv')) MSSV
        option(value="HoTen" selected=(searchField === 'HoTen')) Họ tên
        option(value="Email" selected=(searchField === 'Email')) Email
      input#search-input(type="text" placeholder="Tìm MSSV, họ tên hoặc email..." value=(search || '') data-search-field=(searchField || 'all') onkeydown="runSearchOnEnter(event, debounceSearch)")
    .filter-group.admin-filter-group
      select#filter-faculty(onchange='onFacultyFilterChange()')
        option(value='') Tất cả khoa
      select#filter-major(onchange='applyFilters()')
        option(value='') Tất cả ngành
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(status === '' || !status)) Tất cả trạng thái
        option(value="Đang học" selected=(status === 'Đang học')) Đang học
        option(value="Đã tốt nghiệp" selected=(status === 'Đã tốt nghiệp')) Đã tốt nghiệp
        option(value="Bảo lưu" selected=(status === 'Bảo lưu')) Bảo lưu
        option(value="Đã thôi học" selected=(status === 'Đã thôi học')) Đã thôi học
    .admin-action-group
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm sinh viên
      a.btn.btn-outline(href="/admin/trash?entity=students") Thùng rác

  .toolbar
    .filter-group
      button.btn.btn-outline(type='button' onclick='exportStudents()') Xuất Excel
      label.btn.btn-outline(for='students-import-input') Nhập Excel
      input#students-import-input(type='file' accept='.xlsx' hidden onchange='onImportStudentsFileChange()')

  #students-import-result.hidden

  .card
    .card-header
      h3 Danh sách sinh viên
      span.card-count= students ? `${students.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table.students-table
        thead
          tr
            th MSSV
            th Họ tên
            th Liên hệ
            th Ngành
            th Khoa
            th Dân tộc
            th Đối tượng
            th Trạng thái
            th Sửa bởi
            th Sửa lúc
            th Thao tác
        tbody#students-table
          if students && students.length > 0
            each sv in students
              - const major = sv.NGANHHOC || {}
              - const faculty = major.KHOA || {}
              - const beneficiaries = (sv.DOITUONGSINHVIEN || []).map(item => item.DOITUONG ? item.DOITUONG.TenDoiTuong : item.MaDoiTuong).filter(Boolean).join(', ')
              tr(data-record=JSON.stringify(sv))
                td.mono= sv.MaSv
                td
                  div(style="display: flex; align-items: center; gap: 12px;")
                    .avatar(style="width: 36px; height: 36px; border-radius: 50%; background-color: var(--primary-100, #e0f2fe); color: var(--primary-700, #0369a1); display: flex; align-items: center; justify-content: center; font-weight: bold; overflow: hidden;")
                      if sv.AnhDaiDien
                        img(src=sv.AnhDaiDien alt=sv.HoTen style="width: 100%; height: 100%; object-fit: cover;")
                      else
                        = (sv.HoTen || 'SV').charAt(0).toUpperCase()
                    div
                      strong= sv.HoTen
                      small(style="display: block; opacity: 0.7;")= sv.GioiTinh || ''
                td
                  div= sv.Email || '-'
                  small= sv.Sdt || ''
                  small= sv.DiaChiLienHe || ''
                td= major.TenNganh || sv.MaNganh || '-'
                td= faculty.TenKhoa || '-'
                td= sv.DANTOC ? sv.DANTOC.TenDanToc : (sv.MaDanToc || '-')
                td= beneficiaries || '-'
                td
                  span.badge(class=sv.TrangThai === 'Đang học' ? 'badge-success' : sv.TrangThai === 'Bảo lưu' ? 'badge-warning' : sv.TrangThai === 'Đã tốt nghiệp' ? 'badge-info' : 'badge-error')= sv.TrangThai || '-'
                td= sv.NguoiCapNhatTen || sv.NguoiCapNhat || '-'
                td= sv.NgayCapNhat ? new Date(sv.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.table-actions(data-no-row-detail="true")
                  .table-action-list
                    button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(sv) onclick="openModal('edit', JSON.parse(this.dataset.record))") Sửa
                    button.btn.btn-sm.btn-danger(type="button" onclick=`deleteStudent('${sv.MaSv}')`) Xóa
          else
            tr
              td(colspan="11")
                .empty-state Không có sinh viên phù hợp

  include ../../partials/pagination

block modals
  #student-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm sinh viên
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#student-form
          .modal-tabs(style="display: flex; gap: 1rem; border-bottom: 1px solid var(--border-color, #e5e7eb); margin-bottom: 1.5rem;")
            button.tab-btn.active(type="button" data-tab="sv-tab-personal" style="padding: 0.5rem 1rem; background: none; border: none; border-bottom: 2px solid var(--primary-color, #0ea5e9); color: var(--primary-color, #0ea5e9); font-weight: 600; cursor: pointer;") Cá nhân
            button.tab-btn(type="button" data-tab="sv-tab-academic" style="padding: 0.5rem 1rem; background: none; border: none; border-bottom: 2px solid transparent; color: var(--text-color, #374151); cursor: pointer;" onclick="switchSvTab(this)") Học vấn
            button.tab-btn(type="button" data-tab="sv-tab-beneficiary" style="padding: 0.5rem 1rem; background: none; border: none; border-bottom: 2px solid transparent; color: var(--text-color, #374151); cursor: pointer;" onclick="switchSvTab(this)") Đối tượng ưu tiên

          .tab-content
            #sv-tab-personal.tab-pane(style="display: block;")
              .profile-avatar-panel
                .profile-avatar-preview
                  img#sv-avatar-img.hidden(src='' alt='Ảnh đại diện')
                  span#sv-avatar-initials SV
                .profile-avatar-actions
                  label.btn.btn-outline(for='sv-avatar-input') Chọn ảnh
                  input#sv-avatar-input(type='file' accept='image/jpeg,image/png,image/webp,image/gif' hidden)
                  button.btn.btn-primary#btn-upload-student-avatar(type='button' disabled onclick='uploadStudentAvatar()') Cập nhật ảnh
                  small JPG, PNG, WebP hoặc GIF, tối đa 3MB. Cần lưu sinh viên trước khi tải lên.
              .form-row
                .form-group
                  label(for="sv-mssv") MSSV
                  input.form-control#sv-mssv(type="text" required)
                .form-group
                  label(for="sv-hoten") Họ tên
                  input.form-control#sv-hoten(type="text" required)
              .form-row
                .form-group
                  label(for="sv-email") Email
                  input.form-control#sv-email(type="email")
                .form-group
                  label(for="sv-sdt") Số điện thoại
                  input.form-control#sv-sdt(type="text")
              .form-row
                .form-group
                  label(for="sv-ngaysinh") Ngày sinh
                  input.form-control#sv-ngaysinh(type="date" required)
                .form-group
                  label(for="sv-gioitinh") Giới tính
                  select.form-control#sv-gioitinh
                    option(value="Nam") Nam
                    option(value="Nữ") Nữ
              .form-row
                .form-group
                  label(for="sv-cmnd") CMND/CCCD
                  input.form-control#sv-cmnd(type="text" required)
                .form-group
                  label(for="sv-dantoc") Dân tộc
                  select.form-control#sv-dantoc(required)
                    option(value="") Chọn dân tộc
              .form-row
                .form-group
                  label(for="sv-tinh") Tỉnh/Thành phố
                  select.form-control#sv-tinh(required onchange="onProvinceChange()")
                    option(value="") Chọn Tỉnh/Thành phố
                .form-group
                  label(for="sv-phuongxa") Phường/Xã
                  select.form-control#sv-phuongxa(required)
                    option(value="") Chọn Phường/Xã
              .form-group
                label(for="sv-diachi") Địa chỉ liên hệ
                input.form-control#sv-diachi(type="text" required)

            #sv-tab-academic.tab-pane(style="display: none;")
              .form-row
                .form-group
                  label(for="sv-nganh") Ngành
                  select.form-control#sv-nganh(required)
                    option(value="") Chọn ngành
                .form-group
                  label(for="sv-trangthai") Trạng thái
                  select.form-control#sv-trangthai
                    option(value="Đang học") Đang học
                    option(value="Bảo lưu") Bảo lưu
                    option(value="Đã tốt nghiệp") Đã tốt nghiệp
                    option(value="Đã thôi học") Đã thôi học

            #sv-tab-beneficiary.tab-pane(style="display: none;")
              .form-group
                label Đối tượng ưu tiên hiện tại
                #student-beneficiaries-current.profile-readonly-panel
                  .empty-state Chưa thuộc đối tượng ưu tiên nào
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveStudent()") Lưu

block scripts
  script(src="/js/admin/students.js")
