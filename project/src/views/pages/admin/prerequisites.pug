extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tim ma hoac ten mon hoc..." value=(search || '') onkeyup="debouncePrereqSearch()")
    .filter-group
      select.form-control#type-filter(onchange="applyPrereqFilters()")
        option(value="" selected=!filterType) Tat ca loai
        option(value="tien_quyet" selected=filterType === 'tien_quyet') Tien quyet
        option(value="hoc_truoc" selected=filterType === 'hoc_truoc') Hoc truoc
      button.btn.btn-primary(type="button" onclick="openPrereqModal('add')") Them rang buoc
      button.btn.btn-outline(type="button" onclick="openPrereqGraph()") Xem so do
      a.btn.btn-outline(href="/admin/trash?entity=prerequisites") Thung rac

  .card
    .card-header
      h3 Danh sach rang buoc mon hoc
      span.card-count= prerequisites ? `${prerequisites.length} ban ghi` : '0 ban ghi'
    .table-container
      table.data-table
        thead
          tr
            th Mon hoc
            th Mon dieu kien
            th Loai
            th Mo ta
            th Trang thai
            th Sua boi
            th Sua luc
            th Thao tac
        tbody
          if prerequisites && prerequisites.length > 0
            each p in prerequisites
              - const course = p.MONHOC_DIEUKIENMONHOC_MaMonHocToMONHOC || {}
              - const requiredCourse = p.MONHOC_DIEUKIENMONHOC_MaMonDieuKienToMONHOC || {}
              tr
                td
                  strong= course.TenMonHoc || p.MaMonHoc
                  small.mono= p.MaMonHoc
                td
                  strong= requiredCourse.TenMonHoc || p.MaMonDieuKien
                  small.mono= p.MaMonDieuKien
                td
                  span.badge(class=p.LoaiDieuKien === 'tien_quyet' ? 'badge-primary' : 'badge-warning')= p.LoaiDieuKienLabel || p.LoaiDieuKien
                td= p.MoTa || '-'
                td
                  span.badge(class=p.TrangThai === false ? 'badge-secondary' : 'badge-success')= p.TrangThai === false ? 'Tam khoa' : 'Dang dung'
                td= p.NguoiCapNhatTen || p.NguoiCapNhat || '-'
                td= p.NgayCapNhat ? new Date(p.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(p) onclick="openPrereqModal('edit', JSON.parse(this.dataset.record))") Sua
                  button.btn.btn-sm.btn-danger(type="button" onclick=`deletePrereq(${p.id})`) Xoa
          else
            tr
              td(colspan="8")
                .empty-state Chua co rang buoc mon hoc phu hop

  include ../../partials/pagination

block modals
  #prereq-modal.modal-overlay(onclick="if(event.target===this)closePrereqModal()")
    .modal
      .modal-header
        h2#prereq-modal-title Them rang buoc
        button.modal-close(type="button" onclick="closePrereqModal()" aria-label="Dong") x
      .modal-body
        form#prereq-form
          .form-row
            .form-group
              label(for="prereq-course") Mon hoc
              select.form-control#prereq-course(required onchange="syncPrereqDisabled()")
                option(value="") Chon mon hoc
                each c in courses
                  option(value=c.MaMonHoc)= `${c.MaMonHoc} - ${c.TenMonHoc}`
            .form-group
              label(for="prereq-required-course") Mon dieu kien
              select.form-control#prereq-required-course(required onchange="syncPrereqDisabled()")
                option(value="") Chon mon dieu kien
                each c in courses
                  option(value=c.MaMonHoc)= `${c.MaMonHoc} - ${c.TenMonHoc}`
          .form-row
            .form-group
              label(for="prereq-type") Loai dieu kien
              select.form-control#prereq-type(required)
                option(value="tien_quyet") Tien quyet
                option(value="hoc_truoc") Hoc truoc
            .form-group
              label(for="prereq-status") Trang thai
              select.form-control#prereq-status
                option(value="true") Dang dung
                option(value="false") Tam khoa
          .form-group
            label(for="prereq-note") Mo ta
            textarea.form-control#prereq-note(rows="3")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closePrereqModal()") Huy
        button.btn.btn-primary(type="button" onclick="savePrereq()") Luu

  #prereq-graph-modal.modal-overlay(onclick="if(event.target===this)closePrereqGraph()")
    .modal.modal-wide
      .modal-header
        h2 So do dieu kien mon hoc
        button.modal-close(type="button" onclick="closePrereqGraph()" aria-label="Dong") x
      .modal-body
        pre#prereq-graph-content.mermaid graph TD

block scripts
  script(src="/js/admin/prerequisites.js")
