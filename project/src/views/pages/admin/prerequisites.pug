extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm mã hoặc tên môn học..." value=(search || '') onkeyup="debouncePrereqSearch()")
    .filter-group
      select.form-control#type-filter(onchange="applyPrereqFilters()")
        option(value="" selected=!filterType) Tất cả loại
        option(value="tien_quyet" selected=filterType === 'tien_quyet') Tiên quyết
        option(value="hoc_truoc" selected=filterType === 'hoc_truoc') Học trước
      button.btn.btn-primary(type="button" onclick="openPrereqModal('add')") Thêm ràng buộc
      a.btn.btn-outline(href="/admin/trash?entity=prerequisites") Thùng rác

  .card
    .card-header
      h3 Danh sách ràng buộc môn học
      span.card-count= prerequisites ? `${prerequisites.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Môn học
            th Môn điều kiện
            th Loại
            th Mô tả
            th Trạng thái
            th Sửa bởi
            th Sửa lúc
            th Thao tác
        tbody
          if prerequisites && prerequisites.length > 0
            each p in prerequisites
              - const course = p.MONHOC_DIEUKIENMONHOC_MaMonHocToMONHOC || {}
              - const requiredCourse = p.MONHOC_DIEUKIENMONHOC_MaMonDieuKienToMONHOC || {}
              tr
                td
                  strong= course.TenMonHoc || p.MaMonHoc
                  small.mono= p.MaMonHoc
                td
                  strong= requiredCourse.TenMonHoc || p.MaMonDieuKien
                  small.mono= p.MaMonDieuKien
                td
                  span.badge(class=p.LoaiDieuKien === 'tien_quyet' ? 'badge-primary' : 'badge-warning')= p.LoaiDieuKienLabel || p.LoaiDieuKien
                td= p.MoTa || '-'
                td
                  span.badge(class=p.TrangThai === false ? 'badge-secondary' : 'badge-success')= p.TrangThai === false ? 'Tạm khóa' : 'Đang dùng'
                td= p.NguoiCapNhatTen || p.NguoiCapNhat || '-'
                td= p.NgayCapNhat ? new Date(p.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(p) onclick="openPrereqModal('edit', JSON.parse(this.dataset.record))") Sửa
                  button.btn.btn-sm.btn-danger(type="button" onclick=`deletePrereq(${p.id})`) Xóa
          else
            tr
              td(colspan="8")
                .empty-state Chưa có ràng buộc môn học phù hợp

  include ../../partials/pagination

block modals
  #prereq-modal.modal-overlay(onclick="if(event.target===this)closePrereqModal()")
    .modal
      .modal-header
        h2#prereq-modal-title Thêm ràng buộc
        button.modal-close(type="button" onclick="closePrereqModal()" aria-label="Đóng") ×
      .modal-body
        form#prereq-form
          .form-row
            .form-group
              label(for="prereq-course") Môn học
              select.form-control#prereq-course(required)
                option(value="") Chọn môn học
                each c in courses
                  option(value=c.MaMonHoc)= `${c.MaMonHoc} - ${c.TenMonHoc}`
            .form-group
              label(for="prereq-required-course") Môn điều kiện
              select.form-control#prereq-required-course(required)
                option(value="") Chọn môn điều kiện
                each c in courses
                  option(value=c.MaMonHoc)= `${c.MaMonHoc} - ${c.TenMonHoc}`
          .form-row
            .form-group
              label(for="prereq-type") Loại điều kiện
              select.form-control#prereq-type(required)
                option(value="tien_quyet") Tiên quyết
                option(value="hoc_truoc") Học trước
            .form-group
              label(for="prereq-status") Trạng thái
              select.form-control#prereq-status
                option(value="true") Đang dùng
                option(value="false") Tạm khóa
          .form-group
            label(for="prereq-note") Mô tả
            textarea.form-control#prereq-note(rows="3")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closePrereqModal()") Hủy
        button.btn.btn-primary(type="button" onclick="savePrereq()") Lưu

block scripts
  script(src="/js/admin/prerequisites.js")
