extends ../../layouts/admin

block styles
  link(rel="stylesheet" href="/css/admin/course-tools.css")

block content
  .toolbar.admin-toolbar
    .search-box.search-with-scope.admin-search-group
      label.admin-search-label(for="prereq-search-field") Tìm theo
      select.form-control#prereq-search-field(onchange="applyPrereqFilters()" aria-label="Tiêu chí tìm kiếm")
        option(value="code" selected=((prereqSearchField || 'code') === 'code')) Mã môn
        option(value="courseName" selected=(prereqSearchField === 'courseName')) Tên môn học
        option(value="requiredName" selected=(prereqSearchField === 'requiredName')) Tên môn điều kiện
      input#search-input(type="text" placeholder="Nhập từ khóa ràng buộc..." value=(search || '') onkeyup="debouncePrereqSearch()")
    .filter-group.admin-filter-group
      select.form-control#type-filter(onchange="applyPrereqFilters()")
        option(value="" selected=!filterType) Tất cả loại
        option(value="tien_quyet" selected=filterType === 'tien_quyet') Tiên quyết
        option(value="hoc_truoc" selected=filterType === 'hoc_truoc') Học trước
    .admin-action-group
      button.btn.btn-primary(type="button" onclick="openPrereqModal('add')") Thêm ràng buộc
      a.btn.btn-outline(href="/admin/trash?entity=prerequisites") Thùng rác

  .card
    .card-header
      h3 Danh sách ràng buộc môn học
      span.card-count= prerequisites ? `${prerequisites.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Môn học
            th Môn điều kiện
            th Loại
            th Mô tả
            th Trạng thái
            th Sửa bởi
            th Sửa lúc
            th Thao tác
        tbody
          if prerequisites && prerequisites.length > 0
            each p in prerequisites
              - const course = p.MONHOC_DIEUKIENMONHOC_MaMonHocToMONHOC || {}
              - const requiredCourse = p.MONHOC_DIEUKIENMONHOC_MaMonDieuKienToMONHOC || {}
              tr.prereq-row.clickable-row(data-id=p.id onclick="openPrereqDetail(this.dataset.id)")
                td
                  strong= course.TenMonHoc || p.MaMonHoc
                  small.mono= p.MaMonHoc
                td
                  strong= requiredCourse.TenMonHoc || p.MaMonDieuKien
                  small.mono= p.MaMonDieuKien
                td
                  span.badge(class=p.LoaiDieuKien === 'tien_quyet' ? 'badge-primary' : 'badge-warning')= p.LoaiDieuKienLabel || p.LoaiDieuKien
                td= p.MoTa || '-'
                td
                  span.badge(class=p.TrangThai === false ? 'badge-secondary' : 'badge-success')= p.TrangThai === false ? 'Tạm khóa' : 'Đang dùng'
                td= p.NguoiCapNhatTen || p.NguoiCapNhat || '-'
                td= p.NgayCapNhat ? new Date(p.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.table-actions(onclick="event.stopPropagation()")
                  .table-action-list
                    button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(p) onclick="openPrereqModal('edit', JSON.parse(this.dataset.record))") Sửa
                    button.btn.btn-sm.btn-danger(type="button" onclick=`deletePrereq(${p.id})`) Xóa
          else
            tr
              td(colspan="8")
                .empty-state Chưa có ràng buộc môn học phù hợp

  include ../../partials/pagination

block modals
  #prereq-modal.modal-overlay(onclick="if(event.target===this)closePrereqModal()")
    .modal
      .modal-header
        h2#prereq-modal-title Thêm ràng buộc
        button.modal-close(type="button" onclick="closePrereqModal()" aria-label="Đóng") ×
      .modal-body
        form#prereq-form
          .form-row
            .form-group
              label(for="prereq-course") Môn học
              input#prereq-course(type="hidden" required)
              .course-picker-control
                .course-picker-summary#prereq-course-summary
                  strong Chưa chọn môn học
                  small Tìm theo mã hoặc tên môn học
                button.btn.btn-outline(type="button" onclick="openPrereqCoursePicker('course')") Chọn môn
            .form-group
              label(for="prereq-required-course") Môn điều kiện
              input#prereq-required-course(type="hidden" required)
              .course-picker-control
                .course-picker-summary#prereq-required-summary
                  strong Chưa chọn môn điều kiện
                  small Tìm theo mã hoặc tên môn học
                button.btn.btn-outline(type="button" onclick="openPrereqCoursePicker('required')") Chọn môn
          .form-row
            .form-group
              label(for="prereq-type") Loại điều kiện
              select.form-control#prereq-type(required)
                option(value="tien_quyet") Tiên quyết
                option(value="hoc_truoc") Học trước
            .form-group
              label(for="prereq-status") Trạng thái
              select.form-control#prereq-status
                option(value="true") Đang dùng
                option(value="false") Tạm khóa
          .form-group
            label(for="prereq-note") Mô tả
            textarea.form-control#prereq-note(rows="3")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closePrereqModal()") Hủy
        button.btn.btn-primary(type="button" onclick="savePrereq()") Lưu

  #prereq-course-picker-modal.modal-overlay(onclick="if(event.target===this)closePrereqCoursePicker()")
    .modal.modal-wide.lookup-modal
      .modal-header
        h2#prereq-picker-title Chọn môn học
        button.modal-close(type="button" onclick="closePrereqCoursePicker()" aria-label="Đóng") ×
      .modal-body
        .lookup-search-row
          input.form-control#prereq-course-picker-search(type="text" placeholder="Nhập mã hoặc tên môn học" onkeyup="debouncePrereqCoursePickerSearch()")
          button.btn.btn-outline(type="button" onclick="loadPrereqCoursePickerResults()") Tìm
        .table-container.lookup-table-container
          table.data-table.lookup-table
            thead
              tr
                th Mã môn
                th Tên môn học
                th Loại
                th Khoa
                th Chọn
            tbody#prereq-course-picker-results
              tr
                td(colspan="5")
                  .empty-state Nhập từ khóa để tìm môn học

  #prereq-detail-modal.modal-overlay(onclick="if(event.target===this)closePrereqDetail()")
    .modal.modal-wide
      .modal-header
        h2 Chi tiết ràng buộc môn học
        button.modal-close(type="button" onclick="closePrereqDetail()" aria-label="Đóng") ×
      .modal-body#prereq-detail-content Đang tải...

block scripts
  script(src="/js/admin/prerequisites.js")
