extends ../../layouts/admin

block content
  .page-shell
    .page-heading
      .page-kicker Quản trị tổng quan
      h2 Đăng ký môn học, học phí và công nợ
      p Theo dõi nhanh số liệu chính, doanh thu và sinh viên còn nợ học phí.

    .stats-grid
      .stat-card
        .stat-icon.blue.material-symbols-rounded groups
        .stat-info
          h3#stat-students --
          p Sinh viên
      .stat-card
        .stat-icon.green.material-symbols-rounded menu_book
        .stat-info
          h3#stat-courses --
          p Môn học
      .stat-card
        .stat-icon.blue.material-symbols-rounded meeting_room
        .stat-info
          h3#stat-opened-classes --
          p Lớp mở
      .stat-card
        .stat-icon.orange.material-symbols-rounded app_registration
        .stat-info
          h3#stat-registrations --
          p Lượt đăng ký
      .stat-card
        .stat-icon.purple.material-symbols-rounded payments
        .stat-info
          h3#stat-revenue --
          p Doanh thu đã thu

    .content-grid.two-columns
      .card
        .card-header
          h3 Doanh thu theo tháng
        .card-body
          canvas#dashboard-revenue-chart(height="180")
      .card
        .card-header
          h3 Đăng ký theo học kỳ
        .card-body
          canvas#dashboard-registration-chart(height="180")

    .content-grid.two-columns
      .card
        .card-header
          h3 Top sinh viên nợ học phí
        .table-container
          table.data-table
            thead
              tr
                th MSSV
                th Họ tên
                th Học kỳ
                th Còn nợ
            tbody#dashboard-debt-table
              tr
                td(colspan="4")
                  .empty-state Đang tải dữ liệu...
      .card
        .card-header
          h3 Hoạt động gần đây
        .card-body#dashboard-activity-list
          .empty-state Đang tải dữ liệu...

block scripts
  script(src="https://cdn.jsdelivr.net/npm/chart.js")
  script(src="/js/admin/dashboard.js")
