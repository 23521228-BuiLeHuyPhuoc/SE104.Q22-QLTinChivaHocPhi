extends ../../layouts/admin

block content
  .toolbar.admin-toolbar
    .search-box.admin-search-group
      input#trash-search(type="text" placeholder="Tìm mã hoặc tên đã xóa..." onkeydown="runSearchOnEnter(event, debounceTrashSearch)")
    .filter-group.admin-filter-group
      select#trash-entity(onchange="loadTrash(1)")
        if entities && entities.length
          each entity in entities
            option(value=entity.key)= entity.label
    .admin-action-group
      button.btn.btn-secondary(type="button" onclick="loadTrash(1)") Làm mới
      button.btn.btn-outline#trash-restore-selected(type="button" onclick="restoreSelectedTrash()" disabled) Khôi phục đã chọn
      button.btn.btn-danger#trash-purge-selected(type="button" onclick="purgeSelectedTrash()" disabled) Xóa vĩnh viễn đã chọn

  .card
    .card-header
      h3 Thùng rác
      span.card-count#trash-count 0 bản ghi
    .table-container
      table.data-table
        thead
          tr
            th
              input#trash-select-all(type="checkbox" onchange="toggleAllTrashRows(this)")
            th Loại dữ liệu
            th Khóa chính
            th Tên hiển thị
            th Người xóa
            th Thời điểm xóa
            th Thao tác
        tbody#trash-body
          tr
            td(colspan="7")
              .empty-state Đang tải dữ liệu...

  nav.pagination#trash-pagination(style="display:none")

block scripts
  script(src="/js/admin/trash.js")
