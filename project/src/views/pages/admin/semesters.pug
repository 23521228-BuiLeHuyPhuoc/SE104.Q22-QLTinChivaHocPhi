extends ../../layouts/admin

block content
  .toolbar
    .toolbar-title
      h2.page-title Quản lý học kỳ
      p Cấu hình kỳ học, thời gian đăng ký và hạn đóng học phí.
    .filter-group
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm học kỳ

  .card
    .card-header
      h3 Danh sách học kỳ
      span.card-count= semesters ? `${semesters.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Mã học kỳ
            th Tên học kỳ
            th Năm học
            th Bắt đầu
            th Kết thúc
            th Hạn học phí
            th Trạng thái
            th Sửa bởi
            th Sửa lúc
            th Thao tác
        tbody
          if semesters && semesters.length > 0
            each s in semesters
              tr
                td.mono= s.MaHocKy
                td= s.TenHocKy
                td= s.NAMHOC ? s.NAMHOC.TenNamHoc : s.MaNamHoc
                td= s.NgayBatDau ? new Date(s.NgayBatDau).toLocaleDateString('vi-VN') : '-'
                td= s.NgayKetThuc ? new Date(s.NgayKetThuc).toLocaleDateString('vi-VN') : '-'
                td= s.HanDongHocPhi ? new Date(s.HanDongHocPhi).toLocaleDateString('vi-VN') : '-'
                td
                  span.badge(class=s.TrangThai === 'Đang diễn ra' ? 'badge-success' : s.TrangThai === 'Sắp diễn ra' || s.TrangThai === 'Sắp tới' ? 'badge-warning' : 'badge-secondary')= s.TrangThai || '-'
                td= s.NguoiCapNhat || '-'
                td= s.NgayCapNhat ? new Date(s.NgayCapNhat).toLocaleDateString('vi-VN') : '-'
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(s) onclick="openModal('edit', JSON.parse(this.dataset.record))") Sửa
                  button.btn.btn-sm.btn-danger(type="button" onclick=`deleteSemester('${s.MaHocKy}')`) Xóa
          else
            tr
              td(colspan="10")
                .empty-state Chưa có học kỳ

  include ../../partials/pagination

block modals
  #semester-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm học kỳ
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#semester-form
          .form-row
            .form-group
              label(for="hk-ma") Mã học kỳ
              input.form-control#hk-ma(type="text" required placeholder="VD: HK1-2025")
            .form-group
              label(for="hk-ten") Tên học kỳ
              input.form-control#hk-ten(type="text" required placeholder="VD: Học kỳ 1")
          .form-row
            .form-group
              label(for="hk-manamhoc") Mã năm học
              input.form-control#hk-manamhoc(type="text" required placeholder="VD: 2025-2026")
            .form-group
              label(for="hk-loai") Loại học kỳ
              select.form-control#hk-loai
                option(value="Chính") Chính
                option(value="Hè") Hè
          .form-row
            .form-group
              label(for="hk-thutu") Thứ tự
              input.form-control#hk-thutu(type="number" min="1" value="1")
            .form-group
              label(for="hk-trangthai") Trạng thái
              select.form-control#hk-trangthai
                option(value="Sắp diễn ra") Sắp diễn ra
                option(value="Đang diễn ra") Đang diễn ra
                option(value="Đã kết thúc") Đã kết thúc
          .form-row
            .form-group
              label(for="hk-batdau") Ngày bắt đầu
              input.form-control#hk-batdau(type="date")
            .form-group
              label(for="hk-ketthuc") Ngày kết thúc
              input.form-control#hk-ketthuc(type="date")
          .form-group
            label(for="hk-hanhocphi") Hạn đóng học phí
            input.form-control#hk-hanhocphi(type="date")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveSemester()") Lưu

block scripts
  script(src="/js/admin/semesters.js")
