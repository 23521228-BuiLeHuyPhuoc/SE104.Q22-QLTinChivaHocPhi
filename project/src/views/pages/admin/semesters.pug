extends ../../layouts/admin

block content
  .toolbar
    .toolbar-title
      h2.page-title Quản lý học kỳ
      p Cấu hình kỳ học, thời gian đăng ký và hạn đóng học phí.
    .filter-group
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm học kỳ
      a.btn.btn-outline(href="/admin/trash?entity=semesters") Thùng rác

  .card
    .card-header
      h3 Danh sách học kỳ
      span.card-count= semesters ? `${semesters.length} bản ghi` : '0 bản ghi'
    .semester-list
      .semester-list-header
        span Học kỳ
        span Mốc thời gian
        span Trạng thái
        span Cập nhật
        span Thao tác
      if semesters && semesters.length > 0
        each s in semesters
          .semester-list-row
            .semester-identity
              .semester-meta
                .semester-field
                  span.semester-field-label Mã
                  span.semester-field-value.mono= s.MaHocKy
                .semester-field
                  span.semester-field-label Tên học kỳ
                  span.semester-field-value= s.TenHocKy
                .semester-field
                  span.semester-field-label Năm học
                  span.semester-field-value= s.NAMHOC ? s.NAMHOC.TenNamHoc : s.MaNamHoc
                .semester-field
                  span.semester-field-label Loại
                  span.semester-field-value= s.LoaiHocKy || '-'
            .semester-date-grid
              .semester-field
                span.semester-field-label Bắt đầu kỳ
                span.semester-field-value= s.NgayBatDau ? new Date(s.NgayBatDau).toLocaleDateString('vi-VN') : '-'
              .semester-field
                span.semester-field-label Kết thúc kỳ
                span.semester-field-value= s.NgayKetThuc ? new Date(s.NgayKetThuc).toLocaleDateString('vi-VN') : '-'
              .semester-field
                span.semester-field-label Bắt đầu đăng ký
                span.semester-field-value= s.NgayBatDauDangKy ? new Date(s.NgayBatDauDangKy).toLocaleDateString('vi-VN') : '-'
              .semester-field
                span.semester-field-label Hạn đăng ký
                span.semester-field-value= s.NgayKetThucDangKy ? new Date(s.NgayKetThucDangKy).toLocaleDateString('vi-VN') : '-'
              .semester-field.semester-field-wide
                span.semester-field-label Hạn học phí
                span.semester-field-value= s.HanDongHocPhi ? new Date(s.HanDongHocPhi).toLocaleDateString('vi-VN') : '-'
            .semester-state
              - const semesterStatus = s.TrangThai || '-'
              - const semesterBadge = semesterStatus === 'Đang diễn ra' ? 'badge-success' : (semesterStatus === 'Sắp diễn ra' || semesterStatus === 'Sắp tới') ? 'badge-warning' : 'badge-secondary'
              span.badge(class=semesterBadge)= semesterStatus
              .semester-metrics
                .semester-metric
                  span.semester-metric-value= s.SoLopMo || 0
                  span.semester-metric-label Lớp mở
                .semester-metric
                  span.semester-metric-value= s.SoSinhVienDangKy || 0
                  span.semester-metric-label Sinh viên đăng ký
            .semester-update
              .semester-field
                span.semester-field-label Người sửa
                span.semester-field-value= s.NguoiCapNhatTen || s.NguoiCapNhat || '-'
              .semester-field
                span.semester-field-label Thời điểm sửa
                span.semester-field-value= s.NgayCapNhat ? new Date(s.NgayCapNhat).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }) : '-'
            .semester-actions
              button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(s) onclick="openModal('edit', JSON.parse(this.dataset.record))") Sửa
              button.btn.btn-sm.btn-danger(type="button" onclick=`deleteSemester('${s.MaHocKy}')`) Xóa
      else
        .empty-state Chưa có học kỳ

  include ../../partials/pagination

block modals
  #semester-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm học kỳ
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#semester-form
          .form-row
            .form-group
              label(for="hk-ma") Mã học kỳ
              input.form-control#hk-ma(type="text" required placeholder="VD: HK1-2025")
            .form-group
              label(for="hk-ten") Tên học kỳ
              input.form-control#hk-ten(type="text" required placeholder="VD: Học kỳ 1")
          .form-row
            .form-group
              label(for="hk-manamhoc") Năm học
              select.form-control#hk-manamhoc(required)
                option(value="") Đang tải năm học...
            .form-group
              label(for="hk-loai") Loại học kỳ
              select.form-control#hk-loai
                option(value="Chính") Chính
                option(value="Hè") Hè
          input#hk-thutu(type="hidden" value="1")
          .form-group
            label(for="hk-trangthai") Trạng thái
            select.form-control#hk-trangthai
              option(value="Sắp diễn ra") Sắp diễn ra
              option(value="Đang diễn ra") Đang diễn ra
              option(value="Đã kết thúc") Đã kết thúc
          .form-row
            .form-group
              label(for="hk-batdau") Ngày bắt đầu kỳ
              input.form-control#hk-batdau(type="date" aria-describedby="hk-term-date-error")
            .form-group
              label(for="hk-ketthuc") Ngày kết thúc kỳ
              input.form-control#hk-ketthuc(type="date" aria-describedby="hk-term-date-error")
              small.field-error#hk-term-date-error(aria-live="polite")
          .form-row
            .form-group
              label(for="hk-batdaudk") Bắt đầu đăng ký
              input.form-control#hk-batdaudk(type="date" aria-describedby="hk-registration-date-error")
            .form-group
              label(for="hk-ketthucdk") Hạn kết thúc đăng ký
              input.form-control#hk-ketthucdk(type="date" aria-describedby="hk-registration-date-error")
              small.field-error#hk-registration-date-error(aria-live="polite")
          .form-group
            label(for="hk-hanhocphi") Hạn đóng học phí
            input.form-control#hk-hanhocphi(type="date")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveSemester()") Lưu

block scripts
  script(src="/js/admin/semesters.js")
