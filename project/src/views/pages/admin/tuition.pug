extends ../../layouts/admin

block content
  - const money = (value) => Number(value || 0).toLocaleString('vi-VN') + ' đ'
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm MSSV hoặc họ tên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(!status)) Tất cả trạng thái
        option(value="unpaid" selected=(status === 'unpaid')) Chưa đóng
        option(value="partial" selected=(status === 'partial')) Đóng một phần
        option(value="overdue" selected=(status === 'overdue')) Quá hạn
        option(value="paid" selected=(status === 'paid')) Đã đóng đủ

  .card
    .card-header
      h3 Công nợ học phí
      span.card-count= tuitions ? `${tuitions.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Họ tên
            th Học kỳ
            th Tín chỉ
            th Loại học
            th Tổng phải đóng
            th Đã đóng
            th Còn nợ
            th Hạn đóng
            th Trạng thái
        tbody
          if tuitions && tuitions.length > 0
            each t in tuitions
              - const badge = t.TrangThaiHocPhi === 'Đã đóng đủ' ? 'badge-success' : t.TrangThaiHocPhi === 'Đóng một phần' ? 'badge-warning' : 'badge-error'
              tr
                td.mono= t.MaSv
                td= t.HoTen || '-'
                td= t.TenHocKy || t.MaHocKy || '-'
                td= t.TongTinChi || 0
                td
                  if Number(t.SoMonHocMoi || 0) > 0
                    span.badge.badge-success= 'Mới ' + t.SoMonHocMoi
                  if Number(t.SoMonHocLai || 0) > 0
                    span.badge.badge-warning= 'Lại ' + t.SoMonHocLai
                  if Number(t.SoMonHocCaiThien || 0) > 0
                    span.badge.badge-info= 'Cải thiện ' + t.SoMonHocCaiThien
                td.currency= money(t.TongTienPhaiDong)
                td.currency= money(t.TongTienDaDong)
                td.currency(class=(Number(t.ConNo || 0) > 0 ? 'text-danger' : 'text-success'))= money(t.ConNo)
                td= t.HanDongHocPhi ? new Date(t.HanDongHocPhi).toLocaleDateString('vi-VN') : '-'
                td
                  span.badge(class=badge)= t.TrangThaiHocPhi
          else
            tr
              td(colspan="10")
                .empty-state Không có dữ liệu học phí

  include ../../partials/pagination

block scripts
  script(src="/js/admin/tuition.js")
