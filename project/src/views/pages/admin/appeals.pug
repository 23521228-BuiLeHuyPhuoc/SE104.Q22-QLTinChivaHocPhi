extends ../../layouts/admin

block styles
  link(rel="stylesheet" href="/css/admin/registrations.css")

block content
  - const appealSearchPlaceholders = { studentId: 'Nhập MSSV', studentName: 'Nhập họ tên sinh viên', classCode: 'Nhập mã lớp cần thêm/hủy', courseName: 'Nhập tên môn học', semester: 'Nhập mã học kỳ, tên học kỳ hoặc năm học', reason: 'Nhập nội dung lý do' }
  .toolbar
    .toolbar-title
      h2.page-title Đơn cứu xét đăng ký
      p Duyệt hoặc từ chối yêu cầu thêm, hủy, đổi học phần sau hạn đăng ký.

  form.registration-filter-panel#appeal-filter(onsubmit="event.preventDefault(); loadAppeals(1)")
    .registration-search-row
      .registration-filter-field.registration-search-scope
        label(for="appeal-search-scope") Tìm theo
        select.form-control#appeal-search-scope(onchange="updateAppealSearchPlaceholder(); loadAppeals(1)")
          option(value="studentId" data-placeholder=appealSearchPlaceholders.studentId) MSSV
          option(value="studentName" data-placeholder=appealSearchPlaceholders.studentName) Họ tên
          option(value="classCode" data-placeholder=appealSearchPlaceholders.classCode) Lớp
          option(value="courseName" data-placeholder=appealSearchPlaceholders.courseName) Môn học
          option(value="semester" data-placeholder=appealSearchPlaceholders.semester) Học kỳ
          option(value="reason" data-placeholder=appealSearchPlaceholders.reason) Lý do
      .registration-filter-field.registration-search-keyword
        label(for="appeal-search-input") Từ khóa tìm kiếm
        .search-box.registration-search-box
          input#appeal-search-input(type="text" placeholder=appealSearchPlaceholders.studentId autocomplete="off" onkeydown="runSearchOnEnter(event, debounceAppealSearch)")
    .registration-filter-row
      .registration-filter-field
        label(for="appeal-semester") Học kỳ
        select.form-control#appeal-semester(onchange="loadAppeals(1)")
          option(value="") Tất cả học kỳ
          if semesterActivityOptions && semesterActivityOptions.length
            each semester in semesterActivityOptions
              option(value=semester.MaHocKy selected=(selectedAppealSemester === semester.MaHocKy) data-activity=JSON.stringify(semester))= semester.label
      .registration-filter-field
        label(for="appeal-type") Loại đơn
        select.form-control#appeal-type(onchange="loadAppeals(1)")
          option(value="") Tất cả loại đơn
          option(value="them") Thêm
          option(value="huy") Hủy
          option(value="doi") Đổi
      .registration-filter-field
        label(for="appeal-status") Trạng thái
        select.form-control#appeal-status(onchange="loadAppeals(1)")
          option(value="") Tất cả trạng thái
          option(value="cho_duyet") Chờ duyệt
          option(value="da_duyet") Đã duyệt
          option(value="tu_choi") Từ chối
          option(value="da_huy") Đã hủy
      .registration-filter-actions
        button.btn.btn-outline(type="submit")
          span.material-symbols-rounded(aria-hidden="true") search
          span Tìm kiếm
        button.btn.btn-outline(type="button" onclick="resetAppealFilters()")
          span.material-symbols-rounded(aria-hidden="true") restart_alt
          span Xóa lọc

  .activity-window-panel#appeal-activity-panel
    .activity-window-main
      .activity-window-title
        span.material-symbols-rounded(aria-hidden="true") rule
        div
          h3 Thời gian cứu xét đăng ký
          p#appeal-activity-semester Chọn học kỳ để xem thời hạn cứu xét
      span.badge.badge-secondary#appeal-window-badge Chưa chọn
    .activity-window-grid
      .activity-window-item
        span Bắt đầu
        strong#appeal-window-start -
      .activity-window-item
        span Kết thúc
        strong#appeal-window-end -
      .activity-window-item
        span Đơn chờ duyệt
        strong#appeal-pending-appeals -

  .card
    .card-header
      h3 Danh sách đơn cứu xét
      span.card-count#appeal-count 0 bản ghi
    .table-container
      table.data-table
        thead
          tr
            th Mã đơn
            th Sinh viên
            th Học kỳ
            th Loại đơn
            th Nội dung
            th Lý do
            th Trạng thái
            th Thao tác
        tbody#appeal-table-body
          tr
            td(colspan="8")
              .empty-state Đang tải đơn cứu xét...
  nav.pagination#appeal-pagination(style="display:none")

block scripts
  script(src="/js/admin/appeals.js")
