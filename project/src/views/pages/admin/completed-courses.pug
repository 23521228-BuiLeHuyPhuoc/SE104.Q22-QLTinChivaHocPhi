extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tim MSSV, mon hoc, khoa, lop, giang vien..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-hocky(onchange="applyFilters()")
        option(value="" selected=(!filterHocKy)) Tat ca hoc ky
        if semesters && semesters.length > 0
          each s in semesters
            option(value=s.MaHocKy selected=(filterHocKy === s.MaHocKy))= s.TenHocKy
      select#filter-result(onchange="applyFilters()")
        option(value="" selected=(!filterResult)) Tat ca ket qua
        option(value="qua_mon" selected=(filterResult === 'qua_mon')) Qua mon
        option(value="rot" selected=(filterResult === 'rot')) Rot
      select#filter-khoa(onchange="applyFilters()")
        option(value="" selected=(!filterKhoa)) Tat ca khoa
        if faculties && faculties.length > 0
          each k in faculties
            option(value=k.MaKhoa selected=(filterKhoa === k.MaKhoa))= k.TenKhoa
      select#filter-loai(onchange="applyFilters()")
        option(value="" selected=(!filterLoaiMon)) Tat ca loai
        option(value="LT" selected=(filterLoaiMon === 'LT')) LT
        option(value="TH" selected=(filterLoaiMon === 'TH')) TH
      select#filter-tinchi(onchange="applyFilters()")
        option(value="" selected=(!filterTinChi)) Tat ca TC
        each tc in [1,2,3,4,5,6]
          option(value=tc selected=(String(filterTinChi) === String(tc)))= `${tc} TC`
      button.btn.btn-outline(type="button" onclick="openImportModal()") Nhap Excel
      button.btn.btn-outline(type="button" onclick="openClassGradeModal()") Nhap theo lop
      button.btn.btn-primary(type="button" onclick="openModal('add')") Them mon da hoc
      a.btn.btn-outline(href="/admin/trash?entity=completedCourses") Thung rac

  .card
    .card-header
      h3 Sinh vien co mon da hoc
      span.card-count= completedStudents ? `${completedStudents.length} sinh vien` : '0 sinh vien'
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Ho ten
            th So luot hoc
            th Qua mon
            th Rot
            th Tin chi tich luy
            th Cap nhat gan nhat
            th Sua boi
            th Thao tac
        tbody
          if completedStudents && completedStudents.length > 0
            each s in completedStudents
              tr
                td.mono= s.MaSv
                td= s.HoTen || '-'
                td= s.totalAttempts || 0
                td
                  span.badge.badge-success= s.passedCount || 0
                td
                  span.badge.badge-error= s.failedCount || 0
                td= s.passedCredits || 0
                td= s.NgayCapNhatGanNhat ? new Date(s.NgayCapNhatGanNhat).toLocaleDateString('vi-VN') : '-'
                td= s.NguoiCapNhatTen || '-'
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" data-ma-sv=s.MaSv onclick="openCompletedCourseDetail(this.dataset.maSv)") Xem
          else
            tr
              td(colspan="9")
                .empty-state Chua co sinh vien nao co mon da hoc

  include ../../partials/pagination

block modals
  #completed-course-detail-modal.modal-overlay(onclick="if(event.target===this)closeCompletedCourseDetail()")
    .modal.modal-wide
      .modal-header
        h3 Chi tiet mon da hoc
        button.modal-close(type="button" onclick="closeCompletedCourseDetail()") x
      .modal-body
        #completed-course-detail-content Dang tai...

  #completed-course-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Them mon da hoc
        button.modal-close(type="button" onclick="closeModal()") x
      .modal-body
        form#completed-course-form
          .form-row
            .form-group
              label(for="cc-masv") MSSV
              input.form-control#cc-masv(type="text" required placeholder="VD: 23521228")
            .form-group
              label(for="cc-mamonhoc") Mon hoc
              input.form-control#cc-mamonhoc(type="text" list="course-options" required placeholder="VD: IT001")
              datalist#course-options
                if courses && courses.length > 0
                  each c in courses
                    option(value=c.MaMonHoc)= c.TenMonHoc
          .form-row
            .form-group
              label(for="cc-mahocky") Hoc ky
              select.form-control#cc-mahocky(required)
                option(value="") Chon hoc ky
                if semesters && semesters.length > 0
                  each s in semesters
                    option(value=s.MaHocKy)= s.TenHocKy
            .form-group
              label(for="cc-malop") Lop
              input.form-control#cc-malop(type="text" list="class-options" placeholder="VD: IT001.N01")
              datalist#class-options
                if classes && classes.length > 0
                  each l in classes
                    option(value=l.MaLop)= l.TenLop
          .form-row
            .form-group
              label(for="cc-lanhoc") Lan hoc
              input.form-control#cc-lanhoc(type="number" min="1" value="1")
            .form-group
              label(for="cc-ketqua") Ket qua
              select.form-control#cc-ketqua(required)
                option(value="qua_mon") Qua mon
                option(value="rot") Rot
          .form-group
            label(for="cc-ghichu") Ghi chu
            textarea.form-control#cc-ghichu(rows="2")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Huy
        button.btn.btn-primary(type="button" onclick="saveCompletedCourse()") Luu

  #import-modal.modal-overlay(onclick="if(event.target===this)closeImportModal()")
    .modal.modal-wide
      .modal-header
        h2 Nhap Excel
        button.modal-close(type="button" onclick="closeImportModal()") x
      .modal-body
        input#import-file.form-control(type="file" accept=".csv,.tsv,.txt,.xls,.xlsx")
        .table-container.mt-3
          table.data-table
            thead
              tr
                th MSSV
                th MaMonHoc
                th HocKy
                th KetQua
                th Trang thai
            tbody#import-preview
              tr
                td(colspan="5")
                  .empty-state Chon file CSV/TSV tu Excel de xem truoc
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeImportModal()") Huy
        button.btn.btn-primary(type="button" onclick="confirmImport()") Xac nhan import

  #class-grade-modal.modal-overlay(onclick="if(event.target===this)closeClassGradeModal()")
    .modal.modal-wide
      .modal-header
        h2 Nhap diem theo lop
        button.modal-close(type="button" onclick="closeClassGradeModal()") x
      .modal-body
        .form-row
          .form-group
            label(for="bulk-class") Lop
            select.form-control#bulk-class
              option(value="") Chon lop
              if classes && classes.length > 0
                each l in classes
                  option(value=l.MaLop)= `${l.MaLop} - ${l.TenLop}`
          .form-group
            label(for="bulk-semester") Hoc ky
            select.form-control#bulk-semester
              option(value="") Chon hoc ky
              if semesters && semesters.length > 0
                each s in semesters
                  option(value=s.MaHocKy)= s.TenHocKy
          .form-group
            label &nbsp;
            button.btn.btn-outline(type="button" onclick="loadClassRoster()") Tai danh sach
        .table-container.mt-3
          table.data-table
            thead
              tr
                th MSSV
                th Ho ten
                th Mon
                th Ket qua
            tbody#class-roster
              tr
                td(colspan="4")
                  .empty-state Chua tai danh sach
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeClassGradeModal()") Huy
        button.btn.btn-primary(type="button" onclick="saveClassGrades()") Luu dong loat

block scripts
  script(src="/js/admin/completed-courses.js")
