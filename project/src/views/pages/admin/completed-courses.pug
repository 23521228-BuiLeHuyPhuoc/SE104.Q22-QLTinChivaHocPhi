extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm MSSV, môn học, khoa, lớp, giảng viên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-hocky(onchange="applyFilters()")
        option(value="" selected=(!filterHocKy)) Tất cả học kỳ
        if semesters && semesters.length > 0
          each s in semesters
            option(value=s.MaHocKy selected=(filterHocKy === s.MaHocKy))= s.TenHocKy
      select#filter-result(onchange="applyFilters()")
        option(value="" selected=(!filterResult)) Tất cả kết quả
        option(value="qua_mon" selected=(filterResult === 'qua_mon')) Qua môn
        option(value="rot" selected=(filterResult === 'rot')) Rớt
      select#filter-khoa(onchange="applyFilters()")
        option(value="" selected=(!filterKhoa)) Tất cả khoa
        if faculties && faculties.length > 0
          each k in faculties
            option(value=k.MaKhoa selected=(filterKhoa === k.MaKhoa))= k.TenKhoa
      select#filter-loai(onchange="applyFilters()")
        option(value="" selected=(!filterLoaiMon)) Tất cả loại
        option(value="LT" selected=(filterLoaiMon === 'LT')) LT
        option(value="TH" selected=(filterLoaiMon === 'TH')) TH
      select#filter-tinchi(onchange="applyFilters()")
        option(value="" selected=(!filterTinChi)) Tất cả TC
        each tc in [1,2,3,4,5,6]
          option(value=tc selected=(String(filterTinChi) === String(tc)))= `${tc} TC`
      button.btn.btn-outline(type="button" onclick="openImportModal()") Nhập Excel
      button.btn.btn-outline(type="button" onclick="openClassGradeModal()") Nhập theo lớp
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm môn đã học
      a.btn.btn-outline(href="/admin/trash?entity=completedCourses") Thùng rác

  .card
    .card-header
      h3 Sinh viên có môn đã học
      span.card-count= completedStudents ? `${completedStudents.length} sinh viên` : '0 sinh viên'
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Họ tên
            th Số lượt học
            th Qua môn
            th Rớt
            th Tín chỉ tích lũy
            th Cập nhật gần nhất
            th Sửa bởi
            th Thao tác
        tbody
          if completedStudents && completedStudents.length > 0
            each s in completedStudents
              tr
                td.mono= s.MaSv
                td= s.HoTen || '-'
                td= s.totalAttempts || 0
                td
                  span.badge.badge-success= s.passedCount || 0
                td
                  span.badge.badge-error= s.failedCount || 0
                td= s.passedCredits || 0
                td= s.NgayCapNhatGanNhat ? new Date(s.NgayCapNhatGanNhat).toLocaleDateString('vi-VN') : '-'
                td= s.NguoiCapNhatTen || '-'
                td.table-actions
                  button.btn.btn-sm.btn-outline(type="button" data-ma-sv=s.MaSv onclick="openCompletedCourseDetail(this.dataset.maSv)") Xem
          else
            tr
              td(colspan="9")
                .empty-state Chưa có sinh viên nào có môn đã học

  include ../../partials/pagination

block modals
  #completed-course-detail-modal.modal-overlay(onclick="if(event.target===this)closeCompletedCourseDetail()")
    .modal.modal-wide
      .modal-header
        h3 Chi tiết môn đã học
        button.modal-close(type="button" onclick="closeCompletedCourseDetail()") x
      .modal-body
        #completed-course-detail-content Đang tải...

  #completed-course-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm môn đã học
        button.modal-close(type="button" onclick="closeModal()") x
      .modal-body
        form#completed-course-form
          .form-row
            .form-group
              label(for="cc-masv") MSSV
              input.form-control#cc-masv(type="text" required placeholder="VD: 23521228")
            .form-group
              label(for="cc-mamonhoc") Môn học
              input.form-control#cc-mamonhoc(type="text" list="course-options" required placeholder="VD: IT001")
              datalist#course-options
                if courses && courses.length > 0
                  each c in courses
                    option(value=c.MaMonHoc)= c.TenMonHoc
          .form-row
            .form-group
              label(for="cc-mahocky") Học kỳ
              select.form-control#cc-mahocky(required)
                option(value="") Chọn học kỳ
                if semesters && semesters.length > 0
                  each s in semesters
                    option(value=s.MaHocKy)= s.TenHocKy
            .form-group
              label(for="cc-malop") Lớp
              input.form-control#cc-malop(type="text" list="class-options" placeholder="VD: IT001.N01")
              datalist#class-options
                if classes && classes.length > 0
                  each l in classes
                    option(value=l.MaLop)= l.TenLop
          .form-row
            .form-group
              label(for="cc-lanhoc") Lần học
              input.form-control#cc-lanhoc(type="number" min="1" value="1")
            .form-group
              label(for="cc-ketqua") Kết quả
              select.form-control#cc-ketqua(required)
                option(value="qua_mon") Qua môn
                option(value="rot") Rớt
          .form-group
            label(for="cc-ghichu") Ghi chú
            textarea.form-control#cc-ghichu(rows="2")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveCompletedCourse()") Lưu

  #import-modal.modal-overlay(onclick="if(event.target===this)closeImportModal()")
    .modal.modal-wide
      .modal-header
        h2 Nhập Excel
        button.modal-close(type="button" onclick="closeImportModal()") x
      .modal-body
        input#import-file.form-control(type="file" accept=".csv,.tsv,.txt,.xls,.xlsx")
        .table-container.mt-3
          table.data-table
            thead
              tr
                th MSSV
                th MaMonHoc
                th HocKy
                th KetQua
                th Trạng thái
            tbody#import-preview
              tr
                td(colspan="5")
                  .empty-state Chọn file CSV/TSV từ Excel để xem trước
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeImportModal()") Hủy
        button.btn.btn-primary(type="button" onclick="confirmImport()") Xác nhận import

  #class-grade-modal.modal-overlay(onclick="if(event.target===this)closeClassGradeModal()")
    .modal.modal-wide
      .modal-header
        h2 Nhập điểm theo lớp
        button.modal-close(type="button" onclick="closeClassGradeModal()") x
      .modal-body
        .form-row
          .form-group
            label(for="bulk-class") Lớp
            select.form-control#bulk-class
              option(value="") Chọn lớp
              if classes && classes.length > 0
                each l in classes
                  option(value=l.MaLop)= `${l.MaLop} - ${l.TenLop}`
          .form-group
            label(for="bulk-semester") Học kỳ
            select.form-control#bulk-semester
              option(value="") Chọn học kỳ
              if semesters && semesters.length > 0
                each s in semesters
                  option(value=s.MaHocKy)= s.TenHocKy
          .form-group
            label &nbsp;
            button.btn.btn-outline(type="button" onclick="loadClassRoster()") Tải danh sách
        .table-container.mt-3
          table.data-table
            thead
              tr
                th MSSV
                th Họ tên
                th Môn
                th Kết quả
            tbody#class-roster
              tr
                td(colspan="4")
                  .empty-state Chưa tải danh sách
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeClassGradeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveClassGrades()") Lưu đồng loạt

block scripts
  script(src="/js/admin/completed-courses.js")
