extends ../../layouts/admin

block styles
  link(rel="stylesheet" href="/css/admin/course-tools.css")

block content
  .toolbar.admin-toolbar
    - const completedSearchField = searchField || 'MaSv'
    select.form-control#search-field(onchange="applyFilters()")
      option(value="MaSv" selected=(completedSearchField === 'MaSv')) MSSV
      option(value="HoTen" selected=(completedSearchField === 'HoTen')) Họ tên
      option(value="MaHocKy" selected=(completedSearchField === 'MaHocKy')) Học kỳ
    .search-box.admin-search-group
      input#search-input(type="text" placeholder="Tìm theo tiêu chí đã chọn..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group.admin-filter-group
      select#filter-hocky(onchange="applyFilters()")
        option(value="" selected=(!filterHocKy)) Tất cả học kỳ
        if semesters && semesters.length > 0
          each s in semesters
            option(value=s.MaHocKy selected=(filterHocKy === s.MaHocKy)) #{s.TenHocKy} - #{s.MaHocKy}#{s.MaNamHoc ? ' - ' + s.MaNamHoc : ''}#{s.NAMHOC && s.NAMHOC.TenNamHoc ? ' - ' + s.NAMHOC.TenNamHoc : ''}
      select#filter-result(onchange="applyFilters()")
        option(value="" selected=(!filterResult)) Tất cả kết quả
        option(value="qua_mon" selected=(filterResult === 'qua_mon')) Qua môn
        option(value="rot" selected=(filterResult === 'rot')) Rớt
    .admin-action-group
      button.btn.btn-outline(type="button" onclick="openImportModal()") Nhập Excel
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm môn đã học
      a.btn.btn-outline(href="/admin/trash?entity=completedCourses") Thùng rác

  .card
    .card-header
      h3 Sinh viên có môn đã học
      span.card-count= completedStudents ? `${completedStudents.length} sinh viên` : '0 sinh viên'
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Họ tên
            th Số lượt học
            th Qua môn
            th Rớt
            th Tín chỉ tích lũy
            th Cập nhật gần nhất
            th Sửa bởi
            th Thao tác
        tbody
          if completedStudents && completedStudents.length > 0
            each s in completedStudents
              tr
                td.mono= s.MaSv
                td= s.HoTen || '-'
                td= s.totalAttempts || 0
                td
                  span.badge.badge-success= s.passedCount || 0
                td
                  span.badge.badge-error= s.failedCount || 0
                td= s.passedCredits || 0
                td= s.NgayCapNhatGanNhat ? new Date(s.NgayCapNhatGanNhat).toLocaleDateString('vi-VN') : '-'
                td= s.NguoiCapNhatTen || '-'
                td.table-actions
                  .table-action-list
                    button.btn.btn-sm.btn-outline(type="button" data-ma-sv=s.MaSv onclick="openCompletedCourseDetail(this.dataset.maSv)") Xem
          else
            tr
              td(colspan="9")
                .empty-state Chưa có sinh viên nào có môn đã học

  include ../../partials/pagination

block modals
  #completed-course-detail-modal.modal-overlay(onclick="if(event.target===this)closeCompletedCourseDetail()")
    .modal.modal-wide
      .modal-header
        h3 Chi tiết môn đã học
        button.modal-close(type="button" onclick="closeCompletedCourseDetail()" aria-label="Đóng") ×
      .modal-body
        #completed-course-detail-content Đang tải...

  #completed-course-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm môn đã học
        button.modal-close(type="button" onclick="closeModal()" aria-label="Đóng") ×
      .modal-body
        form#completed-course-form
          .form-row
            .form-group
              label(for="cc-masv") MSSV
              input.form-control.lockable-field#cc-masv(type="text" required placeholder="VD: 23521228")
            .form-group
              label(for="cc-mamonhoc") Môn học
              input.form-control.lockable-field#cc-mamonhoc(type="text" list="course-options" required placeholder="VD: IT001")
              datalist#course-options
                if courses && courses.length > 0
                  each c in courses
                    option(value=c.MaMonHoc)= c.TenMonHoc
          .form-row
            .form-group
              label(for="cc-mahocky") Học kỳ
              select.form-control.lockable-field#cc-mahocky(required)
                option(value="") Chọn học kỳ
                if semesters && semesters.length > 0
                  each s in semesters
                    option(value=s.MaHocKy)= `${s.TenHocKy} - ${s.MaHocKy}${s.MaNamHoc ? ' - ' + s.MaNamHoc : ''}${s.NAMHOC && s.NAMHOC.TenNamHoc ? ' - ' + s.NAMHOC.TenNamHoc : ''}`
            .form-group
              label(for="cc-malop") Lớp
              input.form-control#cc-malop(type="text" list="class-options" placeholder="VD: IT001.N01")
              datalist#class-options
                if classes && classes.length > 0
                  each l in classes
                    option(value=l.MaLop)= l.TenLop
          .form-row
            .form-group
              label(for="cc-lanhoc") Lần học
              input.form-control.lockable-field#cc-lanhoc(type="number" min="1" value="1")
            .form-group
              label(for="cc-ketqua") Kết quả
              select.form-control#cc-ketqua(required)
                option(value="qua_mon") Qua môn
                option(value="rot") Rớt
          .form-group
            label(for="cc-ghichu") Ghi chú
            textarea.form-control#cc-ghichu(rows="2")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveCompletedCourse()") Lưu

  #import-modal.modal-overlay(onclick="if(event.target===this)closeImportModal()")
    .modal.modal-wide
      .modal-header
        h2 Nhập Excel
        button.modal-close(type="button" onclick="closeImportModal()" aria-label="Đóng") ×
      .modal-body
        .import-format-note
          strong Format file Excel/CSV
          small Dong dau tien la header. Cot bat buoc: MSSV (hoac MaSv), MaMonHoc, MaHocKy (hoac HocKy), KetQua. Cot tuy chon: MaLop, LanHoc, GhiChu.
          small KetQua chap nhan: qua_mon/rot hoac cac cach ghi tuong duong nhu dat, dau, qua mon, truot, khong dat.
        input#import-file.form-control(type="file" accept=".csv,.tsv,.txt,.xls,.xlsx")
        .table-container.mt-3
          table.data-table
            thead
              tr
                th MSSV
                th MaMonHoc
                th HocKy
                th KetQua
                th Trạng thái
            tbody#import-preview
              tr
                td(colspan="5")
                  .empty-state Chọn file CSV/TSV từ Excel để xem trước
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeImportModal()") Hủy
        button.btn.btn-primary(type="button" onclick="confirmImport()") Xác nhận import

block scripts
  script(src="/js/admin/completed-courses.js")
