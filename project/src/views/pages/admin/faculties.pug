extends ../../layouts/admin

block content
  .toolbar.admin-toolbar
    .search-box.search-box-with-criterion.admin-search-group
      select.form-control.ui-search-criterion-select#faculty-search-field(onchange="applyFilters()" aria-label="Tiêu chí tìm kiếm")
        option(value="all" selected=(!searchField || searchField === 'all')) Tất cả
        option(value="MaKhoa" selected=(searchField === 'MaKhoa')) Mã khoa
        option(value="TenKhoa" selected=(searchField === 'TenKhoa')) Tên khoa
        option(value="TenVietTat" selected=(searchField === 'TenVietTat')) Tên viết tắt
      input#search-input(type="text" placeholder="Tìm mã khoa, tên khoa hoặc tên viết tắt..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group.admin-filter-group
    .admin-action-group
      button.btn.btn-primary(type="button" onclick="openModal('add')") Thêm khoa
      a.btn.btn-outline(href="/admin/trash?entity=faculties") Thùng rác

  .card
    .card-header
      h3 Danh sách khoa
      span.card-count= faculties ? `${faculties.length} bản ghi` : '0 bản ghi'
    .table-container
      table.data-table
        thead
          tr
            th Mã khoa
            th Tên khoa
            th Viết tắt
            th Trưởng khoa
            th Liên hệ
            th Số ngành
            th Số môn
            th Sửa bởi
            th Sửa lúc
            th Thao tác
        tbody
          if faculties && faculties.length > 0
            each f in faculties
              tr(data-record=JSON.stringify(f))
                td.mono= f.MaKhoa
                td
                  strong= f.TenKhoa
                td= f.TenVietTat || '-'
                td= f.TruongKhoa || '-'
                td
                  div= f.Email || '-'
                  small= f.Sdt || ''
                td= f._count ? f._count.NGANHHOC : 0
                td= f._count ? f._count.MONHOC : 0
                td= f.NguoiCapNhatTen || f.NguoiCapNhat || '-'
                td= f.NgayCapNhat ? new Date(f.NgayCapNhat).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }) : '-'
                td.table-actions(data-no-row-detail="true")
                  .table-action-list
                    button.btn.btn-sm.btn-outline(type="button" data-record=JSON.stringify(f) onclick="openModal('edit', JSON.parse(this.dataset.record))") Sửa
                    button.btn.btn-sm.btn-danger(type="button" onclick=`deleteFaculty('${f.MaKhoa}')`) Xóa
          else
            tr
              td(colspan="10")
                .empty-state Không có khoa phù hợp

  include ../../partials/pagination

block modals
  #faculty-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm khoa
        button.modal-close(type="button" onclick="closeModal()") ×
      .modal-body
        form#faculty-form
          .form-row
            .form-group
              label(for="fac-ma") Mã khoa
              input.form-control#fac-ma(type="text" required placeholder="VD: CNTT" data-readonly-message="Mã khoa không được sửa.")
            .form-group
              label(for="fac-ten") Tên khoa
              input.form-control#fac-ten(type="text" required placeholder="VD: Công nghệ thông tin")
          .form-row
            .form-group
              label(for="fac-viettat") Tên viết tắt
              input.form-control#fac-viettat(type="text" placeholder="VD: CNTT")
            .form-group
              label(for="fac-truongkhoa") Trưởng khoa
              input.form-control#fac-truongkhoa(type="text" placeholder="Họ tên trưởng khoa")
          .form-row
            .form-group
              label(for="fac-email") Email
              input.form-control#fac-email(type="email" placeholder="Email liên hệ")
            .form-group
              label(for="fac-sdt") Số điện thoại
              input.form-control#fac-sdt(type="text" placeholder="Số điện thoại")
          .form-group
            label(for="fac-diachi") Địa chỉ
            input.form-control#fac-diachi(type="text" placeholder="Địa chỉ khoa")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveFaculty()") Lưu

block scripts
  script(src="/js/admin/faculties.js")
