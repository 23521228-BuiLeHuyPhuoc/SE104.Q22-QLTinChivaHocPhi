generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CHUCNANG {
  MaChucNang         String      @id(map: "chuc_nang_pkey") @db.VarChar(30)
  TenChucNang        String      @db.VarChar(100)
  TenManHinhDuocLoad String      @db.VarChar(100)
  NguoiCapNhat       Int?
  NgayCapNhat        DateTime?   @db.Timestamp(6)
  DaXoa              Boolean     @default(false)
  NguoiXoa           Int?
  NgayXoa            DateTime?   @db.Timestamp(6)
  PHANQUYEN          PHANQUYEN[]
}

model NHOMNGUOIDUNG {
  MaNhom       String      @id(map: "nhom_nguoi_dung_pkey") @db.VarChar(20)
  TenNhom      String      @unique(map: "nhom_nguoi_dung_ten_nhom_key") @db.VarChar(100)
  NguoiCapNhat Int?
  NgayCapNhat  DateTime?   @db.Timestamp(6)
  DaXoa         Boolean     @default(false)
  NguoiXoa      Int?
  NgayXoa       DateTime?   @db.Timestamp(6)
  PHANQUYEN     PHANQUYEN[]
  TAIKHOAN      TAIKHOAN[]
}

model PHANQUYEN {
  MaNhom        String        @db.VarChar(20)
  MaChucNang    String        @db.VarChar(30)
  CHUCNANG      CHUCNANG      @relation(fields: [MaChucNang], references: [MaChucNang], onDelete: Cascade, map: "fk_pq_chuc_nang")
  NHOMNGUOIDUNG NHOMNGUOIDUNG @relation(fields: [MaNhom], references: [MaNhom], onDelete: Cascade, map: "fk_pq_nhom")

  @@id([MaNhom, MaChucNang], map: "phan_quyen_pkey")
}

model THAMSO {
  id                         Int       @id(map: "tham_so_pkey") @default(1) @db.SmallInt
  SoTinChiDangKyToiThieu     Int       @default(14)
  SoTinChiDangKyToiDa        Int       @default(24)
  SoTinChiDangKyToiDaKhiVuot Int       @default(30)
  DanhSachMonAnhVanBatBuoc   String?   @default("ENG01,ENG02,ENG03") @db.VarChar(200)
  NamKiemTraAnhVan           Int?      @default(2)
  GioiHanTinChiChuaDatAnhVan Int?      @default(14)
  NgayCapNhat                DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CHITIETDANGKY {
  id          Int         @id(map: "chi_tiet_dang_ky_pkey") @default(autoincrement())
  SoPhieu     Int
  MaLop       String      @db.VarChar(20)
  MaMonHoc    String      @db.VarChar(15)
  LoaiDangKy  String?     @default("hoc_moi") @db.VarChar(20)
  SoTinChi    Int
  LoaiMon     String      @db.VarChar(5)
  DonGia      Decimal     @db.Decimal(12, 0)
  ThanhTien   Decimal     @db.Decimal(15, 0)
  TrangThai   String?     @default("Đã đăng ký") @db.VarChar(30)
  NgayDangKy  DateTime?   @default(now()) @db.Timestamp(6)
  NgayHuy     DateTime?   @db.Timestamp(6)
  LyDoHuy     String?     @db.VarChar(200)
  LOP         LOP         @relation(fields: [MaLop], references: [MaLop], map: "fk_ctdk_lop")
  MONHOC      MONHOC      @relation(fields: [MaMonHoc], references: [MaMonHoc], map: "fk_ctdk_monhoc")
  PHIEUDANGKY PHIEUDANGKY @relation(fields: [SoPhieu], references: [SoPhieu], onDelete: Cascade, map: "fk_ctdk_phieu")

  @@unique([SoPhieu, MaMonHoc], map: "uq_ctdk")
}

/// Don cuu xet dang ky hoc phan sau han dang ky.
model DONCUUXETDANGKY {
  id             Int          @id(map: "don_cuu_xet_dang_ky_pkey") @default(autoincrement())
  MaSv           String       @db.VarChar(15)
  MaHocKy        String       @db.VarChar(15)
  SoPhieu        Int?
  LoaiDon        String       @default("them") @db.VarChar(10)
  TrangThai      String       @default("cho_duyet") @db.VarChar(20)
  MaLopHuy       String?      @db.VarChar(20)
  MaLopThem      String?      @db.VarChar(20)
  LyDo           String       @db.VarChar(500)
  LyDoTuChoi     String?      @db.VarChar(500)
  NguoiDuyet     Int?
  NgayTao        DateTime?    @default(now()) @db.Timestamp(6)
  NgayCapNhat    DateTime?    @db.Timestamp(6)
  NgayDuyet      DateTime?    @db.Timestamp(6)
  HOCKY          HOCKY        @relation(fields: [MaHocKy], references: [MaHocKy], onDelete: Cascade, map: "fk_dcx_hocky")
  SINHVIEN       SINHVIEN     @relation(fields: [MaSv], references: [MaSv], onDelete: Cascade, map: "fk_dcx_sinhvien")
  PHIEUDANGKY    PHIEUDANGKY? @relation(fields: [SoPhieu], references: [SoPhieu], onDelete: SetNull, map: "fk_dcx_phieudangky")
  LOP_HUY        LOP?         @relation("DONCUUXET_LOP_HUY", fields: [MaLopHuy], references: [MaLop], onDelete: SetNull, map: "fk_dcx_lop_huy")
  LOP_THEM       LOP?         @relation("DONCUUXET_LOP_THEM", fields: [MaLopThem], references: [MaLop], onDelete: SetNull, map: "fk_dcx_lop_them")
  TAIKHOAN       TAIKHOAN?    @relation(fields: [NguoiDuyet], references: [MaTaiKhoan], onDelete: SetNull, map: "fk_dcx_nguoi_duyet")

  @@index([MaSv, MaHocKy], map: "idx_dcx_sv_hk")
  @@index([MaHocKy, TrangThai], map: "idx_dcx_hk_trangthai")
}

