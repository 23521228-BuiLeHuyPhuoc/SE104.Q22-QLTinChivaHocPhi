# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ql_tin_chi_hoc_phi_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Prisma Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/ql_tin_chi_hoc_phi_db?sslmode=disable"

# Server Configuration
PORT=5000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Redis OTP storage for password reset
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=5000
RESET_OTP_TTL_MINUTES=10
RESET_OTP_LENGTH=6
RESET_OTP_MAX_ATTEMPTS=5

# Cloudinary avatar uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AVATAR_FOLDER=ql-tin-chi/avatars
AVATAR_MAX_SIZE_BYTES=3145728

# App URL used in password reset emails
APP_BASE_URL=http://localhost:5000
PUBLIC_BASE_URL=http://localhost:5000

# Payment gateway configuration
BANK_BIN=123456
BANK_ACCOUNT_NO=1234567890
BANK_ACCOUNT_NAME=DEMO_UNIVERSITY

VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=DEMO123456
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_RETURN_URL=http://localhost:5000/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:5000/payment/vnpay/ipn

ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=your_zalopay_key1_here
ZALOPAY_KEY2=your_zalopay_key2_here
ZALOPAY_RETURN_URL=http://localhost:5000/payment/zalopay/return
ZALOPAY_CALLBACK_URL=http://localhost:5000/payment/zalopay/callback
ZALOPAY_BANK_CODE=zalopayapp
ZALOPAY_MIN_AMOUNT=1000
PAYMENT_GATEWAY_TIMEOUT_MS=15000

# SMTP Configuration for forgot password
# For Gmail, enable 2-Step Verification and create an App Password:
# https://myaccount.google.com/apppasswords
# SMTP_PASS must be the App Password, not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="QL Tin Chi <your_email@gmail.com>"
NGROK=http://localhost:5000
