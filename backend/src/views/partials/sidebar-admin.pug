nav.sidebar.sidebar-admin(id="sidebar")
  .sidebar-brand
    h2 🎓 QL Tín Chỉ
    small Bảng điều khiển Admin

  .sidebar-nav
    .sidebar-section
      .sidebar-section-title Tổng quan
      a.sidebar-link(href="/admin/dashboard" class=(currentPage === 'dashboard' ? 'active' : ''))
        span.icon 📊
        span Dashboard

    .sidebar-section
      .sidebar-section-title Quản lý đào tạo
      a.sidebar-link(href="/admin/students" class=(currentPage === 'students' ? 'active' : ''))
        span.icon 👨‍🎓
        span Sinh viên
      a.sidebar-link(href="/admin/courses" class=(currentPage === 'courses' ? 'active' : ''))
        span.icon 📚
        span Môn học
      a.sidebar-link(href="/admin/classes" class=(currentPage === 'classes' ? 'active' : ''))
        span.icon 🏫
        span Lớp học
      a.sidebar-link(href="/admin/semesters" class=(currentPage === 'semesters' ? 'active' : ''))
        span.icon 📅
        span Học kỳ

    .sidebar-section
      .sidebar-section-title Đăng ký & Học phí
      a.sidebar-link(href="/admin/registrations" class=(currentPage === 'registrations' ? 'active' : ''))
        span.icon 📝
        span Đăng ký
      a.sidebar-link(href="/admin/tuition" class=(currentPage === 'tuition' ? 'active' : ''))
        span.icon 💰
        span Học phí
      a.sidebar-link(href="/admin/payments" class=(currentPage === 'payments' ? 'active' : ''))
        span.icon 💳
        span Thu phí

    .sidebar-section
      .sidebar-section-title Báo cáo
      a.sidebar-link(href="/admin/reports" class=(currentPage === 'reports' ? 'active' : ''))
        span.icon 📈
        span Thống kê

  .sidebar-footer
    .sidebar-user
      .avatar= user ? user.ho_ten ? user.ho_ten.charAt(0).toUpperCase() : 'A' : 'A'
      div
        div= user ? user.ho_ten || user.ten_dang_nhap : 'Admin'
        small Quản trị viên
