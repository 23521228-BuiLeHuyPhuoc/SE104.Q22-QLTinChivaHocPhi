extends ../../layouts/student

block content
  h2.page-title Lịch sử thanh toán

  .card
    .card-body
      .loading-overlay#loading
        .spinner
      .table-container
        table.data-table#payments-table.hidden
          thead
            tr
              th Mã phiếu
              th Học kỳ
              th Số tiền
              th Phương thức
              th Ngày thanh toán
              th Ghi chú
          tbody#payment-list

block scripts
  script.
    (async function() {
      try {
        const meRes = await apiFetch('/api/auth/me');
        if (!meRes.success || !meRes.data.studentInfo) return;
        const sid = meRes.data.studentInfo.ma_sv;

        const res = await apiFetch('/api/payments/student/' + sid);
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('payments-table').classList.remove('hidden');

        const tbody = document.getElementById('payment-list');
        if (res.success && res.data && res.data.length > 0) {
          var html = '';
          res.data.forEach(p => {
            html += '<tr>';
            html += '<td>' + (p.ma_phieu_thu || p.id) + '</td>';
            html += '<td>' + (p.ten_hoc_ky || '-') + '</td>';
            html += '<td>' + formatCurrency(p.so_tien || 0) + '</td>';
            html += '<td>' + (p.phuong_thuc || '-') + '</td>';
            html += '<td>' + (p.ngay_thu ? new Date(p.ngay_thu).toLocaleDateString('vi-VN') : '-') + '</td>';
            html += '<td>' + (p.ghi_chu || '-') + '</td>';
            html += '</tr>';
          });
          tbody.innerHTML = html;
        } else {
          tbody.innerHTML = '<tr><td colspan="6" class="text-center">Chưa có lịch sử thanh toán</td></tr>';
        }
      } catch(e) {
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('payments-table').classList.remove('hidden');
        console.error(e);
      }
    })();
