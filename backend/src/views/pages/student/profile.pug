extends ../../layouts/student

block content
  h2.page-title Hồ sơ sinh viên

  .card
    .card-body
      .loading-overlay#loading
        .spinner
      form#profile-form.hidden
        .form-row
          .form-group
            label MSSV
            input.form-control#p-mssv(type="text" disabled)
          .form-group
            label Họ tên
            input.form-control#p-hoten(type="text" disabled)
        .form-row
          .form-group
            label Email
            input.form-control#p-email(type="email" disabled)
          .form-group
            label Số điện thoại
            input.form-control#p-sdt(type="text" disabled)
        .form-row
          .form-group
            label Ngày sinh
            input.form-control#p-ngaysinh(type="text" disabled)
          .form-group
            label Giới tính
            input.form-control#p-gioitinh(type="text" disabled)
        .form-row
          .form-group
            label CMND/CCCD
            input.form-control#p-cmnd(type="text" disabled)
          .form-group
            label Dân tộc
            input.form-control#p-dantoc(type="text" disabled)
        .form-group
          label Địa chỉ
          input.form-control#p-diachi(type="text" disabled)
        .form-row
          .form-group
            label Ngành
            input.form-control#p-nganh(type="text" disabled)
          .form-group
            label Khoa
            input.form-control#p-khoa(type="text" disabled)
        .form-row
          .form-group
            label Trạng thái
            input.form-control#p-trangthai(type="text" disabled)
          .form-group
            label Khóa
            input.form-control#p-khoahoc(type="text" disabled)

block scripts
  script.
    (async function() {
      try {
        const meRes = await apiFetch('/api/auth/me');
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('profile-form').classList.remove('hidden');

        if (meRes.success && meRes.data.studentInfo) {
          const s = meRes.data.studentInfo;
          document.getElementById('p-mssv').value = s.ma_sv || '';
          document.getElementById('p-hoten').value = s.ho_ten || '';
          document.getElementById('p-email').value = s.email || '';
          document.getElementById('p-sdt').value = s.so_dien_thoai || '';
          document.getElementById('p-ngaysinh').value = s.ngay_sinh ? new Date(s.ngay_sinh).toLocaleDateString('vi-VN') : '';
          document.getElementById('p-gioitinh').value = s.gioi_tinh || '';
          document.getElementById('p-cmnd').value = s.so_cmnd || '';
          document.getElementById('p-dantoc').value = s.dan_toc || '';
          document.getElementById('p-diachi').value = s.dia_chi || '';
          document.getElementById('p-nganh').value = s.ten_nganh || '';
          document.getElementById('p-khoa').value = s.ten_khoa || '';
          document.getElementById('p-trangthai').value = s.trang_thai || '';
          document.getElementById('p-khoahoc').value = s.khoa_hoc || '';
        }
      } catch(e) {
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('profile-form').classList.remove('hidden');
        console.error(e);
      }
    })();
