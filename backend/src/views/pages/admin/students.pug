extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm kiếm sinh viên..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(status === '' || !status)) Tất cả trạng thái
        option(value="Đang học" selected=(status === 'Đang học')) Đang học
        option(value="Đã tốt nghiệp" selected=(status === 'Đã tốt nghiệp')) Đã tốt nghiệp
        option(value="Bảo lưu" selected=(status === 'Bảo lưu')) Bảo lưu
        option(value="Đã thôi học" selected=(status === 'Đã thôi học')) Đã thôi học
      button.btn.btn-primary(onclick="openModal('add')") + Thêm sinh viên

  .card
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Họ tên
            th Email
            th Ngành
            th Trạng thái
            th Thao tác
        tbody#students-table
          if students && students.length > 0
            each sv in students
              tr
                td= sv.ma_sv
                td= sv.ho_ten
                td= sv.email || '-'
                td= sv.ten_nganh || '-'
                td
                  span.badge(class=sv.trang_thai === 'Đang học' ? 'badge-success' : sv.trang_thai === 'Bảo lưu' ? 'badge-warning' : sv.trang_thai === 'Đã tốt nghiệp' ? 'badge-info' : 'badge-error')= sv.trang_thai
                td
                  button.btn.btn-sm.btn-outline(onclick=`openModal('edit', ${JSON.stringify(sv)})`) ✏️
                  |  
                  button.btn.btn-sm.btn-danger(onclick=`deleteStudent('${sv.ma_sv}')`) 🗑️
          else
            tr
              td(colspan="6").text-center Không có dữ liệu

  include ../../partials/pagination

block modals
  #student-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2#modal-title Thêm sinh viên
        button.modal-close(onclick="closeModal()") ×
      .modal-body
        form#student-form
          .form-row
            .form-group
              label MSSV
              input.form-control#sv-mssv(type="text" required)
            .form-group
              label Họ tên
              input.form-control#sv-hoten(type="text" required)
          .form-row
            .form-group
              label Email
              input.form-control#sv-email(type="email")
            .form-group
              label Số điện thoại
              input.form-control#sv-sdt(type="text")
          .form-row
            .form-group
              label Ngày sinh
              input.form-control#sv-ngaysinh(type="date")
            .form-group
              label Giới tính
              select.form-control#sv-gioitinh
                option(value="Nam") Nam
                option(value="Nữ") Nữ
          .form-row
            .form-group
              label CMND/CCCD
              input.form-control#sv-cmnd(type="text")
            .form-group
              label Dân tộc
              input.form-control#sv-dantoc(type="text" value="Kinh")
          .form-group
            label Địa chỉ
            input.form-control#sv-diachi(type="text")
          .form-row
            .form-group
              label Ngành
              select.form-control#sv-nganh
                option(value="") Chọn ngành
            .form-group
              label Trạng thái
              select.form-control#sv-trangthai
                option(value="Đang học") Đang học
                option(value="Bảo lưu") Bảo lưu
                option(value="Đã tốt nghiệp") Đã tốt nghiệp
                option(value="Đã thôi học") Đã thôi học
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="saveStudent()") Lưu

block scripts
  script.
    var editingId = null;

    // Load majors for dropdown
    (async function() {
      try {
        const res = await apiFetch('/api/students/majors');
        if (res.success) {
          const select = document.getElementById('sv-nganh');
          res.data.forEach(m => {
            const opt = document.createElement('option');
            opt.value = m.ma_nganh;
            opt.textContent = m.ten_nganh + ' (' + m.ten_khoa + ')';
            select.appendChild(opt);
          });
        }
      } catch(e) {}
    })();

    function openModal(mode, sv) {
      editingId = null;
      document.getElementById('modal-title').textContent = mode === 'edit' ? 'Sửa sinh viên' : 'Thêm sinh viên';
      document.getElementById('sv-mssv').disabled = mode === 'edit';
      if (mode === 'edit' && sv) {
        editingId = sv.ma_sv;
        document.getElementById('sv-mssv').value = sv.ma_sv || '';
        document.getElementById('sv-hoten').value = sv.ho_ten || '';
        document.getElementById('sv-email').value = sv.email || '';
        document.getElementById('sv-sdt').value = sv.so_dien_thoai || '';
        document.getElementById('sv-ngaysinh').value = sv.ngay_sinh ? sv.ngay_sinh.split('T')[0] : '';
        document.getElementById('sv-gioitinh').value = sv.gioi_tinh || 'Nam';
        document.getElementById('sv-cmnd').value = sv.so_cmnd || '';
        document.getElementById('sv-dantoc').value = sv.dan_toc || 'Kinh';
        document.getElementById('sv-diachi').value = sv.dia_chi || '';
        document.getElementById('sv-nganh').value = sv.ma_nganh || '';
        document.getElementById('sv-trangthai').value = sv.trang_thai || 'Đang học';
      } else {
        document.getElementById('student-form').reset();
      }
      document.getElementById('student-modal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('student-modal').classList.remove('active');
    }

    async function saveStudent() {
      const data = {
        ma_sv: document.getElementById('sv-mssv').value,
        ho_ten: document.getElementById('sv-hoten').value,
        email: document.getElementById('sv-email').value,
        so_dien_thoai: document.getElementById('sv-sdt').value,
        ngay_sinh: document.getElementById('sv-ngaysinh').value,
        gioi_tinh: document.getElementById('sv-gioitinh').value,
        so_cmnd: document.getElementById('sv-cmnd').value,
        dan_toc: document.getElementById('sv-dantoc').value,
        dia_chi: document.getElementById('sv-diachi').value,
        ma_nganh: document.getElementById('sv-nganh').value,
        trang_thai: document.getElementById('sv-trangthai').value
      };

      try {
        var res;
        if (editingId) {
          res = await apiFetch('/api/students/' + editingId, { method: 'PUT', body: data });
        } else {
          res = await apiFetch('/api/students', { method: 'POST', body: data });
        }
        if (res.success) {
          showToast(editingId ? 'Cập nhật thành công!' : 'Thêm sinh viên thành công!', 'success');
          closeModal();
          setTimeout(() => location.reload(), 500);
        } else {
          showToast(res.message || 'Lỗi', 'error');
        }
      } catch(e) {
        showToast('Lỗi kết nối', 'error');
      }
    }

    async function deleteStudent(maSv) {
      if (!confirm('Bạn có chắc muốn xóa sinh viên ' + maSv + '?')) return;
      try {
        const res = await apiFetch('/api/students/' + maSv, { method: 'DELETE' });
        if (res.success) {
          showToast('Đã xóa sinh viên', 'success');
          setTimeout(() => location.reload(), 500);
        } else {
          showToast(res.message || 'Lỗi', 'error');
        }
      } catch(e) {
        showToast('Lỗi kết nối', 'error');
      }
    }

    var searchTimer;
    function debounceSearch() {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => applyFilters(), 400);
    }

    function applyFilters() {
      const search = document.getElementById('search-input').value;
      const status = document.getElementById('filter-status').value;
      let url = '/admin/students?page=1';
      if (search) url += '&search=' + encodeURIComponent(search);
      if (status) url += '&status=' + encodeURIComponent(status);
      window.location.href = url;
    }
