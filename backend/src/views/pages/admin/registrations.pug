extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm kiếm đăng ký..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      select#filter-status(onchange="applyFilters()")
        option(value="" selected=(!status)) Tất cả trạng thái
        option(value="registered" selected=(status === 'registered')) Đã đăng ký
        option(value="cancelled" selected=(status === 'cancelled')) Đã hủy

  .card
    .table-container
      table.data-table
        thead
          tr
            th MSSV
            th Họ tên
            th Môn học
            th Lớp
            th Ngày ĐK
            th Trạng thái
        tbody
          if registrations && registrations.length > 0
            each r in registrations
              tr
                td= r.ma_sv
                td= r.ho_ten_sv || '-'
                td= r.ten_mon_hoc || '-'
                td= r.ma_lop || '-'
                td= r.ngay_dang_ky ? new Date(r.ngay_dang_ky).toLocaleDateString('vi-VN') : '-'
                td
                  span.badge(class=r.trang_thai === 'registered' ? 'badge-success' : 'badge-error')= r.trang_thai === 'registered' ? 'Đã ĐK' : 'Đã hủy'
          else
            tr
              td(colspan="6").text-center Không có dữ liệu

  include ../../partials/pagination

block scripts
  script.
    var searchTimer;
    function debounceSearch() {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => applyFilters(), 400);
    }
    function applyFilters() {
      const search = document.getElementById('search-input').value;
      const status = document.getElementById('filter-status').value;
      let url = '/admin/registrations?page=1';
      if (search) url += '&search=' + encodeURIComponent(search);
      if (status) url += '&status=' + encodeURIComponent(status);
      window.location.href = url;
    }
