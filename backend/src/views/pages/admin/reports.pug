extends ../../layouts/admin

block content
  h2.page-title Báo cáo thống kê

  .stats-grid
    .stat-card
      .stat-icon.blue 👨‍🎓
      .stat-info
        h3#stat-students --
        p Tổng sinh viên
    .stat-card
      .stat-icon.green 📚
      .stat-info
        h3#stat-courses --
        p Tổng môn học
    .stat-card
      .stat-icon.orange 📝
      .stat-info
        h3#stat-registrations --
        p Lượt đăng ký
    .stat-card
      .stat-icon.purple 💰
      .stat-info
        h3#stat-paid --
        p Đã thu
    .stat-card
      .stat-icon.red 💸
      .stat-info
        h3#stat-remaining --
        p Còn nợ

  .card.mt-3
    .card-header
      h3 Thống kê sinh viên theo trạng thái
    .card-body
      table.data-table
        thead
          tr
            th Trạng thái
            th Số lượng
        tbody#student-stats-table
          tr
            td(colspan="2").text-center Đang tải...

  .card.mt-3
    .card-header
      h3 Thống kê theo phương thức thanh toán
    .card-body
      table.data-table
        thead
          tr
            th Phương thức
            th Số giao dịch
            th Tổng tiền
        tbody#payment-stats-table
          tr
            td(colspan="3").text-center Đang tải...

block scripts
  script.
    (async function() {
      try {
        const token = getToken();
        const headers = { 'Authorization': 'Bearer ' + token };

        const [sRes, cRes, rRes, tRes, pRes] = await Promise.all([
          fetch('/api/students/stats', { headers }).then(r => r.json()).catch(() => null),
          fetch('/api/courses/stats', { headers }).then(r => r.json()).catch(() => null),
          fetch('/api/registrations/stats', { headers }).then(r => r.json()).catch(() => null),
          fetch('/api/tuition/stats', { headers }).then(r => r.json()).catch(() => null),
          fetch('/api/payments/stats', { headers }).then(r => r.json()).catch(() => null)
        ]);

        if (sRes && sRes.success) {
          document.getElementById('stat-students').textContent = sRes.data.total || 0;
          // Student status table
          var html = '';
          if (sRes.data.by_status) {
            sRes.data.by_status.forEach(s => {
              html += '<tr><td>' + s.trang_thai + '</td><td>' + s.count + '</td></tr>';
            });
          }
          document.getElementById('student-stats-table').innerHTML = html || '<tr><td colspan="2">Không có dữ liệu</td></tr>';
        }

        if (cRes && cRes.success) {
          document.getElementById('stat-courses').textContent = cRes.data.total || 0;
        }
        if (rRes && rRes.success) {
          document.getElementById('stat-registrations').textContent = rRes.data.total || 0;
        }
        if (tRes && tRes.success) {
          document.getElementById('stat-paid').textContent = formatCurrency(tRes.data.total_paid || 0);
          document.getElementById('stat-remaining').textContent = formatCurrency(tRes.data.total_remaining || 0);
        }
        if (pRes && pRes.success) {
          var html2 = '';
          if (pRes.data.by_method) {
            pRes.data.by_method.forEach(m => {
              html2 += '<tr><td>' + m.phuong_thuc + '</td><td>' + m.count + '</td><td>' + formatCurrency(m.total) + '</td></tr>';
            });
          }
          document.getElementById('payment-stats-table').innerHTML = html2 || '<tr><td colspan="3">Không có dữ liệu</td></tr>';
        }
      } catch(e) {
        console.error('Error loading reports:', e);
      }
    })();
