extends ../../layouts/admin

block content
  .toolbar
    .search-box
      input#search-input(type="text" placeholder="Tìm kiếm phiếu thu..." value=(search || '') onkeyup="debounceSearch()")
    .filter-group
      button.btn.btn-primary(onclick="openModal()") + Lập phiếu thu

  .card
    .table-container
      table.data-table
        thead
          tr
            th Mã phiếu
            th MSSV
            th Họ tên
            th Số tiền
            th Phương thức
            th Ngày thu
            th Người thu
        tbody
          if payments && payments.length > 0
            each p in payments
              tr
                td= p.ma_phieu_thu || p.id
                td= p.ma_sv || '-'
                td= p.ho_ten_sv || '-'
                td= (p.so_tien || 0).toLocaleString('vi-VN') + 'đ'
                td= p.phuong_thuc || '-'
                td= p.ngay_thu ? new Date(p.ngay_thu).toLocaleDateString('vi-VN') : '-'
                td= p.nguoi_thu || '-'
          else
            tr
              td(colspan="7").text-center Không có dữ liệu

  include ../../partials/pagination

block modals
  #payment-modal.modal-overlay(onclick="if(event.target===this)closeModal()")
    .modal
      .modal-header
        h2 Lập phiếu thu học phí
        button.modal-close(onclick="closeModal()") ×
      .modal-body
        form#payment-form
          .form-row
            .form-group
              label MSSV
              input.form-control#pt-mssv(type="text" required)
            .form-group
              label Học kỳ
              select.form-control#pt-hocky
                option(value="") Chọn học kỳ
          .form-group
            label Số tiền
            input.form-control#pt-sotien(type="number" min="0" required)
          .form-group
            label Phương thức thanh toán
            select.form-control#pt-phuongthuc
              option(value="Tiền mặt") Tiền mặt
              option(value="Chuyển khoản") Chuyển khoản
              option(value="Thẻ") Thẻ
          .form-group
            label Ghi chú
            textarea.form-control#pt-ghichu(rows="2")
      .modal-footer
        button.btn.btn-outline(type="button" onclick="closeModal()") Hủy
        button.btn.btn-primary(type="button" onclick="savePayment()") Lưu phiếu thu

block scripts
  script.
    // Load semesters for dropdown
    (async function() {
      try {
        const res = await apiFetch('/api/semesters');
        if (res.success) {
          const sel = document.getElementById('pt-hocky');
          res.data.forEach(s => {
            const opt = document.createElement('option');
            opt.value = s.ma_hoc_ky;
            opt.textContent = s.ten_hoc_ky + (s.ten_nam_hoc ? ' - ' + s.ten_nam_hoc : '');
            sel.appendChild(opt);
          });
        }
      } catch(e) {}
    })();

    function openModal() { document.getElementById('payment-modal').classList.add('active'); }
    function closeModal() { document.getElementById('payment-modal').classList.remove('active'); }

    async function savePayment() {
      const data = {
        ma_sv: document.getElementById('pt-mssv').value,
        ma_hoc_ky: document.getElementById('pt-hocky').value,
        so_tien: parseInt(document.getElementById('pt-sotien').value),
        phuong_thuc: document.getElementById('pt-phuongthuc').value,
        ghi_chu: document.getElementById('pt-ghichu').value
      };
      try {
        const res = await apiFetch('/api/payments', { method: 'POST', body: data });
        if (res.success) {
          showToast('Lập phiếu thu thành công!', 'success');
          closeModal(); setTimeout(() => location.reload(), 500);
        } else { showToast(res.message || 'Lỗi', 'error'); }
      } catch(e) { showToast('Lỗi kết nối', 'error'); }
    }

    var searchTimer;
    function debounceSearch() {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        window.location.href = '/admin/payments?page=1&search=' + encodeURIComponent(document.getElementById('search-input').value);
      }, 400);
    }
